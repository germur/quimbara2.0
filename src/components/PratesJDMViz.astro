          <g class="pjdm-arrows-mid" opacity="0">
            <path d="M 220 100 L 135 100" stroke="#ff8c42" stroke-width="2" fill="none" marker-end="url(#pjdmArrO)"/>
            <text x="225" y="103" fill="#ff8c42" font-family="monospace" font-size="8">PATADA HIGADO</text>
            <path d="M 220 130 L 135 130" stroke="#ff8c42" stroke-width="2" fill="none" marker-end="url(#pjdmArrO)"/>
            <text x="225" y="133" fill="#ff8c42" font-family="monospace" font-size="8">RODILLA CENTRO</text>
          </g>
        </g>
        <g class="pjdm-zone pjdm-zone-low" data-level="low">
          <rect x="10" y="165" width="180" height="105" fill="rgba(230,57,70,0.06)" stroke="#e63946" stroke-width="1" stroke-dasharray="3,3" opacity="0"/>
          <text x="195" y="225" fill="#e63946" font-family="monospace" font-size="9" font-weight="700" letter-spacing="2" opacity="0">BAJO</text>
          <g class="pjdm-arrows-low" opacity="0">
            <path d="M 220 220 L 145 220" stroke="#e63946" stroke-width="2.5" fill="none" marker-end="url(#pjdmArrR)"/>
            <text x="225" y="223" fill="#e63946" font-family="monospace" font-size="8" font-weight="700">CALF KICK</text>
            <path d="M 220 250 L 145 250" stroke="#e63946" stroke-width="2" fill="none" marker-end="url(#pjdmArrR)"/>
            <text x="225" y="253" fill="#e63946" font-family="monospace" font-size="8">LOW KICK MT</text>
          </g>
        </g>
      `;

      function highlightLevel(lvl: string) {
        $$('.pjdm-level-card').forEach(c => (c as HTMLElement).classList.toggle('pjdm-active', (c as HTMLElement).dataset.lvl === lvl));
        const showAll = lvl === 'all';
        ['high', 'mid', 'low'].forEach(l => {
          const z = svg!.querySelector(`.pjdm-zone-${l}`);
          if (!z) return;
          const active = showAll || lvl === l;
          z.querySelectorAll('rect, text, path, g').forEach(el => {
            (el as SVGElement).style.transition = 'opacity 0.4s';
            (el as SVGElement).style.opacity = active ? '1' : '0.15';
          });
        });
      }

      $$('.pjdm-level-card').forEach(card => {
        card.addEventListener('mouseenter', () => highlightLevel((card as HTMLElement).dataset.lvl || ''));
        card.addEventListener('click', () => highlightLevel((card as HTMLElement).dataset.lvl || ''));
      });
      setTimeout(() => highlightLevel('low'), 800);
      setTimeout(() => highlightLevel('mid'), 1800);
      setTimeout(() => highlightLevel('high'), 2800);
      setTimeout(() => highlightLevel('all'), 3800);
    }
    buildLevels();

    // ===== STACKED BARS =====
    function animateStacked() {
      $$('.pjdm-stacked-seg').forEach((seg, i) => {
        setTimeout(() => (seg as HTMLElement).style.width = (seg as HTMLElement).dataset.width + '%', 200 + i * 100);
      });
    }

    // ===== ROUND 3 SCRUBBER =====
    function buildScrubber() {
      const totalSec = 197;
      const track = $('#pjdmRoundTrack') as HTMLElement;
      if (!track) return;
      const fill = track.querySelector('.pjdm-round-fill') as HTMLElement;
      const handle = track.querySelector('.pjdm-round-handle') as HTMLElement;
      const time = track.querySelector('.pjdm-round-time') as HTMLElement;
      const eventCard = $('#pjdmEventCard') as HTMLElement;

      ROUND3_EVENTS.forEach((e, i) => {
        const m = document.createElement('div');
        m.className = 'pjdm-round-marker';
        m.style.left = (e.t / totalSec * 100) + '%';
        m.dataset.idx = String(i);
        m.innerHTML = `<span class="pjdm-tip">${fmt(e.t)}</span><span class="pjdm-marker-lbl">${e.label}</span>`;
        track.appendChild(m);
        m.addEventListener('click', () => setTime(e.t));
      });

      let current = 0;
      let playing = false;
      let raf: number | null = null;
      let lastT = 0;

      function setTime(s: number) {
        current = Math.max(0, Math.min(totalSec, s));
        const pct = current / totalSec * 100;
        fill.style.width = pct + '%';
        handle.style.left = pct + '%';
        time.textContent = fmt(Math.round(current));
        let idx = -1;
        ROUND3_EVENTS.forEach((e, i) => { if (current >= e.t - 2) idx = i; });
        if (idx >= 0) {
          const e = ROUND3_EVENTS[idx];
          eventCard.innerHTML = `<div class="pjdm-ev-time">${fmt(e.t)} · ${e.label}</div><div class="pjdm-ev-title">${e.title}</div><div class="pjdm-ev-desc">${e.desc}</div>`;
        } else {
          eventCard.innerHTML = `<div class="pjdm-ev-time">0:00</div><div class="pjdm-ev-title">Comienza el Round 3</div><div class="pjdm-ev-desc">Della Maddalena ya esta comprometido. La pierna delantera no responde igual. Tiene sangre en la cara. Suena la campana del tercero.</div>`;
        }
      }

      function play() {
        if (playing) { stop(); return; }
        if (current >= totalSec) current = 0;
        playing = true;
        const btn = $('#pjdmPlayBtn') as HTMLElement;
        if (btn) btn.textContent = '⏸ Pausar';
        lastT = performance.now();
        const tick = (now: number) => {
          if (!playing) return;
          const dt = (now - lastT) / 1000;
          lastT = now;
          setTime(current + dt * 8);
          if (current >= totalSec) { stop(); return; }
          raf = requestAnimationFrame(tick);
        };
        raf = requestAnimationFrame(tick);
      }
      function stop() {
        playing = false;
        const btn = $('#pjdmPlayBtn') as HTMLElement;
        if (btn) btn.textContent = '▶ Reproducir Round 3';
        if (raf) cancelAnimationFrame(raf);
      }

      const playBtn = $('#pjdmPlayBtn');
      const resetBtn = $('#pjdmResetBtn');
      if (playBtn) playBtn.addEventListener('click', play);
      if (resetBtn) resetBtn.addEventListener('click', () => { stop(); setTime(0); });

      let dragging = false;
      const startDrag = () => { dragging = true; stop(); };
      const stopDrag = () => { dragging = false; };
      const onDrag = (clientX: number) => {
        if (!dragging) return;
        const rect = track.getBoundingClientRect();
        const pct = (clientX - rect.left) / rect.width;
        setTime(pct * totalSec);
      };
      track.addEventListener('mousedown', (e) => { startDrag(); onDrag(e.clientX); });
      document.addEventListener('mousemove', (e) => onDrag(e.clientX));
      document.addEventListener('mouseup', stopDrag);
      track.addEventListener('touchstart', (e) => { startDrag(); onDrag(e.touches[0].clientX); });
      track.addEventListener('touchmove', (e) => onDrag(e.touches[0].clientX));
      track.addEventListener('touchend', stopDrag);

      setTime(0);
    }
    buildScrubber();

    // ===== CAREER TRAJECTORY =====
    function buildCareer() {
      const wrap = $('#pjdmCareerLine') as HTMLElement;
      if (!wrap) return;
      const W = 760, H = 200;
      const stepX = W / (FIGHTS.length + 1);

      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);

      let path = '';
      FIGHTS.forEach((f, i) => {
        const x = stepX * (i + 1);
        const y = H / 2 + (Math.sin(i * 0.8) * 10);
        if (i === 0) path += `M ${x} ${y} `;
        else path += `L ${x} ${y} `;
      });
      svg.innerHTML = `
        <defs>
          <linearGradient id="pjdmCareerGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#25252e"/>
            <stop offset="100%" stop-color="#e63946"/>
          </linearGradient>
        </defs>
        <path d="${path}" stroke="url(#pjdmCareerGrad)" stroke-width="2" fill="none" stroke-dasharray="600" stroke-dashoffset="600" class="pjdm-career-path"/>
      `;
      wrap.appendChild(svg);

      FIGHTS.forEach((f, i) => {
        const node = document.createElement('div');
        const classes = ['pjdm-career-node'];
        if (!f.ko) classes.push('pjdm-loss');
        if ((f as any).final) classes.push('pjdm-final');
        node.className = classes.join(' ');
        const x = stepX * (i + 1);
        const y = H / 2 + (Math.sin(i * 0.8) * 10);
        node.style.left = `calc(${(x/W)*100}% - 32px)`;
        node.style.top = (y - 32) + 'px';
        node.style.opacity = '0';
        node.style.transform = 'scale(0)';
        node.innerHTML = `<span>${f.method}</span>`;
        const lbl = document.createElement('div');
        lbl.className = 'pjdm-career-node-label';
        lbl.innerHTML = `<div class="pjdm-cn-name">${f.name}</div><div class="pjdm-cn-date">${f.date} · ${f.round}</div>`;
        node.appendChild(lbl);
        wrap.appendChild(node);
      });
    }
    function animateCareer() {
      const path = $('.pjdm-career-path') as SVGElement;
      if (path) {
        path.style.transition = 'stroke-dashoffset 2s ease';
        path.style.strokeDashoffset = '0';
      }
      $$('.pjdm-career-node').forEach((n, i) => {
        setTimeout(() => {
          (n as HTMLElement).style.transition = 'opacity 0.4s, transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1)';
          (n as HTMLElement).style.opacity = '1';
          (n as HTMLElement).style.transform = 'scale(1)';
        }, 200 + i * 200);
      });
    }
    buildCareer();

    // ===== KO RANKING =====
    function buildKoRank() {
      const wrap = $('#pjdmKoRank') as HTMLElement;
      if (!wrap) return;
      const max = 13;
      KO_RANKING.forEach(r => {
        const row = document.createElement('div');
        row.className = 'pjdm-ko-rank-row';
        const pct = (r.kos / max * 100).toFixed(0);
        row.innerHTML = `
          <div class="pjdm-ko-rank-name ${r.active ? 'pjdm-active' : ''}">${r.name}</div>
          <div class="pjdm-ko-rank-bar">
            <div class="pjdm-ko-rank-fill ${r.active ? 'pjdm-fill-red' : 'pjdm-fill-gray'}" data-width="${pct}">
              <span class="pjdm-yrs">${r.years}</span>
            </div>
          </div>
          <div class="pjdm-ko-rank-count ${r.active ? 'pjdm-active' : ''}">${r.kos}</div>
        `;
        wrap.appendChild(row);
      });
    }
    buildKoRank();
  });
</script>
