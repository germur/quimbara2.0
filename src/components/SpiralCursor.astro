---
/**
 * SpiralCursor.astro — Round Clock cursor (MMA fight timer).
 *
 * Inspirado en el reloj del referí dentro de la jaula UFC:
 *  · Estado normal: pill mono "5:00" (tiempo completo del round)
 *  · Estado hover:  pill acid "0:30" (los últimos 30 segundos — "championship rounds")
 *  · Click: contracción breve + flash
 *
 * Sigue el cursor con lerp (sensación inertial). Solo desktop.
 * Respeta prefers-reduced-motion y pointer:coarse (touch).
 */
---

<div id="rc-cursor" aria-hidden="true">
  <div id="rc-pill">
    <span id="rc-time">5:00</span>
  </div>
  <div id="rc-dot"></div>
</div>

<style is:global>
  /* Hide native cursor when our custom one is active */
  html.rc-on,
  html.rc-on body,
  html.rc-on a,
  html.rc-on button,
  html.rc-on input,
  html.rc-on label { cursor: none !important; }

  #rc-cursor {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 9999;
    display: none;
  }
  #rc-cursor.visible { display: block; }

  #rc-pill {
    position: absolute;
    top: 0;
    left: 0;
    min-width: 52px;
    padding: 5px 9px 4px;
    background: #0A0A0B;
    color: #F4F2EC;
    border: 1px solid rgba(244,242,236,0.18);
    border-radius: 999px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-align: center;
    line-height: 1;
    transform: translate3d(-50%, -50%, 0) scale(1);
    transition: background 0.18s ease, color 0.18s ease,
                border-color 0.18s ease, transform 0.16s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.18s ease;
    will-change: transform;
    box-shadow: 0 2px 8px rgba(0,0,0,0.25);
  }
  #rc-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #F2D928;
    transform: translate3d(-50%, -50%, 0);
    will-change: transform;
    box-shadow: 0 0 6px rgba(242,217,40,0.7);
  }

  /* Hover state — "championship round" colors */
  #rc-cursor.hover #rc-pill {
    background: #F2D928;
    color: #0A0A0B;
    border-color: #F2D928;
    transform: translate3d(-50%, -50%, 0) scale(1.08);
    box-shadow: 0 4px 16px rgba(242,217,40,0.35);
  }
  #rc-cursor.hover #rc-dot {
    background: #0A0A0B;
    box-shadow: 0 0 6px rgba(0,0,0,0.4);
  }

  /* Click feedback */
  #rc-cursor.click #rc-pill {
    transform: translate3d(-50%, -50%, 0) scale(0.85);
  }

  /* Pulsing during championship round (last 30s) */
  @keyframes rc-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.55; }
  }
  #rc-cursor.hover #rc-time {
    animation: rc-pulse 0.6s ease-in-out infinite;
  }
</style>

<script is:inline>
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine   = window.matchMedia('(pointer: fine)').matches;
    if (reduce || !fine) return;

    const root = document.getElementById('rc-cursor');
    const pill = document.getElementById('rc-pill');
    const dot  = document.getElementById('rc-dot');
    const time = document.getElementById('rc-time');
    if (!root || !pill || !dot || !time) return;

    document.documentElement.classList.add('rc-on');
    root.classList.add('visible');

    // Position state
    let mx = window.innerWidth / 2, my = window.innerHeight / 2;
    let px = mx, py = my; // pill lerps

    let hovering = false;

    const onMove = (e) => { mx = e.clientX; my = e.clientY; };
    const onDown = () => root.classList.add('click');
    const onUp   = () => root.classList.remove('click');

    // What triggers "championship round" mode
    const HOVER_SEL = 'a, button, [role="button"], [data-cursor], input[type="submit"], .qb-wordmark, label[for], summary';

    const onOver = (e) => {
      const target = e.target;
      if (target && target.closest && target.closest(HOVER_SEL)) {
        if (!hovering) {
          hovering = true;
          root.classList.add('hover');
          time.textContent = '0:30'; // last 30 seconds — fight is about to end
        }
      }
    };
    const onOut = (e) => {
      const target = e.target;
      if (target && target.closest && target.closest(HOVER_SEL)) {
        const to = e.relatedTarget;
        if (!to || !to.closest || !to.closest(HOVER_SEL)) {
          hovering = false;
          root.classList.remove('hover');
          time.textContent = '5:00'; // full round
        }
      }
    };

    window.addEventListener('mousemove',   onMove,  { passive: true });
    window.addEventListener('mousedown',   onDown,  { passive: true });
    window.addEventListener('mouseup',     onUp,    { passive: true });
    document.addEventListener('mouseover', onOver,  { passive: true });
    document.addEventListener('mouseout',  onOut,   { passive: true });

    document.addEventListener('mouseleave', () => { root.style.opacity = '0'; });
    document.addEventListener('mouseenter', () => { root.style.opacity = '1'; });

    const tick = () => {
      // Dot follows cursor 1:1
      dot.style.transform = `translate3d(${mx}px, ${my}px, 0) translate3d(-50%, -50%, 0)`;

      // Pill lerps for inertial feel + offset down-right so it doesn't cover what you're pointing at
      px += (mx - px) * 0.20;
      py += (my - py) * 0.20;
      const offX = 16, offY = 16;
      // Apply translate only via inline; the scale & extra translate come from CSS class transforms
      pill.style.left = `${px + offX}px`;
      pill.style.top  = `${py + offY}px`;

      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  })();
</script>
