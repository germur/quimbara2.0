---
/**
 * SpiralCursor.astro — Round Clock cursor (MMA fight timer).
 *
 * Inspirado en el reloj del referí dentro de la jaula UFC:
 *  · Estado normal: pill mono "5:00" (tiempo completo del round)
 *  · Estado hover:  pill acid "0:30" (los últimos 30 segundos — "championship rounds")
 *  · Click: contracción breve + flash
 *
 * Sigue el cursor con lerp (sensación inertial). Solo desktop.
 * Respeta prefers-reduced-motion y pointer:coarse (touch).
 */
---

<div id="rc-cursor" aria-hidden="true">
  <div id="rc-pill-position">
    <div id="rc-pill">
      <span id="rc-time">5:00</span>
    </div>
  </div>
  <div id="rc-dot"></div>
</div>

<style is:global>
  /* Hide native cursor when our custom one is active */
  html.rc-on,
  html.rc-on body,
  html.rc-on a,
  html.rc-on button,
  html.rc-on input,
  html.rc-on label { cursor: none !important; }

  #rc-cursor {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 9999;
    display: none;
  }
  #rc-cursor.visible { display: block; }

  #rc-pill-position {
    position: absolute;
    top: 0;
    left: 0;
    will-change: transform;
  }

  #rc-pill {
    position: absolute;
    top: 0;
    left: 0;
    min-width: 52px;
    padding: 5px 9px 4px;
    background: #0A0A0B;
    color: #F4F2EC;
    border: 1px solid rgba(244,242,236,0.18);
    border-radius: 999px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-align: center;
    line-height: 1;
    transform: translate3d(-50%, -50%, 0) scale(1);
    transition: background 0.18s ease, color 0.18s ease,
                border-color 0.18s ease, transform 0.16s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.18s ease;
    will-change: transform;
    box-shadow: 0 2px 8px rgba(0,0,0,0.25);
  }
  #rc-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #F2D928;
    transform: translate3d(-50%, -50%, 0);
    will-change: transform;
    box-shadow: 0 0 6px rgba(242,217,40,0.7);
  }

  /* Hover state — "championship round" colors */
  #rc-cursor.hover #rc-pill {
    background: #F2D928;
    color: #0A0A0B;
    border-color: #F2D928;
    transform: translate3d(-50%, -50%, 0) scale(1.08);
    box-shadow: 0 4px 16px rgba(242,217,40,0.35);
  }
  #rc-cursor.hover #rc-dot {
    background: #0A0A0B;
    box-shadow: 0 0 6px rgba(0,0,0,0.4);
  }

  /* Click feedback */
  #rc-cursor.click #rc-pill {
    transform: translate3d(-50%, -50%, 0) scale(0.85);
  }

  /* Pulsing during championship round (last 30s) */
  @keyframes rc-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.55; }
  }
  #rc-cursor.hover #rc-time {
    animation: rc-pulse 0.6s ease-in-out infinite;
  }
</style>

<script>
  import { initRoundCursor } from '../lib/round-cursor.mjs';
  initRoundCursor();
</script>
