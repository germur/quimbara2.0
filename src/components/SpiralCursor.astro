---
/**
 * SpiralCursor.astro — custom cursor con el mark Spiral de Quimbara.
 *
 * Comportamiento:
 *  · Cursor nativo → escondido en desktop, intacto en touch/mobile.
 *  · Ring (outline) sigue el cursor con lerp (sensación inertial).
 *  · Dot (centro) sigue 1:1.
 *  · Hover sobre <a>, <button>, [role=button], .qb-wordmark, [data-cursor]:
 *      ring crece + acid yellow + rotación más rápida.
 *  · Click: ring se contrae brevemente (feedback).
 *  · Respeta prefers-reduced-motion (no se monta).
 *  · Solo se monta si pointer:fine (no en touch).
 */
---

<div id="spiral-cursor" aria-hidden="true" class="hidden">
  <!-- Ring: el Spiral rotando -->
  <svg id="sc-ring" width="40" height="40" viewBox="0 0 220 220">
    <g transform="translate(110 110)" fill="currentColor">
      <path d="M 0 -85 A 85 85 0 1 1 -60 -60 L -42 -42 A 60 60 0 1 0 0 -60 Z"/>
      <path d="M 0 -85 A 85 85 0 1 1 -60 -60 L -42 -42 A 60 60 0 1 0 0 -60 Z" transform="rotate(120) scale(0.72)"/>
      <circle r="14"/>
    </g>
  </svg>
  <!-- Dot: centro preciso -->
  <div id="sc-dot"></div>
</div>

<style is:global>
  /* Hide native cursor on desktop only — activated by JS when supported */
  html.spiral-cursor-on,
  html.spiral-cursor-on body,
  html.spiral-cursor-on * { cursor: none !important; }

  #spiral-cursor {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 9999;
    mix-blend-mode: difference;
  }
  #spiral-cursor.visible { display: block; }

  #sc-ring {
    position: absolute;
    top: 0;
    left: 0;
    color: #F4F2EC;
    opacity: 0.85;
    transform: translate3d(-50%, -50%, 0) rotate(0deg) scale(0.55);
    transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.2s ease,
                color 0.2s ease;
    will-change: transform;
  }
  #sc-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #F2D928;
    transform: translate3d(-50%, -50%, 0);
    will-change: transform;
  }

  /* Hover state — set by JS */
  #spiral-cursor.hover #sc-ring {
    color: #F2D928;
    opacity: 1;
    transform: translate3d(-50%, -50%, 0) rotate(var(--sc-rot, 0deg)) scale(1.05);
  }
  #spiral-cursor.hover #sc-dot {
    background: #F4F2EC;
  }

  /* Click feedback */
  #spiral-cursor.click #sc-ring {
    transform: translate3d(-50%, -50%, 0) rotate(var(--sc-rot, 0deg)) scale(0.4);
  }
</style>

<script is:inline>
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine   = window.matchMedia('(pointer: fine)').matches;
    if (reduce || !fine) return;

    const root = document.getElementById('spiral-cursor');
    const ring = document.getElementById('sc-ring');
    const dot  = document.getElementById('sc-dot');
    if (!root || !ring || !dot) return;

    document.documentElement.classList.add('spiral-cursor-on');
    root.classList.add('visible');

    // Position state
    let mx = window.innerWidth / 2, my = window.innerHeight / 2;
    let rx = mx, ry = my; // ring lerps

    let rot = 0;
    let rotSpeed = 0.4; // base degrees per frame
    let hovering = false;

    const onMove = (e) => {
      mx = e.clientX;
      my = e.clientY;
    };
    const onDown = () => root.classList.add('click');
    const onUp   = () => root.classList.remove('click');

    // Selectors that trigger hover state
    const HOVER_SEL = 'a, button, [role="button"], [data-cursor], input[type="submit"], .qb-wordmark, label[for]';

    const onOver = (e) => {
      const target = e.target;
      if (target && target.closest && target.closest(HOVER_SEL)) {
        hovering = true;
        root.classList.add('hover');
        rotSpeed = 2.4;
      }
    };
    const onOut = (e) => {
      const target = e.target;
      if (target && target.closest && target.closest(HOVER_SEL)) {
        // Check if leaving to a non-hoverable
        const to = e.relatedTarget;
        if (!to || !to.closest || !to.closest(HOVER_SEL)) {
          hovering = false;
          root.classList.remove('hover');
          rotSpeed = 0.4;
        }
      }
    };

    window.addEventListener('mousemove',   onMove,  { passive: true });
    window.addEventListener('mousedown',   onDown,  { passive: true });
    window.addEventListener('mouseup',     onUp,    { passive: true });
    document.addEventListener('mouseover', onOver,  { passive: true });
    document.addEventListener('mouseout',  onOut,   { passive: true });
    window.addEventListener('mouseleave', () => {
      root.style.opacity = '0';
    });
    window.addEventListener('mouseenter', () => {
      root.style.opacity = '1';
    });

    const tick = () => {
      // Dot follows cursor 1:1
      dot.style.transform = `translate3d(${mx}px, ${my}px, 0) translate3d(-50%, -50%, 0)`;

      // Ring lerps for inertial feel
      rx += (mx - rx) * 0.22;
      ry += (my - ry) * 0.22;

      rot = (rot + rotSpeed) % 360;
      ring.style.setProperty('--sc-rot', rot.toFixed(1) + 'deg');
      ring.style.transform =
        `translate3d(${rx}px, ${ry}px, 0) translate3d(-50%, -50%, 0) rotate(${rot}deg) scale(${hovering ? 1.05 : 0.55})`;

      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  })();
</script>
