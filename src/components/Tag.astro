---
// src/components/Tag.astro
interface Props {
  name: string;
  url?: string;
}

const { name, url = `/etiqueta/${name}/` } = Astro.props;
---

<a href={url} class="inline-block px-3 py-1 bg-gray-100 text-gray-500 text-xs font-bold uppercase tracking-widest rounded-sm border border-gray-200 transition-colors duration-200 hover:bg-[#111] hover:text-white hover:border-[#111]" style="font-family:var(--font-sans);">
  {name}
</a>
