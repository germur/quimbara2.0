---
/**
 * OctagonScene.astro — wireframe 3D octagonal cage para el hero del homepage.
 *
 * Principios:
 *  · Lazy: solo se inicia cuando el hero entra en viewport (IntersectionObserver).
 *  · Mobile-aware: en pantallas <768px no se monta (solo el SVG estático fallback).
 *  · Reduced-motion: si el user prefiere, se queda el SVG fallback.
 *  · Tree-shaken: solo importa lo mínimo de three.
 *  · Decorativo: aria-hidden, pointer-events:none, vive detrás del contenido.
 *
 * Visualmente: un prisma octagonal (la jaula MMA en abstracto) que rota
 * lento en Y, se inclina con scroll, y reacciona al cursor con tilt.
 * Color: Acid #F2D928 con opacidad baja para que no compita con el texto.
 */
---

<div id="octagon-scene-wrapper"
     class="absolute inset-0 pointer-events-none overflow-hidden"
     aria-hidden="true">
  <!-- Static SVG fallback (mobile, reduced-motion, pre-load) -->
  <svg class="octagon-fallback absolute inset-0 w-full h-full"
       viewBox="-150 -150 300 300" fill="none" preserveAspectRatio="xMidYMid meet">
    <g stroke="#F2D928" stroke-width="0.6" opacity="0.18">
      <!-- Octágono frontal -->
      <polygon points="100,0 70.7,70.7 0,100 -70.7,70.7 -100,0 -70.7,-70.7 0,-100 70.7,-70.7" />
      <!-- Octágono interior (depth fake) -->
      <polygon points="75,0 53,53 0,75 -53,53 -75,0 -53,-53 0,-75 53,-53"
               opacity="0.5" />
      <!-- 8 conexiones radiales -->
      <line x1="100"   y1="0"     x2="75"   y2="0" />
      <line x1="70.7"  y1="70.7"  x2="53"   y2="53" />
      <line x1="0"     y1="100"   x2="0"    y2="75" />
      <line x1="-70.7" y1="70.7"  x2="-53"  y2="53" />
      <line x1="-100"  y1="0"     x2="-75"  y2="0" />
      <line x1="-70.7" y1="-70.7" x2="-53"  y2="-53" />
      <line x1="0"     y1="-100"  x2="0"    y2="-75" />
      <line x1="70.7"  y1="-70.7" x2="53"   y2="-53" />
    </g>
  </svg>

  <!-- WebGL canvas, mounted only when JS upgrades -->
  <canvas id="octagon-canvas" class="absolute inset-0 w-full h-full opacity-0 transition-opacity duration-700"></canvas>
</div>

<script>
  const wrapper = document.getElementById('octagon-scene-wrapper') as HTMLDivElement | null;
  const canvas = document.getElementById('octagon-canvas') as HTMLCanvasElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const desktop = window.matchMedia('(min-width: 768px)');

  // Keep the SVG on mobile and reduced motion, without downloading Three.js.
  if (wrapper && canvas && desktop.matches && !reduce.matches) {
    const io = new IntersectionObserver(async (entries) => {
      if (!entries[0]?.isIntersecting) return;
      io.disconnect();
      try {
        const { initOctagon } = await import('../lib/octagon-scene');
        // Preferences/viewport may have changed while the module downloaded.
        if (!desktop.matches || reduce.matches || !wrapper.isConnected) return;
        initOctagon(wrapper, canvas, wrapper.querySelector('.octagon-fallback'));
      } catch (error) {
        // The decorative scene must not hide the fallback if WebGL or loading fails.
        console.warn('Quimbara: keeping the static octagon.', error);
      }
    }, { threshold: 0.1 });
    io.observe(wrapper);
  }
</script>
