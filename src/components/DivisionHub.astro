---
/**
 * Hub SEO por división — página landing para keywords como
 * "peleadores peso ligero UFC", "ranking peso pluma UFC".
 * Se renderiza en /peleadores/peso-pesado/, /peleadores/ligero/, etc.
 */
import FIGHTERS from '../data/fighters.json';
import { divLabels, divSlugs, divWeights, isFemale } from '../data/divisions';

interface Props {
  division: string; // ej. "Lightweight"
}

const { division } = Astro.props;
const PX = 'clamp(16px,4vw,60px)';
const label = divLabels[division] ?? division;
const slug = divSlugs[division] ?? '';
const weight = divWeights[division] ?? '';
const female = isFemale(division);

type Fighter = typeof FIGHTERS[number];
const fighters = FIGHTERS
  .filter(f => f.div === division)
  .sort((a, b) => {
    if (a.rank === 'C' && b.rank !== 'C') return -1;
    if (b.rank === 'C' && a.rank !== 'C') return 1;
    const ra = Number(a.rank), rb = Number(b.rank);
    if (!isNaN(ra) && !isNaN(rb)) return ra - rb;
    if (!isNaN(ra)) return -1;
    if (!isNaN(rb)) return 1;
    return a.name.localeCompare(b.name);
  });

const isRanked = (f: Fighter) => f.rank === 'C' || (!isNaN(Number(f.rank)) && Number(f.rank) <= 15);
const ranked = fighters.filter(isRanked);
const rest = fighters.filter(f => !isRanked(f) && f.img);
const champ = ranked.find(f => f.rank === 'C');
const contenders = ranked.filter(f => f.rank !== 'C');
const initials = (name: string) => name.split(' ').slice(0, 2).map(n => n[0]).join('');

const WIN_BG: Record<string, string> = {
  KO: '#E53935', TKO: '#E53935', SUB: '#7B1FA2',
  UD: '#111', SD: '#111', MD: '#111',
};

// Adjacent divisions for internal linking
const allSlugs = Object.entries(divSlugs);
const maleOrder = allSlugs.filter(([k]) => !isFemale(k));
const femaleOrder = allSlugs.filter(([k]) => isFemale(k));
const pool = female ? femaleOrder : maleOrder;
const curIdx = pool.findIndex(([k]) => k === division);
const prevDiv = curIdx > 0 ? pool[curIdx - 1] : null;
const nextDiv = curIdx < pool.length - 1 ? pool[curIdx + 1] : null;
---

<!-- ── Breadcrumb ── -->
<nav aria-label="Breadcrumb" class="text-xs text-gray-400 mb-0" style={`padding: 20px ${PX} 0; max-width:1400px; margin:0 auto; font-family:var(--font-sans);`}>
  <ol class="flex items-center gap-1.5" itemscope itemtype="https://schema.org/BreadcrumbList">
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a itemprop="item" href="/"><span itemprop="name">Inicio</span></a>
      <meta itemprop="position" content="1" />
    </li>
    <li class="text-gray-600">/</li>
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a itemprop="item" href="/peleadores/"><span itemprop="name">Peleadores</span></a>
      <meta itemprop="position" content="2" />
    </li>
    <li class="text-gray-600">/</li>
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <span itemprop="name" class="text-gray-600">{label}</span>
      <meta itemprop="position" content="3" />
    </li>
  </ol>
</nav>

<!-- ── Hero division ── -->
<div style={`background:#111; padding: 50px ${PX} 50px;`}>
  <div style="max-width:1400px; margin:0 auto;">
    <div class="flex items-center gap-3 mb-5">
      <span class="px-3 py-1 text-[10px] font-black uppercase tracking-widest rounded-sm text-[#111]"
            style={`font-family:var(--font-sans); background:#F2D928; color:#0A0A0B;`}>
        {female ? 'UFC Femenino' : 'UFC'}
      </span>
      {weight && (
        <span class="text-gray-500 text-xs uppercase tracking-widest" style="font-family:var(--font-sans);">{weight}</span>
      )}
    </div>
    <h1 style="font-family:var(--font-display);font-size:clamp(2.5rem,8vw,5.5rem);line-height:0.95;color:#fff;">
      {label}
    </h1>
    <p class="text-gray-400 mt-4 text-sm max-w-2xl" style="font-family:var(--font-sans);">
      Rankings oficiales, campeón actual y roster completo de la división de {label.toLowerCase()} de UFC.
      {ranked.length} peleador{ranked.length !== 1 ? 'es' : ''} rankeados y {rest.length} en el roster.
    </p>
  </div>
</div>

<!-- ── Content ── -->
<div style={`max-width:1400px; margin:0 auto; padding: 40px ${PX} 80px;`}>

  {/* ═══ Campeón destacado ═══ */}
  {champ && (
    <a href={`/peleadores/${champ.slug}/`}
       class="group flex flex-col md:flex-row gap-0 rounded-lg overflow-hidden mb-10 border border-gray-100 transition-all duration-300 hover:shadow-xl hover:border-gray-200"
       style="background:#fff;">
      <div class="relative md:w-72 flex-shrink-0 bg-gray-100 overflow-hidden" style="min-height:300px;">
        {champ.img ? (
          <img src={champ.img} alt={champ.name}
               class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
               loading="eager" />
        ) : (
          <div class="w-full h-full flex items-center justify-center">
            <span class="text-gray-300 text-7xl font-black" style="font-family:var(--font-display);">{initials(champ.name)}</span>
          </div>
        )}
      </div>
      <div class="flex flex-col justify-center p-6 md:p-10 flex-1 border-l border-gray-100">
        <div class="flex items-center gap-3 mb-4 flex-wrap">
          <span class="px-3 py-1 text-[10px] font-black uppercase tracking-widest rounded-sm bg-[#F2D928] text-[#111]"
                style="font-family:var(--font-sans);">Campeón</span>
        </div>
        <h2 class="text-[#0A0A0B] leading-none group-hover:text-[#F2D928] transition-colors duration-200"
            style="font-family:var(--font-display);font-size:clamp(2rem,5vw,3.5rem);">{champ.name}</h2>
        {champ.nick?.trim() && (
          <div class="text-gray-400 text-lg italic mt-2" style="font-family:var(--font-serif);">"{champ.nick.trim()}"</div>
        )}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-6 pt-6 border-t border-gray-100">
          <div>
            <div class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-1" style="font-family:var(--font-sans);">Récord</div>
            <div class="text-[#111] font-black text-3xl" style="font-family:var(--font-display);">{champ.rec}</div>
          </div>
          <div>
            <div class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-1" style="font-family:var(--font-sans);">País</div>
            <div class="text-[#111] font-semibold text-sm" style="font-family:var(--font-sans);">{champ.from || '—'}</div>
          </div>
          {champ.height && (
            <div>
              <div class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-1" style="font-family:var(--font-sans);">Estatura</div>
              <div class="text-[#111] font-semibold text-sm" style="font-family:var(--font-sans);">{champ.height}</div>
            </div>
          )}
          {(champ.formTypes ?? []).length > 0 && (
            <div>
              <div class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2" style="font-family:var(--font-sans);">Racha</div>
              <div class="flex gap-1.5">
                {(champ.formTypes ?? []).slice(0, 5).map((ft: {outcome: string; winType: string}) => {
                  const isLoss = ft.outcome === 'L';
                  const isDraw = ft.outcome === 'D';
                  const bg = isLoss ? '#fff' : isDraw ? '#9ca3af' : (WIN_BG[ft.winType] ?? '#111');
                  const color = isLoss ? '#E53935' : '#fff';
                  const border = isLoss ? '1.5px solid #E53935' : `1.5px solid ${bg}`;
                  return (
                    <div class="w-7 h-7 rounded-full flex items-center justify-center text-[9px] font-black"
                         style={`background:${bg}; color:${color}; border:${border};`}>
                      {ft.outcome}
                    </div>
                  );
                })}
              </div>
            </div>
          )}
        </div>
      </div>
    </a>
  )}

  {/* ═══ Top 15 ═══ */}
  {contenders.length > 0 && (
    <div class="mb-12">
      <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-4"
          style="font-family:var(--font-sans);">Top 15 · {label}</h2>
      {contenders.map(f => (
        <a href={`/peleadores/${f.slug}/`}
           class="group flex items-center gap-4 px-4 py-3 border-b border-gray-100 transition-colors duration-200 hover:bg-gray-50">
          <div class="text-gray-300 font-black text-sm w-6 text-center flex-shrink-0"
               style="font-family:var(--font-display);">#{f.rank}</div>
          <div class="w-10 h-10 rounded-full overflow-hidden flex-shrink-0 bg-gray-100 flex items-center justify-center border border-gray-200">
            {f.img ? (
              <img src={f.img} alt={f.name} class="w-full h-full object-cover object-top" loading="lazy" />
            ) : (
              <span class="text-gray-400 text-xs font-black" style="font-family:var(--font-display);">{initials(f.name)}</span>
            )}
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-[#0A0A0B] text-sm font-bold group-hover:text-[#F2D928] transition-colors truncate"
                 style="font-family:var(--font-display);">{f.name}</div>
            {f.nick?.trim() && (
              <div class="text-gray-400 text-xs italic truncate" style="font-family:var(--font-sans);">"{f.nick.trim()}"</div>
            )}
          </div>
          <div class="text-gray-400 text-xs hidden sm:block w-28 text-right truncate"
               style="font-family:var(--font-sans);">{f.from || ''}</div>
          <div class="text-[#111] font-black text-sm w-16 text-right"
               style="font-family:var(--font-display);">{f.rec}</div>
          <div class="hidden md:flex gap-1 flex-shrink-0">
            {(f.formTypes ?? []).slice(0, 5).map((ft: {outcome: string; winType: string}) => {
              const isLoss = ft.outcome === 'L';
              const isDraw = ft.outcome === 'D';
              const bg = isLoss ? '#fff' : isDraw ? '#9ca3af' : (WIN_BG[ft.winType] ?? '#111');
              const color = isLoss ? '#E53935' : '#fff';
              const border = isLoss ? '1px solid #E53935' : `1px solid ${bg}`;
              return (
                <div class="w-5 h-5 rounded-full flex items-center justify-center text-[8px] font-black"
                     style={`background:${bg}; color:${color}; border:${border};`}>
                  {ft.outcome}
                </div>
              );
            })}
          </div>
          <div class="text-gray-300 group-hover:text-[#F2D928] text-xs font-bold transition-colors">→</div>
        </a>
      ))}
    </div>
  )}

  {/* ═══ Roster con foto ═══ */}
  {rest.length > 0 && (
    <div class="mb-12">
      <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-5"
          style="font-family:var(--font-sans);">Roster completo · {rest.length} peleadores</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {rest.map(f => (
          <a href={`/peleadores/${f.slug}/`}
             class="group rounded-lg overflow-hidden bg-gray-50 border border-gray-100 hover:border-gray-300 hover:shadow-md transition-all">
            <div class="aspect-square bg-gray-100 overflow-hidden flex items-center justify-center">
              {f.img ? (
                <img src={f.img} alt={f.name} class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300" loading="lazy" />
              ) : (
                <span class="text-gray-300 text-2xl font-black" style="font-family:var(--font-display);">{initials(f.name)}</span>
              )}
            </div>
            <div class="p-3">
              <div class="text-[#0A0A0B] text-xs font-bold leading-tight group-hover:text-[#F2D928] transition-colors line-clamp-2"
                   style="font-family:var(--font-display);">{f.name}</div>
              <div class="text-gray-400 text-[10px] mt-1 font-mono">{f.rec}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  )}

  {/* ═══ Navegación entre divisiones ═══ */}
  <div class="flex items-center justify-between pt-8 border-t border-gray-200">
    {prevDiv ? (
      <a href={`/peleadores/${prevDiv[1]}/`}
         class="text-sm font-bold text-gray-500 hover:text-[#F2D928] transition-colors"
         style="font-family:var(--font-sans);">
        ← {divLabels[prevDiv[0]]}
      </a>
    ) : <div></div>}
    <a href="/peleadores/" class="text-sm font-bold text-gray-400 hover:text-[#111] transition-colors"
       style="font-family:var(--font-sans);">
      Todas las divisiones
    </a>
    {nextDiv ? (
      <a href={`/peleadores/${nextDiv[1]}/`}
         class="text-sm font-bold text-gray-500 hover:text-[#F2D928] transition-colors"
         style="font-family:var(--font-sans);">
        {divLabels[nextDiv[0]]} →
      </a>
    ) : <div></div>}
  </div>
</div>

{/* ═══ FAQ Schema (featured snippet bait) ═══ */}
{champ && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": `¿Quién es el campeón de ${label.toLowerCase()} de UFC?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": `El actual campeón de ${label.toLowerCase()} de UFC es ${champ.name}${champ.nick ? ` "${champ.nick}"` : ''} con récord profesional de ${champ.rec}.`
        }
      },
      {
        "@type": "Question",
        "name": `¿Cuánto pesan los peleadores de ${label.toLowerCase()} en UFC?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": `La división de ${label.toLowerCase()} de UFC tiene un límite de peso de ${weight}.`
        }
      }
    ]
  })} />
)}
