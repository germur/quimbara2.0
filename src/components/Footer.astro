---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-gray-200 mt-10" style="padding: 36px clamp(16px,4vw,60px);">
  <div style="max-width:1400px; margin:0 auto;" class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">

    <!-- Marca -->
    <div>
      <div class="text-[#111] text-2xl tracking-widest uppercase" style="font-family: var(--font-display);">Quimbara</div>
      <div class="text-sm text-gray-500 mt-1" style="font-family: var(--font-sans);">UFC — Análisis, Noticias & Cobertura</div>
    </div>

    <!-- Links -->
    <div class="flex flex-wrap gap-6 text-sm text-gray-600" style="font-family: var(--font-sans);">
      <a href="/blog" class="hover:text-[#E53935] transition-colors duration-200">Artículos</a>
      <a href="/eventos" class="hover:text-[#E53935] transition-colors duration-200">Eventos</a>
      <a href="/aviso-legal" class="hover:text-[#E53935] transition-colors duration-200">Aviso Legal</a>
      <a href="/privacidad" class="hover:text-[#E53935] transition-colors duration-200">Privacidad</a>
      <a href="/rss.xml" class="hover:text-[#E53935] transition-colors duration-200">RSS</a>
    </div>

    <!-- Copyright -->
    <div class="text-xs text-gray-400" style="font-family: var(--font-sans);">
      © {currentYear} Quimbara
    </div>
  </div>
</footer>
