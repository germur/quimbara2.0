---
import { divLabels, divSlugs, divOrder, isFemale } from '../data/divisions';

const activePath = Astro.url.pathname;

const navLinks = [
  { href: '/blog/', label: 'Blog', match: 'blog' },
  { href: '/rankings/', label: 'Rankings', match: 'ranking' },
  { href: '/eventos/', label: 'Eventos', match: 'eventos' },
];

const maleDivs = divOrder.filter(d => !isFemale(d));
const femaleDivs = divOrder.filter(d => isFemale(d));
---

<header id="site-header"
        class="fixed top-0 left-0 right-0 z-50 transition-transform duration-300 will-change-transform"
        style="background:#0a0a0a; border-bottom:1px solid rgba(255,255,255,0.08);">
  <div style="max-width:1400px; margin:0 auto; padding: 0 clamp(16px,4vw,60px);"
       class="h-16 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="text-white text-2xl md:text-3xl tracking-widest transition-opacity duration-200 hover:opacity-70"
       style="font-family: var(--font-display);">
      QUIM<span style="color:#FFD600;">BARA</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-7" style="font-family: var(--font-sans);">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            "text-xs font-semibold uppercase tracking-widest transition-colors duration-200",
            activePath.includes(link.match)
              ? "text-[#FFD600]"
              : "text-gray-300 hover:text-white"
          ]}
        >
          {link.label}
        </a>
      ))}

      <!-- Peleadores dropdown -->
      <div class="relative" id="pel-dropdown">
        <button
          class:list={[
            "text-xs font-semibold uppercase tracking-widest transition-colors duration-200 flex items-center gap-1",
            activePath.includes('peleador')
              ? "text-[#FFD600]"
              : "text-gray-300 hover:text-white"
          ]}
          aria-expanded="false" aria-haspopup="true">
          Peleadores
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M2 4 L5 7 L8 4" />
          </svg>
        </button>
        <div class="pel-menu hidden absolute top-full left-1/2 -translate-x-1/2 pt-3" style="min-width:320px;">
          <div class="rounded-lg overflow-hidden shadow-2xl border border-white/10" style="background:#151515;">
            <a href="/peleadores/" class="block px-5 py-3 text-xs font-bold uppercase tracking-widest text-[#FFD600] hover:bg-white/5 transition-colors border-b border-white/5">
              Todos los peleadores
            </a>
            <div class="grid grid-cols-2 gap-0">
              <div class="border-r border-white/5">
                <div class="px-4 pt-3 pb-1 text-[9px] font-black uppercase tracking-widest text-gray-500">Masculino</div>
                {maleDivs.map(d => (
                  <a href={`/peleadores/${divSlugs[d]}/`}
                     class:list={[
                       "block px-4 py-2 text-xs transition-colors hover:bg-white/5",
                       activePath.includes(divSlugs[d])
                         ? "text-[#FFD600] font-semibold"
                         : "text-gray-300"
                     ]}>
                    {divLabels[d]}
                  </a>
                ))}
              </div>
              <div>
                <div class="px-4 pt-3 pb-1 text-[9px] font-black uppercase tracking-widest text-gray-500">Femenino</div>
                {femaleDivs.map(d => (
                  <a href={`/peleadores/${divSlugs[d]}/`}
                     class:list={[
                       "block px-4 py-2 text-xs transition-colors hover:bg-white/5",
                       activePath.includes(divSlugs[d])
                         ? "text-[#FFD600] font-semibold"
                         : "text-gray-300"
                     ]}>
                    {divLabels[d]}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- Right cluster: search + mobile -->
    <div class="flex items-center gap-2">
      <!-- Search button (lupita) -->
      <button id="search-toggle"
              class="p-2 text-gray-300 hover:text-[#FFD600] transition-colors duration-200"
              aria-label="Buscar peleadores">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Mobile hamburger -->
      <button id="mobile-toggle"
              class="md:hidden p-2 text-gray-300 hover:text-white transition-colors duration-200"
              aria-label="Abrir menú" aria-expanded="false">
        <svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="7" x2="21" y2="7"></line>
          <line x1="3" y1="17" x2="21" y2="17"></line>
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden" style="background:#0a0a0a; border-top:1px solid rgba(255,255,255,0.08);">
    <nav class="flex flex-col" style="padding: 0 clamp(16px,4vw,60px); font-family:var(--font-sans);">
      {navLinks.map(link => (
        <a href={link.href}
           class="py-4 text-sm font-semibold uppercase tracking-widest text-gray-300 border-b border-white/5 hover:text-[#FFD600] transition-colors duration-200">
          {link.label}
        </a>
      ))}
      <a href="/peleadores/"
         class="py-4 text-sm font-semibold uppercase tracking-widest text-gray-300 border-b border-white/5 hover:text-[#FFD600] transition-colors duration-200">
        Peleadores
      </a>
      <div class="py-2 pl-4 border-b border-white/5">
        <div class="text-[9px] font-black uppercase tracking-widest text-gray-600 mb-2">Divisiones</div>
        <div class="grid grid-cols-2 gap-x-4">
          {divOrder.map(d => (
            <a href={`/peleadores/${divSlugs[d]}/`}
               class="py-1.5 text-xs text-gray-400 hover:text-[#FFD600] transition-colors">
              {divLabels[d]}
            </a>
          ))}
        </div>
      </div>
    </nav>
  </div>
</header>

<!-- Search overlay -->
<div id="search-overlay" class="fixed inset-0 z-[60] hidden"
     style="background: rgba(10,10,10,0.96); backdrop-filter: blur(8px);">
  <div style="max-width:880px; margin:0 auto; padding: clamp(60px,10vh,120px) clamp(16px,4vw,40px) 40px;">
    <div class="flex items-center gap-3 pb-4 border-b-2 border-[#FFD600]">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFD600" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input id="search-input" type="text" autocomplete="off" placeholder="Busca un peleador… (Ilia Topuria, Conor, Lazy Boy)"
             class="flex-1 bg-transparent text-white text-xl md:text-2xl placeholder:text-gray-500 outline-none"
             style="font-family: var(--font-sans);" />
      <button id="search-close" class="p-2 text-gray-400 hover:text-white" aria-label="Cerrar búsqueda">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <p id="search-hint" class="text-gray-500 text-xs uppercase tracking-widest mt-4" style="font-family:var(--font-sans);">
      Escribe al menos 2 letras para buscar
    </p>

    <ul id="search-results" class="mt-4 max-h-[60vh] overflow-y-auto divide-y divide-white/5"
        style="font-family:var(--font-sans);"></ul>
  </div>
</div>

<script>
  const header = document.getElementById('site-header') as HTMLElement;
  const toggle = document.getElementById('mobile-toggle') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLElement;
  const iconMenu = document.getElementById('icon-menu') as SVGElement;
  const iconClose = document.getElementById('icon-close') as SVGElement;

  // Hide on scroll down, show on scroll up
  let lastY = window.scrollY;
  const onScroll = () => {
    const y = window.scrollY;
    const isMenuOpen = !menu.classList.contains('hidden');
    if (isMenuOpen) { header.style.transform = 'translateY(0)'; lastY = y; return; }
    if (y > 80 && y > lastY) {
      header.style.transform = 'translateY(-100%)';
    } else {
      header.style.transform = 'translateY(0)';
    }
    lastY = y;
  };
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile toggle
  toggle.addEventListener('click', () => {
    menu.classList.toggle('hidden');
    iconMenu.classList.toggle('hidden');
    iconClose.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!menu.classList.contains('hidden')));
  });

  // ============ PELEADORES DROPDOWN ============
  const pelDrop = document.getElementById('pel-dropdown') as HTMLElement;
  if (pelDrop) {
    const btn = pelDrop.querySelector('button') as HTMLButtonElement;
    const pelMenu = pelDrop.querySelector('.pel-menu') as HTMLElement;
    let timeout: ReturnType<typeof setTimeout>;

    const show = () => { clearTimeout(timeout); pelMenu.classList.remove('hidden'); btn.setAttribute('aria-expanded', 'true'); };
    const hide = () => { timeout = setTimeout(() => { pelMenu.classList.add('hidden'); btn.setAttribute('aria-expanded', 'false'); }, 150); };

    pelDrop.addEventListener('mouseenter', show);
    pelDrop.addEventListener('mouseleave', hide);
    btn.addEventListener('click', () => pelMenu.classList.contains('hidden') ? show() : hide());
  }

  // ============ SEARCH OVERLAY ============
  const overlay = document.getElementById('search-overlay') as HTMLElement;
  const searchBtn = document.getElementById('search-toggle') as HTMLButtonElement;
  const closeBtn = document.getElementById('search-close') as HTMLButtonElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('search-results') as HTMLUListElement;
  const hint = document.getElementById('search-hint') as HTMLElement;

  let index: Array<{slug:string;name:string;nick:string;div:string;img:string;rank:string}> | null = null;
  let indexLoading = false;

  const loadIndex = async () => {
    if (index || indexLoading) return;
    indexLoading = true;
    try {
      const r = await fetch('/fighters-index.json');
      index = await r.json();
    } catch (e) { console.error('Search index load failed', e); }
    indexLoading = false;
  };

  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  const render = (q: string) => {
    if (!index) { results.innerHTML = ''; return; }
    const nq = norm(q.trim());
    if (nq.length < 2) {
      hint.textContent = 'Escribe al menos 2 letras para buscar';
      results.innerHTML = '';
      return;
    }
    const matches = index
      .filter(f => norm(f.name).includes(nq) || norm(f.nick).includes(nq))
      .slice(0, 20);
    hint.textContent = matches.length ? `${matches.length} resultado${matches.length===1?'':'s'}` : 'Sin resultados';
    results.innerHTML = matches.map(f => `
      <li>
        <a href="/peleadores/${f.slug}/" class="flex items-center gap-4 py-3 px-2 hover:bg-white/5 transition-colors">
          <div class="w-12 h-12 rounded-full overflow-hidden bg-white/5 flex-shrink-0 border border-white/10">
            <img src="${f.img}" alt="${f.name}" loading="lazy" class="w-full h-full object-cover" onerror="this.style.display='none'">
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-white text-sm font-semibold truncate">${f.name}${f.nick ? ` <span class='text-gray-500 font-normal'>"${f.nick}"</span>` : ''}</div>
            <div class="text-gray-500 text-xs uppercase tracking-wider truncate">${f.div || ''}</div>
          </div>
          ${f.rank ? `<span class="text-[10px] font-black bg-[#FFD600] text-black px-2 py-0.5 rounded uppercase tracking-wider">${f.rank === 'C' ? 'Campeón' : '#' + f.rank}</span>` : ''}
        </a>
      </li>
    `).join('');
  };

  const openSearch = async () => {
    overlay.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    await loadIndex();
    setTimeout(() => input.focus(), 50);
  };
  const closeSearch = () => {
    overlay.classList.add('hidden');
    document.body.style.overflow = '';
    input.value = '';
    results.innerHTML = '';
    hint.textContent = 'Escribe al menos 2 letras para buscar';
  };

  searchBtn.addEventListener('click', openSearch);
  closeBtn.addEventListener('click', closeSearch);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) closeSearch(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !overlay.classList.contains('hidden')) closeSearch();
    if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      overlay.classList.contains('hidden') ? openSearch() : closeSearch();
    }
  });
  input.addEventListener('input', () => render(input.value));
</script>
