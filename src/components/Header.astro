---
import { divLabels, divSlugs, divOrder, isFemale } from '../data/divisions';

const activePath = Astro.url.pathname;

const navLinks = [
  { href: '/blog/', label: 'Blog', match: 'blog' },
  { href: '/rankings/', label: 'Rankings', match: 'ranking' },
  { href: '/eventos/', label: 'Eventos', match: 'eventos' },
];

const maleDivs = divOrder.filter(d => !isFemale(d));
const femaleDivs = divOrder.filter(d => isFemale(d));
---

<header id="site-header"
        class="fixed top-0 left-0 right-0 z-50 transition-transform duration-300 will-change-transform"
        style="background:#0A0A0B; border-bottom:1px solid rgba(255,255,255,0.08);">
  <div style="max-width:1400px; margin:0 auto; padding: 0 clamp(16px,4vw,60px);"
       class="h-16 flex items-center justify-between">

    <!-- Logo: Spiral mark + Wave wordmark -->
    <a href="/" class="transition-opacity duration-200 hover:opacity-70"
       style="color:#F4F2EC; display:inline-flex; align-items:center; gap:14px;">
      <svg width="32" height="32" viewBox="0 0 220 220" aria-hidden="true" style="flex-shrink:0;">
        <g transform="translate(110 110)" fill="currentColor">
          <path d="M 0 -85 A 85 85 0 1 1 -60 -60 L -42 -42 A 60 60 0 1 0 0 -60 Z"/>
          <path d="M 0 -85 A 85 85 0 1 1 -60 -60 L -42 -42 A 60 60 0 1 0 0 -60 Z" transform="rotate(120) scale(0.72)"/>
          <circle r="14"/>
        </g>
      </svg>
      <span class="qb-wordmark" style="font-size: clamp(20px, 2.4vw, 28px);">
        <span>Q</span><span>U</span><span>I</span><span>M</span><span>B</span><span>A</span><span>R</span><span>A</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-7" style="font-family: var(--font-sans);">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            "text-xs font-semibold uppercase tracking-widest transition-colors duration-200",
            activePath.includes(link.match)
              ? "text-[#F2D928]"
              : "text-gray-300 hover:text-white"
          ]}
        >
          {link.label}
        </a>
      ))}

      <!-- Peleadores dropdown -->
      <div class="relative" id="pel-dropdown">
        <button
          class:list={[
            "text-xs font-semibold uppercase tracking-widest transition-colors duration-200 flex items-center gap-1",
            activePath.includes('peleador')
              ? "text-[#F2D928]"
              : "text-gray-300 hover:text-white"
          ]}
          aria-expanded="false" aria-haspopup="true">
          Peleadores
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M2 4 L5 7 L8 4" />
          </svg>
        </button>
        <div class="pel-menu hidden absolute top-full left-1/2 -translate-x-1/2 pt-3" style="min-width:320px;">
          <div class="rounded-lg overflow-hidden shadow-2xl border border-white/10" style="background:#151515;">
            <a href="/peleadores/" class="block px-5 py-3 text-xs font-bold uppercase tracking-widest text-[#F2D928] hover:bg-white/5 transition-colors border-b border-white/5">
              Todos los peleadores
            </a>
            <div class="grid grid-cols-2 gap-0">
              <div class="border-r border-white/5">
                <div class="px-4 pt-3 pb-1 text-[9px] font-black uppercase tracking-widest text-gray-500">Masculino</div>
                {maleDivs.map(d => (
                  <a href={`/peleadores/${divSlugs[d]}/`}
                     class:list={[
                       "block px-4 py-2 text-xs transition-colors hover:bg-white/5",
                       activePath.includes(divSlugs[d])
                         ? "text-[#F2D928] font-semibold"
                         : "text-gray-300"
                     ]}>
                    {divLabels[d]}
                  </a>
                ))}
              </div>
              <div>
                <div class="px-4 pt-3 pb-1 text-[9px] font-black uppercase tracking-widest text-gray-500">Femenino</div>
                {femaleDivs.map(d => (
                  <a href={`/peleadores/${divSlugs[d]}/`}
                     class:list={[
                       "block px-4 py-2 text-xs transition-colors hover:bg-white/5",
                       activePath.includes(divSlugs[d])
                         ? "text-[#F2D928] font-semibold"
                         : "text-gray-300"
                     ]}>
                    {divLabels[d]}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- Right cluster: search + mobile -->
    <div class="flex items-center gap-2">
      <!-- Search button (lupita) -->
      <button id="search-toggle"
              class="p-3 text-gray-300 hover:text-[#F2D928] transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-[#F2D928]"
              aria-label="Buscar peleadores" aria-haspopup="dialog" aria-controls="search-overlay">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Mobile hamburger -->
      <button id="mobile-toggle"
              class="md:hidden p-2 text-gray-300 hover:text-white transition-colors duration-200"
              aria-label="Abrir menú" aria-expanded="false">
        <svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="7" x2="21" y2="7"></line>
          <line x1="3" y1="17" x2="21" y2="17"></line>
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden" style="background:#0A0A0B; border-top:1px solid rgba(255,255,255,0.08);">
    <nav class="flex flex-col" style="padding: 0 clamp(16px,4vw,60px); font-family:var(--font-sans);">
      {navLinks.map(link => (
        <a href={link.href}
           class="py-4 text-sm font-semibold uppercase tracking-widest text-gray-300 border-b border-white/5 hover:text-[#F2D928] transition-colors duration-200">
          {link.label}
        </a>
      ))}
      <a href="/peleadores/"
         class="py-4 text-sm font-semibold uppercase tracking-widest text-gray-300 border-b border-white/5 hover:text-[#F2D928] transition-colors duration-200">
        Peleadores
      </a>
      <div class="py-2 pl-4 border-b border-white/5">
        <div class="text-[9px] font-black uppercase tracking-widest text-gray-600 mb-2">Divisiones</div>
        <div class="grid grid-cols-2 gap-x-4">
          {divOrder.map(d => (
            <a href={`/peleadores/${divSlugs[d]}/`}
               class="py-1.5 text-xs text-gray-400 hover:text-[#F2D928] transition-colors">
              {divLabels[d]}
            </a>
          ))}
        </div>
      </div>
    </nav>
  </div>
</header>

<!-- Search overlay -->
<dialog id="search-overlay" aria-labelledby="search-title" class="fixed inset-0 m-0 w-full max-w-none h-dvh max-h-none p-0 border-0 text-white"
     style="background: rgba(10,10,10,0.96); backdrop-filter: blur(8px);">
  <div style="max-width:880px; margin:0 auto; padding: clamp(60px,10vh,120px) clamp(16px,4vw,40px) 40px;">
    <h2 id="search-title" class="sr-only">Buscar peleadores</h2>
    <label for="search-input" class="sr-only">Nombre o apodo del peleador</label>
    <div class="flex items-center gap-3 pb-4 border-b-2 border-[#F2D928]">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#F2D928" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input id="search-input" type="text" autocomplete="off" autofocus aria-describedby="search-hint" placeholder="Busca un peleador… (Ilia Topuria, Conor, Lazy Boy)"
             class="flex-1 min-w-0 bg-transparent text-white text-xl md:text-2xl placeholder:text-gray-400 focus-visible:outline-2 focus-visible:outline-[#F2D928] focus-visible:outline-offset-4"
             style="font-family: var(--font-sans);" />
      <button id="search-close" class="p-3 text-gray-400 hover:text-white focus-visible:outline-2 focus-visible:outline-[#F2D928]" aria-label="Cerrar búsqueda">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <p id="search-hint" role="status" aria-live="polite" aria-atomic="true" class="text-gray-400 text-xs uppercase tracking-widest mt-4" style="font-family:var(--font-sans);">
      Escribe al menos 2 letras para buscar
    </p>

    <button id="search-retry" type="button" hidden class="mt-4 px-4 py-3 border border-[#F2D928] rounded text-[#F2D928] focus-visible:outline-2 focus-visible:outline-[#F2D928]">Volver a intentar</button>
    <ul id="search-results" class="mt-4 max-h-[60vh] overflow-y-auto divide-y divide-white/5"
        style="font-family:var(--font-sans);"></ul>
  </div>
</dialog>

<script>
  import { initFighterSearch } from '../lib/fighter-search.mjs';
  const header = document.getElementById('site-header') as HTMLElement;
  const toggle = document.getElementById('mobile-toggle') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLElement;
  const iconMenu = document.getElementById('icon-menu') as SVGElement;
  const iconClose = document.getElementById('icon-close') as SVGElement;

  // Hide on scroll down, show on scroll up
  let lastY = window.scrollY;
  const onScroll = () => {
    const y = window.scrollY;
    const isMenuOpen = !menu.classList.contains('hidden');
    if (isMenuOpen) { header.style.transform = 'translateY(0)'; lastY = y; return; }
    if (y > 80 && y > lastY) {
      header.style.transform = 'translateY(-100%)';
    } else {
      header.style.transform = 'translateY(0)';
    }
    lastY = y;
  };
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile toggle
  toggle.addEventListener('click', () => {
    menu.classList.toggle('hidden');
    iconMenu.classList.toggle('hidden');
    iconClose.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!menu.classList.contains('hidden')));
  });

  // ============ PELEADORES DROPDOWN ============
  const pelDrop = document.getElementById('pel-dropdown') as HTMLElement;
  if (pelDrop) {
    const btn = pelDrop.querySelector('button') as HTMLButtonElement;
    const pelMenu = pelDrop.querySelector('.pel-menu') as HTMLElement;
    let timeout: ReturnType<typeof setTimeout>;

    const show = () => { clearTimeout(timeout); pelMenu.classList.remove('hidden'); btn.setAttribute('aria-expanded', 'true'); };
    const hide = () => { timeout = setTimeout(() => { pelMenu.classList.add('hidden'); btn.setAttribute('aria-expanded', 'false'); }, 150); };

    pelDrop.addEventListener('mouseenter', show);
    pelDrop.addEventListener('mouseleave', hide);
    btn.addEventListener('click', () => pelMenu.classList.contains('hidden') ? show() : hide());
  }

  initFighterSearch();
</script>
