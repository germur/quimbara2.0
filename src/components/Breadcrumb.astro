---
// Breadcrumb navigation + BreadcrumbList JSON-LD schema
// Usage: <Breadcrumb items={[{name:'Inicio',href:'/'},{name:'Blog',href:'/blog'},{name:'Título'}]} variant="dark" />
export interface BreadcrumbItem {
  name: string;
  href?: string;
}
export interface Props {
  items: BreadcrumbItem[];
  variant?: 'light' | 'dark';
  class?: string;
}

const { items, variant = 'light', class: className = '' } = Astro.props;

const site = Astro.site?.href.replace(/\/$/, '') || Astro.url.origin;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((it, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": it.name,
    ...(it.href ? { "item": new URL(it.href, site).href } : {})
  }))
};

const isDark = variant === 'dark';
const textMuted = isDark ? 'text-white/60' : 'text-gray-500';
const textHover = isDark ? 'hover:text-white' : 'hover:text-[#E53935]';
const textActive = isDark ? 'text-white/90' : 'text-[#111]';
const sepColor = isDark ? 'text-white/30' : 'text-gray-300';
---

<nav aria-label="Migas de pan"
     class={`flex items-center gap-2 text-xs uppercase tracking-widest ${textMuted} ${className}`}
     style="font-family:var(--font-sans);">
  {items.map((it, i) => {
    const isLast = i === items.length - 1;
    return (
      <>
        {it.href && !isLast ? (
          <a href={it.href} class={`${textHover} transition-colors duration-200 truncate max-w-[200px]`}>{it.name}</a>
        ) : (
          <span class={`${isLast ? `${textActive} font-bold` : ''} truncate max-w-[280px]`} aria-current={isLast ? 'page' : undefined}>{it.name}</span>
        )}
        {!isLast && <span class={sepColor}>/</span>}
      </>
    );
  })}
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
