---
// Social sharing buttons + Giscus comments
// Usage: <ShareAndComment title={title} url={canonicalUrl} />
export interface Props {
  title: string;
  url: string;
  description?: string;
}

const { title, url, description = '' } = Astro.props;

const enc = (s: string) => encodeURIComponent(s);

const twitterUrl  = `https://twitter.com/intent/tweet?text=${enc(title)}&url=${enc(url)}&via=quimbaraufc`;
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`;
const whatsappUrl = `https://api.whatsapp.com/send?text=${enc(title + ' — ' + url)}`;
const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`;
const telegramUrl = `https://t.me/share/url?url=${enc(url)}&text=${enc(title)}`;
---

<section class="my-16 not-prose" style="font-family:var(--font-sans);">

  <!-- ── Share bar ── -->
  <div class="rounded-lg overflow-hidden border border-gray-200" style="background:#fafafa;">
    <div class="flex items-center gap-2 px-5 py-4 border-b border-gray-200" style="background:#111;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFD600" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="11.49"/>
      </svg>
      <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-white">Comparte este análisis</span>
    </div>

    <div class="flex flex-wrap gap-2 p-4">
      <!-- Twitter / X -->
      <a href={twitterUrl} target="_blank" rel="noopener noreferrer" aria-label="Compartir en X"
         class="share-btn group flex items-center gap-2 px-4 py-2.5 rounded-md border border-gray-200 bg-white hover:bg-[#111] hover:border-[#111] transition-all duration-200">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-[#111] group-hover:text-white transition-colors">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        <span class="text-xs font-bold text-[#111] group-hover:text-white">X</span>
      </a>

      <!-- Facebook -->
      <a href={facebookUrl} target="_blank" rel="noopener noreferrer" aria-label="Compartir en Facebook"
         class="share-btn group flex items-center gap-2 px-4 py-2.5 rounded-md border border-gray-200 bg-white hover:bg-[#1877F2] hover:border-[#1877F2] transition-all duration-200">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-[#1877F2] group-hover:text-white transition-colors">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
        <span class="text-xs font-bold text-[#111] group-hover:text-white">Facebook</span>
      </a>

      <!-- WhatsApp -->
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="Compartir en WhatsApp"
         class="share-btn group flex items-center gap-2 px-4 py-2.5 rounded-md border border-gray-200 bg-white hover:bg-[#25D366] hover:border-[#25D366] transition-all duration-200">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-[#25D366] group-hover:text-white transition-colors">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span class="text-xs font-bold text-[#111] group-hover:text-white">WhatsApp</span>
      </a>

      <!-- LinkedIn -->
      <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label="Compartir en LinkedIn"
         class="share-btn group flex items-center gap-2 px-4 py-2.5 rounded-md border border-gray-200 bg-white hover:bg-[#0A66C2] hover:border-[#0A66C2] transition-all duration-200">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-[#0A66C2] group-hover:text-white transition-colors">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        <span class="text-xs font-bold text-[#111] group-hover:text-white">LinkedIn</span>
      </a>

      <!-- Telegram -->
      <a href={telegramUrl} target="_blank" rel="noopener noreferrer" aria-label="Compartir en Telegram"
         class="share-btn group flex items-center gap-2 px-4 py-2.5 rounded-md border border-gray-200 bg-white hover:bg-[#26A5E4] hover:border-[#26A5E4] transition-all duration-200">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-[#26A5E4] group-hover:text-white transition-colors">
          <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
        </svg>
        <span class="text-xs font-bold text-[#111] group-hover:text-white">Telegram</span>
      </a>

      <!-- Copy link -->
      <button id="copy-link-btn" data-url={url} aria-label="Copiar enlace"
              class="share-btn group flex items-center gap-2 px-4 py-2.5 rounded-md border border-gray-200 bg-white hover:bg-[#FFD600] hover:border-[#FFD600] transition-all duration-200 cursor-pointer">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#111]">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
        </svg>
        <span id="copy-link-label" class="text-xs font-bold text-[#111]">Copiar enlace</span>
      </button>
    </div>
  </div>

  <!-- ── Comments (Cusdis custom UI) ── -->
  <div class="mt-12 pt-10 border-t-2 border-[#111]" id="comments-section">
    <div class="flex items-center gap-3 mb-2">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#E53935" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
      <h3 class="text-2xl text-[#111]" style="font-family:var(--font-display);">Conversación</h3>
      <span id="comments-count" class="text-xs font-bold text-gray-400 bg-gray-100 rounded-full px-2 py-0.5" style="font-family:var(--font-sans);"></span>
    </div>
    <p class="text-gray-400 text-sm mb-8" style="font-family:var(--font-sans);">Sin registro — solo tu nombre y tu opinión.</p>

    <!-- Lista de comentarios -->
    <div id="comments-list" class="flex flex-col gap-6 mb-10"></div>

    <!-- Formulario -->
    <div style="background:#fafafa; border:1px solid #e5e7eb; border-radius:12px; padding:24px;">
      <div style="font-family:var(--font-sans);font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:0.18em;color:#9ca3af;margin-bottom:16px;">Deja tu comentario</div>
      <form id="cusdis-form" class="flex flex-col gap-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="flex flex-col gap-1.5">
            <label style="font-family:var(--font-sans);font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:0.1em;">Nombre *</label>
            <input id="c-name" type="text" required placeholder="Tu nombre"
                   class="px-3 py-2.5 rounded-lg border border-gray-200 bg-white text-[#111] text-sm focus:outline-none focus:border-[#E53935] transition-colors"
                   style="font-family:var(--font-sans);" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label style="font-family:var(--font-sans);font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:0.1em;">Email <span class="text-gray-400 normal-case">(opcional, privado)</span></label>
            <input id="c-email" type="email" placeholder="tu@email.com"
                   class="px-3 py-2.5 rounded-lg border border-gray-200 bg-white text-[#111] text-sm focus:outline-none focus:border-[#E53935] transition-colors"
                   style="font-family:var(--font-sans);" />
          </div>
        </div>
        <div class="flex flex-col gap-1.5">
          <label style="font-family:var(--font-sans);font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:0.1em;">Comentario *</label>
          <textarea id="c-content" required rows="4" placeholder="¿Qué piensas sobre este análisis?"
                    class="px-3 py-2.5 rounded-lg border border-gray-200 bg-white text-[#111] text-sm focus:outline-none focus:border-[#E53935] transition-colors resize-none"
                    style="font-family:var(--font-sans);"></textarea>
        </div>
        <div class="flex items-center justify-between flex-wrap gap-3">
          <p id="c-msg" class="text-sm hidden" style="font-family:var(--font-sans);"></p>
          <button type="submit" id="c-submit"
                  class="ml-auto px-6 py-2.5 rounded-lg bg-[#111] hover:bg-[#E53935] text-white text-xs font-bold uppercase tracking-widest transition-colors duration-200"
                  style="font-family:var(--font-sans);">
            Enviar comentario →
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  // Copy-to-clipboard
  const btn = document.getElementById('copy-link-btn') as HTMLButtonElement | null;
  const lbl = document.getElementById('copy-link-label');
  if (btn && lbl) {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-url') || window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        const original = lbl.textContent;
        lbl.textContent = '¡Copiado!';
        btn.classList.add('bg-[#FFD600]', 'border-[#FFD600]');
        setTimeout(() => {
          lbl.textContent = original;
          btn.classList.remove('bg-[#FFD600]', 'border-[#FFD600]');
        }, 1800);
      } catch (e) {
        console.error('No se pudo copiar', e);
      }
    });
  }

  // ── Cusdis custom UI ──
  const APP_ID  = '4728860a-1a7d-4b78-b594-8ec1d372ca91';
  const PAGE_ID = window.location.pathname;
  const PAGE_URL   = window.location.href;
  const PAGE_TITLE = document.title;
  const API    = 'https://cusdis.com/api/open/comments';

  const list    = document.getElementById('comments-list');
  const count   = document.getElementById('comments-count');
  const form    = document.getElementById('cusdis-form') as HTMLFormElement | null;
  const msgEl   = document.getElementById('c-msg');
  const submitBtn = document.getElementById('c-submit') as HTMLButtonElement | null;

  // Render one comment card
  function renderComment(c: any, isReply = false) {
    const initials = (c.by_nickname || '?').slice(0, 2).toUpperCase();
    const date = new Date(c.createdAt).toLocaleDateString('es-ES', { day:'numeric', month:'long', year:'numeric' });
    const div = document.createElement('div');
    div.style.cssText = isReply
      ? 'margin-left:48px; margin-top:12px;'
      : '';
    div.innerHTML = `
      <div style="display:flex;align-items:flex-start;gap:12px;">
        <div style="width:36px;height:36px;border-radius:50%;background:#111;display:flex;align-items:center;justify-content:center;font-family:var(--font-sans);font-size:12px;font-weight:900;color:#fff;flex-shrink:0;">
          ${initials}
        </div>
        <div style="flex:1;min-width:0;">
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:6px;">
            <span style="font-family:var(--font-sans);font-size:13px;font-weight:700;color:#111;">${c.by_nickname || 'Anónimo'}</span>
            <span style="font-family:var(--font-sans);font-size:11px;color:#9ca3af;">${date}</span>
          </div>
          <p style="font-family:var(--font-sans);font-size:14px;color:#374151;line-height:1.65;margin:0;">${c.content}</p>
        </div>
      </div>
    `;
    return div;
  }

  // Load comments
  async function loadComments() {
    try {
      const res = await fetch(`${API}?appId=${APP_ID}&pageId=${encodeURIComponent(PAGE_ID)}`);
      if (!res.ok) return;
      const data = await res.json();
      const comments = data.data?.data ?? [];
      if (!list) return;
      list.innerHTML = '';
      if (comments.length === 0) {
        list.innerHTML = `<p style="font-family:var(--font-sans);font-size:14px;color:#9ca3af;">Sé el primero en comentar.</p>`;
      } else {
        comments.forEach((c: any) => {
          list.appendChild(renderComment(c));
          (c.replies ?? []).forEach((r: any) => list.appendChild(renderComment(r, true)));
        });
      }
      if (count) count.textContent = comments.length > 0 ? `${comments.length}` : '';
    } catch (e) {
      console.error('Cusdis load error', e);
    }
  }

  // Submit comment
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const nickname = (document.getElementById('c-name') as HTMLInputElement)?.value.trim();
      const email    = (document.getElementById('c-email') as HTMLInputElement)?.value.trim();
      const content  = (document.getElementById('c-content') as HTMLTextAreaElement)?.value.trim();
      if (!nickname || !content) return;

      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Enviando…'; }

      try {
        const res = await fetch(API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ appId: APP_ID, pageId: PAGE_ID, pageUrl: PAGE_URL, pageTitle: PAGE_TITLE, nickname, email, content })
        });
        if (res.ok) {
          if (msgEl) {
            msgEl.textContent = '✓ Comentario enviado — aparecerá tras revisión.';
            msgEl.style.color = '#16a34a';
            msgEl.classList.remove('hidden');
          }
          form.reset();
        } else {
          throw new Error('Error ' + res.status);
        }
      } catch (err) {
        if (msgEl) {
          msgEl.textContent = 'Error al enviar. Inténtalo de nuevo.';
          msgEl.style.color = '#E53935';
          msgEl.classList.remove('hidden');
        }
      } finally {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Enviar comentario →'; }
      }
    });
  }

  loadComments();
</script>
