---
// Ecuación visual para artículo La Ecuación del Octágono
---
<div class="my-10 border border-zinc-800 rounded-xl overflow-hidden grid grid-cols-1 md:grid-cols-2 shadow-lg shadow-black/50">
  <div class="bg-zinc-950 p-8 flex flex-col justify-center relative">
    <div class="text-xs uppercase tracking-widest text-red-500 mb-6 font-mono font-bold relative z-10">Ecuación de estabilidad</div>
    
    <div class="text-5xl font-black text-white relative z-10 flex items-center mb-8">
      S = 
      <div class="inline-flex flex-col items-center mx-3">
        <div class="border-b-4 border-red-500 pb-1 text-3xl">w · b</div>
        <div class="pt-1 text-3xl">h</div>
      </div>
    </div>
    
    <div class="relative z-10 space-y-4">
      <div class="flex items-baseline">
        <span class="italic text-xl font-black text-red-500 w-8 shrink-0">w</span>
        <span class="text-sm text-zinc-400">Desplazamiento del torso (fuera de línea)</span>
      </div>
      <div class="flex items-baseline">
        <span class="italic text-xl font-black text-red-500 w-8 shrink-0">b</span>
        <span class="text-sm text-zinc-400">Amplitud del anclaje (sprawl o pivote)</span>
      </div>
      <div class="flex items-baseline">
        <span class="italic text-xl font-black text-red-500 w-8 shrink-0">h</span>
        <span class="text-sm text-zinc-400">Reducción de altura (bloqueo CG rival)</span>
      </div>
    </div>
  </div>
  
  <div class="bg-zinc-900 p-8 flex items-center justify-center border-t md:border-t-0 md:border-l border-zinc-800 relative overflow-hidden">
    <!-- SVG simplified -->
    <svg viewBox="0 0 360 320" class="w-full max-w-[300px] h-auto relative z-10">
      <!-- Ground line -->
      <line x1="20" y1="280" x2="340" y2="280" stroke="rgba(255,255,255,0.1)" stroke-width="2"/>
      <!-- Defender (sprawled) base -->
      <ellipse cx="180" cy="260" rx="90" ry="12" fill="none" stroke="#2563eb" stroke-width="2" stroke-dasharray="4,4" opacity="0.8"/>
      <text x="180" y="300" fill="rgba(255,255,255,0.4)" font-family="monospace" font-size="10" text-anchor="middle" letter-spacing="0.1em">BASE (b)</text>

      <!-- Defender body -->
      <line x1="180" y1="260" x2="160" y2="170" stroke="#2563eb" stroke-width="4" stroke-linecap="round"/>
      <circle cx="155" cy="160" r="14" fill="none" stroke="#2563eb" stroke-width="3"/>
      
      <!-- w marker -->
      <circle cx="170" cy="210" r="6" fill="#dc2626"/>
      <line x1="170" y1="210" x2="170" y2="260" stroke="#dc2626" stroke-width="2" stroke-dasharray="4,4"/>
      <text x="190" y="215" fill="#dc2626" font-family="monospace" font-size="14" font-weight="bold">w</text>
      
      <!-- h marker -->
      <line x1="310" y1="170" x2="310" y2="260" stroke="#d97706" stroke-width="2"/>
      <line x1="300" y1="170" x2="320" y2="170" stroke="#d97706" stroke-width="2"/>
      <line x1="300" y1="260" x2="320" y2="260" stroke="#d97706" stroke-width="2"/>
      <text x="330" y="220" fill="#d97706" font-family="monospace" font-size="14" font-weight="bold">h</text>
      
      <!-- Attacker -->
      <line x1="70" y1="240" x2="120" y2="200" stroke="rgba(255,255,255,0.3)" stroke-width="4" stroke-linecap="round"/>
      <circle cx="60" cy="250" r="12" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="2"/>
      <polygon points="135,215 125,205 128,220" fill="rgba(255,255,255,0.4)"/>
    </svg>
  </div>
</div>
