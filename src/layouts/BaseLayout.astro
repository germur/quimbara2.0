---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NextEventWidget from '../components/NextEventWidget.astro';
import SpiralCursor from '../components/SpiralCursor.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishDate?: Date;
  updateDate?: Date;
  noIndex?: boolean;
  schema?: string;
}

const {
  title = "Quimbara",
  description = "La verdad del octágono. Sin clickbait.",
  canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href,
  ogType = 'website',
  ogImage = '/default-og.jpg',
  publishDate,
  updateDate,
  noIndex = false,
  schema,
} = Astro.props;

// Evitar duplicado "— Quimbara — Quimbara" si el title ya lo incluye
const siteTitle = (title === "Quimbara" || /[—\-]\s*Quimbara\s*$/i.test(title))
  ? title
  : `${title} — Quimbara`;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0A0A0B" />

    <!-- SEO core -->
    <title>{siteTitle}</title>
    <meta name="google-site-verification" content="PFQme-j2XJuDOdwfPhspuPJjeY1R7tkOg4T9kG4buIs" />
    <!-- Impact affiliate verification -->
    <meta name="impact-site-verification" value="72b035a0-5ffa-43b1-a490-a60754f4d6b0" />
    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9760938521576702" crossorigin="anonymous"></script>
    <!-- Google Analytics 4 (cargado en Web Worker via Partytown — no bloquea main thread) -->
    <script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-R7860CSDRW"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-R7860CSDRW');
    </script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noIndex ? "noindex, follow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />

    <!-- Open Graph -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? Astro.url.origin).href} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Quimbara" />
    <meta property="og:locale" content="es_ES" />
    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
    {updateDate && <meta property="article:modified_time" content={updateDate.toISOString()} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@quimbara_mma" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? Astro.url.origin).href} />

    <!-- Google Fonts: Big Shoulders Display + Manrope + Newsreader + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;900&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@400;500;700&family=Newsreader:ital,wght@0,400;0,600;1,600&display=swap" rel="stylesheet" />

    <!-- Schema.org JSON-LD -->
    {schema && <script type="application/ld+json" set:html={schema} />}
  </head>
  <body class="bg-[var(--color-paper)] text-[var(--color-ink)] min-h-screen flex flex-col selection:bg-[var(--color-acid)]/20 selection:text-[var(--color-ink)]">
    <slot name="progress-bar" />
    <Header />
    <!-- pt-16 = altura del header fijo -->
    <main class="flex-grow w-full pt-16 content-area">
      <slot />
    </main>
    <NextEventWidget />
    <Footer />
    <SpiralCursor />

    <!-- ── Wave wordmark animator ──────────────────────────────────
         Da vida a TODOS los .qb-wordmark de la página:
           · Sine wave continuo (la palabra "respira")
           · Boost de amplitud con scroll velocity
           · Boost local cuando el cursor se acerca a la wordmark
           · Respeta prefers-reduced-motion (no anima, deja estático)
    ───────────────────────────────────────────────────────────── -->
    <script is:inline>
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return; // keep static CSS offsets

        const marks = Array.from(document.querySelectorAll('.qb-wordmark'));
        if (!marks.length) return;

        // Per-mark state cache
        const cache = marks.map(m => {
          const spans = Array.from(m.querySelectorAll(':scope > span'));
          return { el: m, spans, rect: m.getBoundingClientRect() };
        });

        // Ambient state
        let cursorX = -9999, cursorY = -9999;
        let scrollVel = 0;
        let lastScrollY = window.scrollY;
        let lastScrollT = performance.now();

        window.addEventListener('mousemove', (e) => {
          cursorX = e.clientX;
          cursorY = e.clientY;
        }, { passive: true });

        window.addEventListener('scroll', () => {
          const now = performance.now();
          const dy = window.scrollY - lastScrollY;
          const dt = Math.max(1, now - lastScrollT);
          // Smooth: lerp toward target velocity
          scrollVel = scrollVel * 0.7 + Math.min(3, Math.abs(dy / dt) * 12) * 0.3;
          lastScrollY = window.scrollY;
          lastScrollT = now;
        }, { passive: true });

        window.addEventListener('resize', () => {
          cache.forEach(c => { c.rect = c.el.getBoundingClientRect(); });
        });

        // Recompute rects on scroll (rare, throttled via rAF anyway)
        let rectTick = 0;
        const refreshRects = () => {
          if (++rectTick % 30 === 0) cache.forEach(c => { c.rect = c.el.getBoundingClientRect(); });
        };

        const start = performance.now();
        const tick = () => {
          const t = (performance.now() - start) / 1000;

          // Continuous decay of scroll velocity so it relaxes when you stop
          scrollVel *= 0.92;

          cache.forEach(({ spans, rect }) => {
            // Distance from cursor to wordmark center, normalized
            const cx = rect.left + rect.width / 2;
            const cy = rect.top + rect.height / 2;
            const dx = cursorX - cx;
            const dy = cursorY - cy;
            const dist = Math.sqrt(dx * dx + dy * dy);
            // Proximity factor: 1 when cursor is on the mark, 0 when far (~300px)
            const proximity = Math.max(0, 1 - dist / 300);

            // Base amplitude (%) + boosts
            const amp = 8 + scrollVel * 4 + proximity * 6;
            // Wave speed
            const speed = 1.4 + proximity * 1.2;

            spans.forEach((s, i) => {
              // Phase per letter — gives the running-wave look
              const phase = i * 0.55;
              const dyPct = Math.sin(t * speed + phase) * amp;
              s.style.setProperty('--dy', dyPct.toFixed(2) + '%');
            });
          });

          refreshRects();
          requestAnimationFrame(tick);
        };

        requestAnimationFrame(tick);
      })();
    </script>
  </body>
</html>
