---
import '../styles/global.css';
import '../styles/fonts.css';
import displayFont from '@fontsource-variable/big-shoulders-display/files/big-shoulders-display-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NextEventWidget from '../components/NextEventWidget.astro';
import SpiralCursor from '../components/SpiralCursor.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishDate?: Date;
  updateDate?: Date;
  noIndex?: boolean;
  schema?: string;
}

const {
  title = "Quimbara",
  description = "La verdad del octágono. Sin clickbait.",
  canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href,
  ogType = 'website',
  ogImage = '/default-og.jpg',
  publishDate,
  updateDate,
  noIndex = false,
  schema,
} = Astro.props;

// Evitar duplicado "— Quimbara — Quimbara" si el title ya lo incluye
const siteTitle = (title === "Quimbara" || /[—\-]\s*Quimbara\s*$/i.test(title))
  ? title
  : `${title} — Quimbara`;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Google Tag Manager: GA4 y Clarity se administran en Calvo Creativo / quimbara.org. -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-TQMWKD2C');
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0A0A0B" />

    <!-- SEO core -->
    <title>{siteTitle}</title>
    <meta name="google-site-verification" content="PFQme-j2XJuDOdwfPhspuPJjeY1R7tkOg4T9kG4buIs" />
    <!-- Impact affiliate verification -->
    <meta name="impact-site-verification" value="72b035a0-5ffa-43b1-a490-a60754f4d6b0" />
    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9760938521576702" crossorigin="anonymous"></script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noIndex ? "noindex, follow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />

    <!-- Open Graph -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? Astro.url.origin).href} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Quimbara" />
    <meta property="og:locale" content="es_ES" />
    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
    {updateDate && <meta property="article:modified_time" content={updateDate.toISOString()} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@quimbara_mma" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? Astro.url.origin).href} />

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

    <!-- Schema.org JSON-LD -->
    {schema && <script type="application/ld+json" set:html={schema} />}
  </head>
  <body class="bg-[var(--color-paper)] text-[var(--color-ink)] min-h-screen flex flex-col selection:bg-[var(--color-acid)]/20 selection:text-[var(--color-ink)]">
    <!-- Google Tag Manager (noscript): mantener al inicio del body para verificación. -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TQMWKD2C" height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
    <slot name="progress-bar" />
    <Header />
    <!-- pt-16 = altura del header fijo -->
    <main class="flex-grow w-full pt-16 content-area">
      <slot />
    </main>
    <NextEventWidget />
    <Footer />
    <SpiralCursor />

    <script>
      import { initWordmarkMotion } from '../lib/wordmark-motion.mjs';
      initWordmarkMotion();
    </script>
  </body>
</html>
