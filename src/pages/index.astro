---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Ticker from '../components/Ticker.astro';
import OctagonScene from '../components/OctagonScene.astro';
import EVENTS from '../data/events.json';
import VIDEOS from '../data/videos.json';
import FIGHTERS from '../data/fighters.json';
import RESULTS from '../data/results.json';

const allPosts = await getCollection('blog');
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const heroArticles = allPosts.slice(0, 3);
const latestArticles = allPosts.slice(3);

const PX = "clamp(16px,4vw,60px)";

const siteUrl = 'https://quimbara.org';

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Quimbara",
  "url": siteUrl,
  "description": "Blog de MMA y UFC en español. Noticias, análisis de peleas, perfiles de peleadores y eventos UFC.",
  "inLanguage": "es",
  "potentialAction": {
    "@type": "SearchAction",
    "target": { "@type": "EntryPoint", "urlTemplate": `${siteUrl}/blog?q={search_term_string}` },
    "query-input": "required name=search_term_string"
  }
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Quimbara",
  "url": siteUrl,
  "logo": { "@type": "ImageObject", "url": `${siteUrl}/favicon.svg` },
  "sameAs": [],
  "description": "Blog editorial de MMA y UFC en español. Análisis técnico, resultados y perfiles de peleadores.",
  "foundingDate": "2024",
  "knowsAbout": ["MMA", "UFC", "Artes Marciales Mixtas", "Jiu-Jitsu", "Muay Thai", "Wrestling", "Boxeo"]
};

const homeSchema = `[${JSON.stringify(websiteSchema)}, ${JSON.stringify(organizationSchema)}]`;
---

<BaseLayout
  title="Quimbara · MMA y UFC en Español"
  description="La verdad del octágono. Noticias, análisis, perfiles de peleadores y próximos eventos UFC en español. Sin clickbait."
  schema={homeSchema}
>
  <!-- ── Ticker ── -->
  <Ticker />

  <!-- ── Hero editorial con octágono 3D ── -->
  <div class="relative overflow-hidden" style={`background:#0A0A0B; padding: 60px ${PX} 50px; min-height: 380px;`}>
    <OctagonScene />
    <div class="relative z-10" style="max-width:1400px; margin:0 auto;">
      <span class="inline-block px-3 py-1 text-[11px] font-bold uppercase tracking-widest rounded-sm bg-[#F2D928] text-[#0A0A0B] mb-5"
            style="font-family:var(--font-mono);">MMA · UFC · Español</span>
      <h1 class="qb-wordmark" style="font-size:clamp(2.8rem,9vw,6.5rem);color:#F4F2EC;margin:0;">
        <span>Q</span><span>U</span><span>I</span><span>M</span><span>B</span><span>A</span><span>R</span><span>A</span>
      </h1>
      <p class="text-gray-400 mt-4 text-sm md:text-base max-w-2xl" style="font-family:var(--font-serif);font-style:italic;">
        La verdad del octágono. Análisis técnico, perfiles de peleadores y cobertura de eventos UFC. Sin clickbait.
      </p>
    </div>
  </div>

  <!-- ── Hero grid 3-up ── -->
  <section style={`max-width:1400px; margin: 40px auto 0; padding: 0 ${PX};`}>
    <div class="hero-grid">
      {heroArticles[0] && (
        <div class="hero-main-cell">
          <ArticleCard article={heroArticles[0]} variant="hero-main" />
        </div>
      )}
      {heroArticles[1] && (
        <div class="h-full">
          <ArticleCard article={heroArticles[1]} variant="hero-side" />
        </div>
      )}
      {heroArticles[2] && (
        <div class="h-full">
          <ArticleCard article={heroArticles[2]} variant="hero-side" />
        </div>
      )}
    </div>
  </section>

  <!-- ── Próximos Eventos ── -->
  <section style={`max-width:1400px; margin:0 auto; padding: 50px ${PX};`}>
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-2xl md:text-4xl" style="font-family: var(--font-display);">Próximos Eventos</h2>
      <a href="/eventos" class="text-sm text-gray-500 font-medium hover:text-[#111] transition-colors" style="font-family: var(--font-sans);">Calendario →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      {EVENTS.map(e => (
        <a href={`/eventos/${e.slug}`} class="block rounded-md" style="text-decoration:none;">
          <div class="relative overflow-hidden rounded-md"
               style={`background: ${e.bg}; color: ${e.color}; min-height: 180px; display:flex; flex-direction:column; justify-content:space-between;`}>

            {/* Fighter photos */}
            {e.f1img && (
              <img src={e.f1img} alt=""
                   aria-hidden="true"
                   class="absolute bottom-0 left-0 h-[75%] w-auto object-contain object-bottom pointer-events-none select-none"
                   style="filter: drop-shadow(2px 0 6px rgba(0,0,0,0.2)); z-index:1;"
                   loading="eager" />
            )}
            {e.f2img && (
              <img src={e.f2img} alt=""
                   aria-hidden="true"
                   class="absolute bottom-0 right-0 h-[75%] w-auto object-contain object-bottom pointer-events-none select-none"
                   style="filter: drop-shadow(-2px 0 6px rgba(0,0,0,0.2)); transform:scaleX(-1); z-index:1;"
                   loading="eager" />
            )}

            {/* Content */}
            <div style="position:relative;z-index:3;padding:clamp(20px,3vw,32px);padding-bottom:0;">
              <div class="text-xs font-bold tracking-widest uppercase mb-1" style={`opacity:0.7;font-family:var(--font-sans);color:${e.color};`}>{e.dateLabel}</div>
              <h3 class="text-3xl md:text-4xl" style={`font-family:var(--font-display);color:${e.color};`}>{e.name}</h3>
            </div>
            <div style="position:relative;z-index:3;padding:clamp(20px,3vw,32px);padding-top:0;">
              <div class="text-lg md:text-xl font-bold italic" style={`font-family:var(--font-serif);color:${e.color};`}>{e.main}</div>
              <div class="text-xs mt-1" style={`opacity:0.6;font-family:var(--font-sans);color:${e.color};`}>{e.loc}</div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ── Últimos Artículos ── -->
  {latestArticles.length > 0 && (
    <section style={`max-width:1400px; margin:0 auto; padding: 0 ${PX} 50px;`}>
      <h2 class="text-2xl md:text-4xl mb-6" style="font-family:var(--font-display);">Últimos Artículos</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {latestArticles.map(a => <ArticleCard article={a} variant="default" />)}
      </div>
    </section>
  )}

  <!-- ── Video Highlights ── -->
  <section style={`max-width:1400px; margin:0 auto; padding: 10px ${PX} 50px;`}>
    <h2 class="text-2xl md:text-4xl mb-6" style="font-family:var(--font-display);">Videos Recomendados por Quimbara</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {VIDEOS.map(v => (
        <a href={v.url} target="_blank" rel="noopener noreferrer"
           class="group block transition-transform duration-200 hover:-translate-y-1">
          <div class="relative rounded-md overflow-hidden bg-gray-900" style="aspect-ratio:16/9;">
            <img
              src={`https://img.youtube.com/vi/${v.id}/maxresdefault.jpg`}
              alt={v.title}
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
              loading="lazy"
              onerror={`this.src='https://img.youtube.com/vi/${v.id}/hqdefault.jpg'`}
            />
            <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors duration-200 flex items-center justify-center">
              <div class="w-14 h-14 rounded-full bg-[#F2D928] flex items-center justify-center shadow-lg transition-transform duration-200 group-hover:scale-110">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><polygon points="6,3 20,12 6,21"/></svg>
              </div>
            </div>
          </div>
          <h3 class="text-[#111] text-base leading-tight mt-3 group-hover:text-[#F2D928] transition-colors duration-200"
              style="font-family:var(--font-display);">{v.title}</h3>
        </a>
      ))}
    </div>
  </section>

  <!-- ── Fighter Rankings ── -->
  <section style={`max-width:1400px; margin:0 auto; padding: 10px ${PX} 50px;`}>
    <h2 class="text-2xl md:text-4xl mb-6" style="font-family:var(--font-display);">Fighter Rankings</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
      {FIGHTERS.filter(f => f.rank === 'C').map(f => (
        <a href={`/peleadores/${f.slug}`} class="bg-gray-50 rounded-md overflow-hidden transition-all duration-200 hover:-translate-y-1 hover:shadow-lg relative block"
             style="padding: clamp(18px,2.5vw,24px);">
          <!-- Rango fantasma -->
          <div class="absolute select-none pointer-events-none top-[-10px] right-2 opacity-5 text-[#111]"
               style="font-family:var(--font-display);font-size:70px;line-height:1;">
            {f.rank === 'C' ? 'C' : `#${f.rank}`}
          </div>
          <div class="flex items-center gap-3">
            <!-- Avatar: imagen si existe, iniciales si no -->
            <div class="rounded-full overflow-hidden flex-shrink-0 border-2 border-gray-200 flex items-center justify-center bg-gray-200" style="width:52px;height:52px;">
              {f.img ? (
                <img src={f.img} alt={f.name} class="w-full h-full object-cover" loading="lazy" />
              ) : (
                <span class="text-gray-500 font-black text-sm select-none" style="font-family:var(--font-display);">
                  {f.name.split(' ').slice(0,2).map((n: string) => n[0]).join('')}
                </span>
              )}
            </div>
            <div>
              <div class="text-[#111] text-base leading-tight" style="font-family:var(--font-display);">{f.name}</div>
              {f.nick && (
                <div class="text-gray-500 text-sm italic" style="font-family:var(--font-sans);">"{f.nick}"</div>
              )}
            </div>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mt-4 pt-3 border-t border-gray-200" style="font-family:var(--font-sans);">
            <div class="min-w-0">
              <div class="text-[10px] text-gray-400 uppercase tracking-widest font-bold">División</div>
              <div class="font-semibold text-xs mt-1 text-[#111] leading-tight">{f.div}</div>
            </div>
            <div class="min-w-0">
              <div class="text-[10px] text-gray-400 uppercase tracking-widest font-bold">Récord</div>
              <div class="text-sm mt-1 font-bold text-[#111]" style="font-family:var(--font-display);">{f.rec}</div>
            </div>
            <div class="min-w-0 hidden md:block">
              <div class="text-[10px] text-gray-400 uppercase tracking-widest font-bold">País</div>
              <div class="font-semibold text-xs mt-1 text-[#111] leading-tight">{f.from}</div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ── Resultados Recientes ── -->
  <section class="bg-[#111]" style={`padding: 50px ${PX};`}>
    <div style="max-width:1400px; margin:0 auto;">
      <h2 class="text-white text-2xl md:text-4xl mb-7" style="font-family:var(--font-display);">Resultados Recientes</h2>
      <div class="flex flex-col gap-[2px]">
        {RESULTS.map(r => (
          <div class="flex flex-wrap items-center gap-4 md:gap-5 px-4 md:px-5 py-3 md:py-4 rounded-sm cursor-pointer transition-colors duration-200"
               style="background:rgba(255,255,255,0.04);"
               onmouseenter="this.style.background='rgba(255,255,255,0.08)'"
               onmouseleave="this.style.background='rgba(255,255,255,0.04)'">
            <div class="flex-1 text-right" style="font-family:var(--font-display);font-size:clamp(14px,1.5vw,18px);">
              <span style="color:#F2D928;">W</span>
              <span class="text-white ml-1">{r.w}</span>
            </div>
            <div class="text-gray-500 text-xs font-bold" style="font-family:var(--font-sans);">DEF.</div>
            <div class="flex-1 text-white/50" style="font-family:var(--font-display);font-size:clamp(14px,1.5vw,18px);">{r.l}</div>
            <div class="text-gray-500 text-xs hidden md:block" style="font-family:var(--font-sans);">{r.method} · R{r.round} {r.time}</div>
            <div class="text-[#F2D928] text-xs font-bold hidden md:block" style="font-family:var(--font-sans);">{r.event}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: 1fr;
    grid-template-rows: 280px 200px 200px;
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.4fr 1fr;
      grid-template-rows: 340px 340px;
    }
    .hero-main-cell {
      grid-row: 1 / 3;
    }
  }
</style>
