---
import BaseLayout from '../layouts/BaseLayout.astro';
const PX = 'clamp(16px,4vw,60px)';
---

<BaseLayout title="404 — Página no encontrada" description="Esta página no existe o fue movida.">
  <div style={`max-width:800px; margin:0 auto; padding: 80px ${PX} 100px; text-align:center;`}>

    <!-- Número grande decorativo -->
    <div class="select-none text-[#111] opacity-[0.04] leading-none"
         style="font-family:var(--font-display);font-size:clamp(160px,30vw,280px);">
      404
    </div>

    <div style="margin-top:-60px; position:relative;">
      <span class="inline-block px-3 py-1 text-[11px] font-bold uppercase tracking-widest rounded-sm bg-[#F2D928] text-[#0A0A0B] mb-6"
            style="font-family:var(--font-sans);">
        Error
      </span>

      <h1 class="text-[#111]" style="font-family:var(--font-display);font-size:clamp(2rem,6vw,3.5rem);line-height:1.05;">
        Te hicieron un derribo
      </h1>

      <p class="text-gray-500 mt-4 mb-10 text-base leading-relaxed max-w-md mx-auto"
         style="font-family:var(--font-sans);">
        Esta página no existe, fue movida a otra división o escribiste mal el enlace.
        El árbitro detuvo el combate.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="btn-primary">← Volver al inicio</a>
        <a href="/blog"
           class="px-5 py-3 text-sm font-semibold uppercase tracking-widest text-[#111] border-2 border-[#111] rounded-sm transition-all duration-200 hover:bg-[#111] hover:text-white"
           style="font-family:var(--font-sans);">
          Ver artículos
        </a>
      </div>
    </div>

  </div>
</BaseLayout>
