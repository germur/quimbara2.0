---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FIGHTERS from '../../data/fighters.json';

const PX = 'clamp(16px,4vw,60px)';
const siteUrl = 'https://quimbara.org';

const divOrder = [
  'Heavyweight', 'Light Heavyweight', 'Middleweight',
  'Welterweight', 'Lightweight', 'Featherweight',
  'Bantamweight', 'Flyweight',
];

const divLabels: Record<string, string> = {
  'Heavyweight':       'Peso Pesado',
  'Light Heavyweight': 'Semipesado',
  'Middleweight':      'Peso Medio',
  'Welterweight':      'Wélter',
  'Lightweight':       'Ligero',
  'Featherweight':     'Pluma',
  'Bantamweight':      'Gallo',
  'Flyweight':         'Mosca',
};

// Agrupar por división, orden: campeón primero, luego por rank
type Fighter = typeof FIGHTERS[number];
const byDiv: Record<string, Fighter[]> = {};
for (const f of FIGHTERS) {
  if (!byDiv[f.div]) byDiv[f.div] = [];
  byDiv[f.div].push(f);
}
for (const div of Object.keys(byDiv)) {
  byDiv[div].sort((a, b) => {
    if (a.rank === 'C') return -1;
    if (b.rank === 'C') return 1;
    return Number(a.rank) - Number(b.rank);
  });
}

const divisions = divOrder.filter(d => byDiv[d]?.length);

// Colores de forma
const WIN_BG: Record<string, string> = {
  KO: '#E53935', TKO: '#E53935', SUB: '#7B1FA2',
  UD: '#fff', SD: '#fff', MD: '#fff',
};
---

<BaseLayout
  title="Peleadores UFC 2026 · Campeones y Contenders por División"
  description="Directorio de peleadores UFC 2026 por división: campeones, top 5 contenders, récords y forma reciente. Todo en Quimbara."
  canonicalUrl={`${siteUrl}/peleador/`}
>

  <!-- ── Hero ── -->
  <div style={`background:#111; padding: 60px ${PX} 0;`}>
    <div style="max-width:1400px; margin:0 auto; padding-bottom:40px;">
      <span class="inline-block px-3 py-1 text-[11px] font-bold uppercase tracking-widest rounded-sm bg-[#FFD600] text-[#111] mb-5"
            style="font-family:var(--font-sans);">UFC 2026</span>
      <h1 style="font-family:var(--font-display);font-size:clamp(3rem,10vw,7rem);line-height:0.95;color:#fff;">
        Pelead<span style="color:#FFD600;">ores</span>
      </h1>
      <p class="text-gray-400 mt-4 text-sm" style="font-family:var(--font-sans);">
        {FIGHTERS.length} peleadores · Campeones + Top 5 por división
      </p>
    </div>

    <!-- Tabs de división -->
    <div style="max-width:1400px; margin:0 auto; overflow-x:auto;">
      <div class="flex gap-0 border-b border-gray-800" id="div-tabs" style="min-width:max-content;">
        {divisions.map((div, i) => (
          <button
            data-div={div}
            class:list={['div-tab px-4 py-3 text-[11px] font-bold uppercase tracking-widest transition-all duration-200 whitespace-nowrap border-b-2',
              i === 0
                ? 'text-[#FFD600] border-[#FFD600]'
                : 'text-gray-500 border-transparent hover:text-gray-300'
            ]}
            style="font-family:var(--font-sans);"
          >
            {divLabels[div] ?? div}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- ── Contenido por división ── -->
  <div style={`background:#111; padding: 0 ${PX} 80px;`}>
    <div style="max-width:1400px; margin:0 auto;">
      {divisions.map((div, divIdx) => (
        <div class="div-section pt-10" data-div={div} style={divIdx > 0 ? 'display:none;' : ''}>

          {byDiv[div].map((f, i) => {
            const isChamp = f.rank === 'C';
            const initials = f.name.split(' ').slice(0, 2).map((n: string) => n[0]).join('');
            const [wins, losses, draws] = f.rec !== '—'
              ? f.rec.split('-').map(Number)
              : [0, 0, 0];

            return isChamp ? (
              /* ── Card campeón — hero horizontal ── */
              <a href={`/peleador/${f.slug}`}
                 class="group flex flex-col md:flex-row gap-0 rounded-lg overflow-hidden mb-6 transition-all duration-300 hover:opacity-95"
                 style="background:#1a1a1a; min-height:260px;">

                {/* Foto */}
                <div class="relative md:w-72 flex-shrink-0" style="min-height:240px;">
                  {f.img ? (
                    <img src={f.img} alt={f.name}
                         class="w-full h-full object-cover object-top"
                         style="max-height:320px;" loading="eager" />
                  ) : (
                    <div class="w-full h-full bg-gray-800 flex items-center justify-center">
                      <span class="text-gray-600 text-5xl font-black" style="font-family:var(--font-display);">{initials}</span>
                    </div>
                  )}
                  <div class="absolute inset-0 md:hidden" style="background:linear-gradient(to top,#1a1a1a 0%,transparent 60%);"></div>
                </div>

                {/* Info */}
                <div class="flex flex-col justify-center p-6 md:p-8 flex-1">
                  <div class="flex items-center gap-3 mb-3 flex-wrap">
                    <span class="px-3 py-1 text-[10px] font-black uppercase tracking-widest rounded-sm bg-[#FFD600] text-[#111]"
                          style="font-family:var(--font-sans);">Campeón</span>
                    <span class="text-gray-500 text-[11px] uppercase tracking-widest"
                          style="font-family:var(--font-sans);">{divLabels[div] ?? div}</span>
                  </div>
                  <h2 class="text-white leading-none group-hover:text-[#FFD600] transition-colors duration-200"
                      style="font-family:var(--font-display);font-size:clamp(1.8rem,4vw,3rem);">{f.name}</h2>
                  {f.nick?.trim() && (
                    <div class="text-gray-500 text-base italic mt-1" style="font-family:var(--font-sans);">"{f.nick.trim()}"</div>
                  )}
                  <div class="flex items-center gap-8 mt-5 flex-wrap">
                    <div>
                      <div class="text-[9px] font-bold uppercase tracking-widest text-gray-600 mb-1" style="font-family:var(--font-sans);">Récord</div>
                      <div class="text-white font-black text-2xl" style="font-family:var(--font-display);">{f.rec}</div>
                    </div>
                    <div>
                      <div class="text-[9px] font-bold uppercase tracking-widest text-gray-600 mb-1" style="font-family:var(--font-sans);">País</div>
                      <div class="text-white text-sm font-semibold" style="font-family:var(--font-sans);">{f.from || '—'}</div>
                    </div>
                    {(f.formTypes ?? []).length > 0 && (
                      <div>
                        <div class="text-[9px] font-bold uppercase tracking-widest text-gray-600 mb-2" style="font-family:var(--font-sans);">Últimas peleas</div>
                        <div class="flex gap-1.5">
                          {(f.formTypes ?? []).slice(0, 5).map((ft: {outcome: string; winType: string}) => {
                            const isWin = ft.outcome === 'W';
                            const isLoss = ft.outcome === 'L';
                            const bg = isLoss ? '#1a1a1a' : (WIN_BG[ft.winType] ?? '#fff');
                            return (
                              <div class="w-7 h-7 rounded-full flex items-center justify-center text-[10px] font-black"
                                   style={`background:${bg}; color:${isLoss ? '#E53935' : '#111'}; border:1.5px solid ${isLoss ? '#E53935' : bg};`}>
                                {ft.outcome}
                              </div>
                            );
                          })}
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              </a>
            ) : (
              /* ── Fila contender — lista compacta ── */
              <a href={`/peleador/${f.slug}`}
                 class="group flex items-center gap-4 rounded-md px-4 py-3 mb-1 transition-all duration-200 hover:bg-white/5"
                 style="background:#161616;">

                {/* Rank */}
                <div class="text-gray-600 font-black text-sm w-5 text-center flex-shrink-0"
                     style="font-family:var(--font-display);">#{f.rank}</div>

                {/* Avatar */}
                <div class="w-10 h-10 rounded-full overflow-hidden flex-shrink-0 bg-gray-800 flex items-center justify-center">
                  {f.img ? (
                    <img src={f.img} alt={f.name} class="w-full h-full object-cover object-top" loading="lazy" />
                  ) : (
                    <span class="text-gray-600 text-xs font-black" style="font-family:var(--font-display);">{initials}</span>
                  )}
                </div>

                {/* Nombre */}
                <div class="flex-1 min-w-0">
                  <div class="text-white text-sm font-bold group-hover:text-[#FFD600] transition-colors duration-200 truncate"
                       style="font-family:var(--font-display);">{f.name}</div>
                  {f.nick?.trim() && (
                    <div class="text-gray-600 text-xs italic truncate" style="font-family:var(--font-sans);">"{f.nick.trim()}"</div>
                  )}
                </div>

                {/* País */}
                <div class="text-gray-500 text-xs hidden sm:block w-24 text-right"
                     style="font-family:var(--font-sans);">{f.from || ''}</div>

                {/* Récord */}
                <div class="text-white font-black text-sm w-16 text-right"
                     style="font-family:var(--font-display);">{f.rec}</div>

                {/* Forma */}
                <div class="hidden md:flex gap-1 flex-shrink-0">
                  {(f.formTypes ?? []).slice(0, 5).map((ft: {outcome: string; winType: string}) => {
                    const isWin = ft.outcome === 'W';
                    const isLoss = ft.outcome === 'L';
                    const bg = isLoss ? 'transparent' : (WIN_BG[ft.winType] ?? '#fff');
                    return (
                      <div class="w-5 h-5 rounded-full flex items-center justify-center text-[8px] font-black"
                           style={`background:${bg}; color:${isLoss ? '#E53935' : '#111'}; border:1px solid ${isLoss ? '#E53935' : bg};`}>
                        {ft.outcome}
                      </div>
                    );
                  })}
                </div>

                <div class="text-gray-600 group-hover:text-[#FFD600] text-xs font-bold transition-colors">→</div>
              </a>
            );
          })}
        </div>
      ))}
    </div>
  </div>

</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.div-tab');
  const sections = document.querySelectorAll<HTMLElement>('.div-section');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.div;

      tabs.forEach(t => {
        t.classList.remove('text-[#FFD600]', 'border-[#FFD600]');
        t.classList.add('text-gray-500', 'border-transparent');
      });
      tab.classList.add('text-[#FFD600]', 'border-[#FFD600]');
      tab.classList.remove('text-gray-500', 'border-transparent');

      sections.forEach(s => {
        s.style.display = s.dataset.div === target ? '' : 'none';
      });
    });
  });
</script>
