---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FIGHTERS from '../../data/fighters.json';

const PX = 'clamp(16px,4vw,60px)';
const siteUrl = 'https://quimbara.org';
---

<BaseLayout
  title="Campeones UFC 2026 · Perfiles y Récords"
  description="Perfiles completos de los campeones actuales de UFC: récord, datos físicos, forma reciente y análisis. Toda la info en Quimbara."
  canonicalUrl={`${siteUrl}/peleador/`}
>
  <!-- Hero -->
  <div style={`background:#111; padding: 70px ${PX} 60px;`}>
    <div style="max-width:1400px; margin:0 auto;">
      <span class="inline-block px-3 py-1 text-[11px] font-bold uppercase tracking-widest rounded-sm bg-[#FFD600] text-[#111] mb-6"
            style="font-family:var(--font-sans);">Campeones UFC</span>
      <h1 style="font-family:var(--font-display);font-size:clamp(3rem,10vw,7rem);line-height:0.95;color:#fff;">
        Pele<span style="color:#FFD600;">adores</span>
      </h1>
      <p class="text-gray-400 mt-5 text-sm" style="font-family:var(--font-sans);">
        {FIGHTERS.length} campeones · Perfiles, récords y forma reciente
      </p>
    </div>
  </div>

  <!-- Grid -->
  <div style={`max-width:1400px; margin:0 auto; padding: 60px ${PX};`}>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {FIGHTERS.map(f => {
        const initials = f.name.split(' ').slice(0, 2).map((n: string) => n[0]).join('');
        const [wins, losses, draws] = f.rec !== '—' ? f.rec.split('-').map(Number) : [0, 0, 0];
        return (
          <a href={`/peleador/${f.slug}`}
             class="group block bg-gray-50 rounded-lg overflow-hidden transition-all duration-200 hover:-translate-y-1 hover:shadow-xl relative"
             style="padding: clamp(20px,3vw,28px);">
            <!-- Rango fantasma -->
            <div class="absolute select-none pointer-events-none top-[-10px] right-2 opacity-5 text-[#111]"
                 style="font-family:var(--font-display);font-size:80px;line-height:1;">
              {f.rank === 'C' ? 'C' : `#${f.rank}`}
            </div>

            <div class="flex items-center gap-4 mb-4">
              <!-- Avatar -->
              <div class="rounded-full overflow-hidden flex-shrink-0 border-2 border-[#FFD600] flex items-center justify-center bg-gray-200"
                   style="width:60px;height:60px;">
                {f.img ? (
                  <img src={f.img} alt={f.name} class="w-full h-full object-cover" loading="lazy" />
                ) : (
                  <span class="text-gray-500 font-black text-base select-none"
                        style="font-family:var(--font-display);">{initials}</span>
                )}
              </div>
              <div>
                <div class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-1"
                     style="font-family:var(--font-sans);">{f.div}</div>
                <div class="text-[#111] text-lg leading-tight group-hover:text-[#111]"
                     style="font-family:var(--font-display);">{f.name}</div>
                {f.nick && (
                  <div class="text-gray-500 text-sm italic" style="font-family:var(--font-sans);">"{f.nick}"</div>
                )}
              </div>
            </div>

            <div class="grid grid-cols-3 gap-2 pt-3 border-t border-gray-200">
              <div>
                <div class="text-[9px] font-bold uppercase tracking-widest text-gray-400"
                     style="font-family:var(--font-sans);">Récord</div>
                <div class="text-base font-black text-[#111] mt-0.5"
                     style="font-family:var(--font-display);">{f.rec}</div>
              </div>
              <div>
                <div class="text-[9px] font-bold uppercase tracking-widest text-gray-400"
                     style="font-family:var(--font-sans);">País</div>
                <div class="text-sm font-semibold text-[#111] mt-0.5 leading-tight"
                     style="font-family:var(--font-sans);">{f.from || '—'}</div>
              </div>
              <div class="text-right">
                <div class="text-[9px] font-bold uppercase tracking-widest text-gray-400"
                     style="font-family:var(--font-sans);">Victorias</div>
                <div class="text-base font-black text-[#111] mt-0.5"
                     style="font-family:var(--font-display);">{wins}</div>
              </div>
            </div>

            <div class="mt-3 text-[#111] group-hover:text-[#FFD600] text-right text-sm font-bold transition-colors duration-200">→</div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
