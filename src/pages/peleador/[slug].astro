---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import FIGHTERS from '../../data/fighters.json';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return FIGHTERS.map((f) => ({ params: { slug: f.slug }, props: { fighter: f } }));
}

const { fighter: f } = Astro.props;
const PX = 'clamp(16px,4vw,60px)';

// Buscar artículos relacionados: nombre o apellido del peleador en título o descripción
const allPosts = await getCollection('blog');
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const lastName  = f.name.split(' ').slice(-1)[0].toLowerCase();
const firstName = f.name.split(' ')[0].toLowerCase();
const nick      = f.nick?.toLowerCase() ?? '';

const related = allPosts.filter(p => {
  const haystack = `${p.data.title} ${p.data.description ?? ''}`.toLowerCase();
  return haystack.includes(lastName) || haystack.includes(firstName) || (nick && haystack.includes(nick));
});

// Si hay relacionados los usamos; si no, los 3 más recientes como fallback
const hasRelated  = related.length > 0;
const articlesToShow = hasRelated ? related.slice(0, 3) : allPosts.slice(0, 3);

const initials = f.name.split(' ').slice(0, 2).map((n: string) => n[0]).join('');
const [wins, losses, draws] = f.rec !== '—' ? f.rec.split('-').map(Number) : [0, 0, 0];
const totalFights = wins + losses + (draws || 0);
const winPct = totalFights > 0 ? Math.round((wins / totalFights) * 100) : 0;

const physicals = [
  { label: 'Altura',  value: f.height,  icon: '↕' },
  { label: 'Peso',    value: f.weight,  icon: '⚖' },
  { label: 'Alcance', value: f.reach,   icon: '↔' },
  { label: 'Guardia', value: f.stance,  icon: '🥊' },
  { label: 'Gym',     value: f.team,    icon: '🏛' },
  { label: 'País',    value: f.from,    icon: '🌍' },
].filter(p => p.value);

const form: string[] = f.form ?? [];
const formTypes: { outcome: string; winType: string }[] = f.formTypes ?? [];

const WIN_TYPE_LABEL: Record<string, string> = {
  KO: 'KO', TKO: 'TKO', SUB: 'Sub', UD: 'Dec', SD: 'Dec', MD: 'Dec',
  DQ: 'DQ', NC: 'NC',
};
const WIN_TYPE_COLOR: Record<string, string> = {
  KO: '#E53935', TKO: '#E53935', SUB: '#7B1FA2',
  UD: '#1565C0', SD: '#1565C0', MD: '#1565C0',
  DQ: '#555', NC: '#555',
};

const siteUrl = 'https://quimbara.org';
const canonicalUrl = `${siteUrl}/peleador/${f.slug}/`;

// Schema Person (tripleta semántica: peleador → récord, división, nacionalidad)
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": f.name,
  "alternateName": f.nick || undefined,
  "url": canonicalUrl,
  "image": f.img ? new URL(f.img, siteUrl).href : undefined,
  "nationality": f.from || undefined,
  "height": f.height ? { "@type": "QuantitativeValue", "value": f.height } : undefined,
  "weight": f.weight ? { "@type": "QuantitativeValue", "value": f.weight } : undefined,
  "memberOf": {
    "@type": "SportsOrganization",
    "name": "UFC",
    "url": "https://www.ufc.com"
  },
  "award": `Campeón UFC ${f.div}`,
  "description": `${f.name}${f.nick ? ` "${f.nick}"` : ''} es el actual Campeón UFC ${f.div} con récord de ${f.rec}. ${f.from ? `De ${f.from}.` : ''} ${f.stance ? `Guardia ${f.stance}.` : ''} ${f.team ? `Equipo: ${f.team}.` : ''}`,
  "knowsAbout": ["MMA", "UFC", f.div, "Artes Marciales Mixtas"]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": f.name, "item": canonicalUrl }
  ]
};

const fighterSchema = `[${JSON.stringify(personSchema)}, ${JSON.stringify(breadcrumbSchema)}]`;

// Meta título y descripción optimizados con keywords del audit
const metaTitle = `${f.name}${f.nick ? ` "${f.nick}"` : ''} · Récord ${f.rec} · UFC ${f.div}`;
const metaDescription = `Perfil de ${f.name}, Campeón UFC ${f.div}. Récord ${f.rec}${f.height ? `, altura ${f.height}` : ''}${f.reach ? `, alcance ${f.reach}` : ''}. Forma reciente: ${form.slice(0,5).join('-') || 'n/d'}. Última pelea y datos completos en Quimbara.`;
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonicalUrl={canonicalUrl}
  ogImage={f.img || '/default-og.jpg'}
  schema={fighterSchema}
>

  <!-- ── Hero ── -->
  <div class="relative overflow-hidden" style="background:#111; min-height: 380px;">

    <!-- Inicial gigante de fondo -->
    <div class="absolute inset-0 flex items-end justify-end pointer-events-none select-none overflow-hidden">
      <span style="font-family:var(--font-display);font-size:clamp(200px,35vw,400px);opacity:0.04;color:#fff;line-height:0.85;margin-right:-20px;">
        {f.name.split(' ').slice(-1)[0]?.[0]}
      </span>
    </div>

    <div style={`max-width:1400px; margin:0 auto; padding: 50px ${PX} 50px; position:relative;`}>

      <!-- Nav -->
      <a href="/"
         class="text-gray-500 hover:text-[#FFD600] text-[11px] font-bold uppercase tracking-widest transition-colors mb-10 inline-block"
         style="font-family:var(--font-sans);">← Inicio</a>

      <div class="flex flex-col md:flex-row md:items-end gap-6 md:gap-10">

        <!-- Foto -->
        <div class="relative flex-shrink-0">
          <div class="rounded-2xl overflow-hidden border-4 border-[#FFD600] flex items-center justify-center bg-gray-800"
               style="width:clamp(90px,15vw,140px);height:clamp(90px,15vw,140px);">
            {f.img ? (
              <img src={f.img} alt={f.name} class="w-full h-full object-cover" />
            ) : (
              <span class="text-white font-black select-none"
                    style="font-family:var(--font-display);font-size:clamp(28px,5vw,48px);">{initials}</span>
            )}
          </div>
          <!-- Badge campeón -->
          <div class="absolute -bottom-2 -right-2 bg-[#FFD600] text-[#111] text-[9px] font-black uppercase tracking-widest px-2 py-1 rounded-md"
               style="font-family:var(--font-sans);">Campeón</div>
        </div>

        <!-- Nombre -->
        <div class="pb-1">
          <div class="inline-block px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest rounded-sm border border-gray-600 text-gray-400 mb-3"
               style="font-family:var(--font-sans);">{f.div}</div>
          <h1 class="text-white leading-none"
              style="font-family:var(--font-display);font-size:clamp(2.2rem,7vw,5rem);">
            {f.name}
          </h1>
          {f.nick && (
            <div class="text-[#FFD600] text-xl italic mt-2" style="font-family:var(--font-serif);">
              "{f.nick}"
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- ── Récord ── -->
  <div style="background:#FFD600;">
    <div style={`max-width:1400px; margin:0 auto; padding: 28px ${PX};`}>
      <div class="grid grid-cols-4 gap-4 items-center">
        <!-- Wins -->
        <div class="text-center">
          <div class="font-black text-[#111] leading-none"
               style="font-family:var(--font-display);font-size:clamp(2.5rem,8vw,5rem);">{wins}</div>
          <div class="text-[10px] font-bold uppercase tracking-widest text-[#111]/50 mt-1"
               style="font-family:var(--font-sans);">Victorias</div>
        </div>
        <!-- Losses -->
        <div class="text-center">
          <div class="font-black text-[#111] leading-none"
               style="font-family:var(--font-display);font-size:clamp(2.5rem,8vw,5rem);">{losses}</div>
          <div class="text-[10px] font-bold uppercase tracking-widest text-[#111]/50 mt-1"
               style="font-family:var(--font-sans);">Derrotas</div>
        </div>
        <!-- Draws -->
        <div class="text-center">
          <div class="font-black text-[#111] leading-none"
               style="font-family:var(--font-display);font-size:clamp(2.5rem,8vw,5rem);">{draws || 0}</div>
          <div class="text-[10px] font-bold uppercase tracking-widest text-[#111]/50 mt-1"
               style="font-family:var(--font-sans);">Empates</div>
        </div>
        <!-- Win % -->
        <div class="text-center border-l-2 border-[#111]/10 pl-4">
          <div class="font-black text-[#111] leading-none"
               style="font-family:var(--font-display);font-size:clamp(2.5rem,8vw,5rem);">{winPct}<span style="font-size:0.4em;">%</span></div>
          <div class="text-[10px] font-bold uppercase tracking-widest text-[#111]/50 mt-1"
               style="font-family:var(--font-sans);">Tasa victoria</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Datos físicos ── -->
  {physicals.length > 0 && (
    <section style={`max-width:1400px; margin:0 auto; padding: 50px ${PX} 60px;`}>
      <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-8"
          style="font-family:var(--font-sans);">Perfil atlético</h2>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-px bg-gray-100 rounded-xl overflow-hidden border border-gray-100">
        {physicals.map(({ label, value, icon }) => (
          <div class="bg-white px-6 py-5 group hover:bg-[#111] transition-colors duration-200">
            <div class="text-[10px] font-bold uppercase tracking-widest text-gray-400 group-hover:text-gray-600 mb-2"
                 style="font-family:var(--font-sans);">{label}</div>
            <div class="text-[#111] font-black text-xl group-hover:text-white leading-tight"
                 style="font-family:var(--font-display);">{value}</div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ── Forma reciente ── -->
  {form.length > 0 && (
    <section style={`max-width:1400px; margin:0 auto; padding: 0 ${PX} 60px;`}>
      <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-8"
          style="font-family:var(--font-sans);">Forma reciente</h2>

      <div class="flex gap-3 flex-wrap">
        {formTypes.slice(0, 5).map((ft, i) => {
          const isWin = ft.outcome === 'W';
          const label = WIN_TYPE_LABEL[ft.winType] ?? ft.winType;
          const color = isWin ? (WIN_TYPE_COLOR[ft.winType] ?? '#111') : '#9e9e9e';
          return (
            <div class="flex flex-col items-center gap-1">
              <div class="w-12 h-12 rounded-full flex items-center justify-center font-black text-white text-sm"
                   style={`background:${color}; font-family:var(--font-display);`}>
                {ft.outcome}
              </div>
              <span class="text-[9px] font-bold uppercase tracking-widest text-gray-400"
                    style="font-family:var(--font-sans);">{label}</span>
            </div>
          );
        })}
      </div>

      <p class="text-[10px] text-gray-400 mt-4" style="font-family:var(--font-sans);">
        Últimas {form.length} peleas · de más reciente a más antigua
      </p>
    </section>
  )}

  <!-- ── Artículos relacionados ── -->
  <section style={`padding: 0 ${PX} 70px;`}>
    <div style="max-width:1400px; margin:0 auto;">

      <div class="flex items-baseline justify-between mb-6 flex-wrap gap-3">
        <h2 style="font-family:var(--font-display);font-size:clamp(1.5rem,4vw,2.5rem);color:#111;">
          {hasRelated
            ? `Artículos sobre ${f.name.split(' ')[0]}`
            : 'También te puede interesar'}
        </h2>
        <a href="/blog"
           class="text-sm font-bold uppercase tracking-widest text-gray-400 hover:text-[#111] transition-colors"
           style="font-family:var(--font-sans);">
          Ver todos →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {articlesToShow.map(a => <ArticleCard article={a} variant="default" />)}
      </div>

    </div>
  </section>

</BaseLayout>
