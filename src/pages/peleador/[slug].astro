---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FIGHTERS from '../../data/fighters.json';

export function getStaticPaths() {
  return FIGHTERS.map((f) => ({ params: { slug: f.slug }, props: { fighter: f } }));
}

const { fighter: f } = Astro.props;
const PX = 'clamp(16px,4vw,60px)';

const initials = f.name.split(' ').slice(0, 2).map((n: string) => n[0]).join('');
const [wins, losses, draws] = f.rec !== '—' ? f.rec.split('-').map(Number) : [0, 0, 0];
const totalFights = wins + losses + (draws || 0);
const winPct = totalFights > 0 ? Math.round((wins / totalFights) * 100) : 0;

const physicals = [
  { label: 'Altura',  value: f.height,  icon: '↕' },
  { label: 'Peso',    value: f.weight,  icon: '⚖' },
  { label: 'Alcance', value: f.reach,   icon: '↔' },
  { label: 'Guardia', value: f.stance,  icon: '🥊' },
  { label: 'Gym',     value: f.team,    icon: '🏛' },
  { label: 'País',    value: f.from,    icon: '🌍' },
].filter(p => p.value);
---

<BaseLayout
  title={`${f.name}${f.nick ? ` "${f.nick}"` : ''} · UFC ${f.div} | Quimbara`}
  description={`Perfil de ${f.name}, campeón UFC ${f.div}. Récord ${f.rec}. ${f.stance ? `Guardia ${f.stance}.` : ''} ${f.team ? `Equipo: ${f.team}.` : ''}`}
>

  <!-- ── Hero ── -->
  <div class="relative overflow-hidden" style="background:#111; min-height: 380px;">

    <!-- Inicial gigante de fondo -->
    <div class="absolute inset-0 flex items-end justify-end pointer-events-none select-none overflow-hidden">
      <span style="font-family:var(--font-display);font-size:clamp(200px,35vw,400px);opacity:0.04;color:#fff;line-height:0.85;margin-right:-20px;">
        {f.name.split(' ').slice(-1)[0]?.[0]}
      </span>
    </div>

    <div style={`max-width:1400px; margin:0 auto; padding: 50px ${PX} 50px; position:relative;`}>

      <!-- Nav -->
      <a href="/"
         class="text-gray-500 hover:text-[#FFD600] text-[11px] font-bold uppercase tracking-widest transition-colors mb-10 inline-block"
         style="font-family:var(--font-sans);">← Inicio</a>

      <div class="flex flex-col md:flex-row md:items-end gap-6 md:gap-10">

        <!-- Foto -->
        <div class="relative flex-shrink-0">
          <div class="rounded-2xl overflow-hidden border-4 border-[#FFD600] flex items-center justify-center bg-gray-800"
               style="width:clamp(90px,15vw,140px);height:clamp(90px,15vw,140px);">
            {f.img ? (
              <img src={f.img} alt={f.name} class="w-full h-full object-cover" />
            ) : (
              <span class="text-white font-black select-none"
                    style="font-family:var(--font-display);font-size:clamp(28px,5vw,48px);">{initials}</span>
            )}
          </div>
          <!-- Badge campeón -->
          <div class="absolute -bottom-2 -right-2 bg-[#FFD600] text-[#111] text-[9px] font-black uppercase tracking-widest px-2 py-1 rounded-md"
               style="font-family:var(--font-sans);">Campeón</div>
        </div>

        <!-- Nombre -->
        <div class="pb-1">
          <div class="inline-block px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest rounded-sm border border-gray-600 text-gray-400 mb-3"
               style="font-family:var(--font-sans);">{f.div}</div>
          <h1 class="text-white leading-none"
              style="font-family:var(--font-display);font-size:clamp(2.2rem,7vw,5rem);">
            {f.name}
          </h1>
          {f.nick && (
            <div class="text-[#FFD600] text-xl italic mt-2" style="font-family:var(--font-serif);">
              "{f.nick}"
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- ── Récord ── -->
  <div style="background:#FFD600;">
    <div style={`max-width:1400px; margin:0 auto; padding: 28px ${PX};`}>
      <div class="grid grid-cols-4 gap-4 items-center">
        <!-- Wins -->
        <div class="text-center">
          <div class="font-black text-[#111] leading-none"
               style="font-family:var(--font-display);font-size:clamp(2.5rem,8vw,5rem);">{wins}</div>
          <div class="text-[10px] font-bold uppercase tracking-widest text-[#111]/50 mt-1"
               style="font-family:var(--font-sans);">Victorias</div>
        </div>
        <!-- Losses -->
        <div class="text-center">
          <div class="font-black text-[#111] leading-none"
               style="font-family:var(--font-display);font-size:clamp(2.5rem,8vw,5rem);">{losses}</div>
          <div class="text-[10px] font-bold uppercase tracking-widest text-[#111]/50 mt-1"
               style="font-family:var(--font-sans);">Derrotas</div>
        </div>
        <!-- Draws -->
        <div class="text-center">
          <div class="font-black text-[#111] leading-none"
               style="font-family:var(--font-display);font-size:clamp(2.5rem,8vw,5rem);">{draws || 0}</div>
          <div class="text-[10px] font-bold uppercase tracking-widest text-[#111]/50 mt-1"
               style="font-family:var(--font-sans);">Empates</div>
        </div>
        <!-- Win % -->
        <div class="text-center border-l-2 border-[#111]/10 pl-4">
          <div class="font-black text-[#111] leading-none"
               style="font-family:var(--font-display);font-size:clamp(2.5rem,8vw,5rem);">{winPct}<span style="font-size:0.4em;">%</span></div>
          <div class="text-[10px] font-bold uppercase tracking-widest text-[#111]/50 mt-1"
               style="font-family:var(--font-sans);">Tasa victoria</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Datos físicos ── -->
  {physicals.length > 0 && (
    <section style={`max-width:1400px; margin:0 auto; padding: 50px ${PX} 60px;`}>
      <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-8"
          style="font-family:var(--font-sans);">Perfil atlético</h2>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-px bg-gray-100 rounded-xl overflow-hidden border border-gray-100">
        {physicals.map(({ label, value, icon }) => (
          <div class="bg-white px-6 py-5 group hover:bg-[#111] transition-colors duration-200">
            <div class="text-[10px] font-bold uppercase tracking-widest text-gray-400 group-hover:text-gray-600 mb-2"
                 style="font-family:var(--font-sans);">{label}</div>
            <div class="text-[#111] font-black text-xl group-hover:text-white leading-tight"
                 style="font-family:var(--font-display);">{value}</div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ── CTA artículos ── -->
  <div style={`background:#111; padding: 50px ${PX};`}>
    <div style="max-width:1400px; margin:0 auto; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:20px;">
      <div>
        <div class="text-gray-500 text-[11px] uppercase tracking-widest font-bold mb-2"
             style="font-family:var(--font-sans);">Quimbara</div>
        <div class="text-white text-2xl md:text-3xl" style="font-family:var(--font-display);">
          Análisis sobre {f.name.split(' ')[0]}
        </div>
      </div>
      <a href="/blog"
         class="inline-block px-6 py-3 text-sm font-bold uppercase tracking-widest rounded-sm bg-[#FFD600] text-[#111] hover:bg-yellow-400 transition-colors"
         style="font-family:var(--font-sans);">
        Ver artículos →
      </a>
    </div>
  </div>

</BaseLayout>
