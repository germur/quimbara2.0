---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FIGHTERS from '../../data/fighters.json';

export function getStaticPaths() {
  return FIGHTERS.map((f) => ({ params: { slug: f.slug }, props: { fighter: f } }));
}

const { fighter: f } = Astro.props;
const PX = 'clamp(16px,4vw,60px)';

// Iniciales del peleador para el avatar de fallback
const initials = f.name.split(' ').slice(0, 2).map((n: string) => n[0]).join('');

// Record: separar wins-losses-draws
const [wins, losses, draws] = f.rec !== '—' ? f.rec.split('-').map(Number) : [0, 0, 0];
const totalFights = wins + losses + (draws || 0);
const winPct = totalFights > 0 ? Math.round((wins / totalFights) * 100) : 0;
---

<BaseLayout
  title={`${f.name}${f.nick ? ` "${f.nick}"` : ''} · Campeón ${f.div} | Quimbara`}
  description={`Perfil de ${f.name}, campeón UFC ${f.div}. Récord: ${f.rec}. Guardia: ${f.stance}. Equipo: ${f.team}.`}
>

  <!-- ── Hero ── -->
  <div style={`background:#111; padding: 60px ${PX} 50px; position:relative; overflow:hidden;`}>
    <!-- Letra de fondo decorativa -->
    <div class="absolute select-none pointer-events-none"
         style="bottom:-60px;right:-30px;font-family:var(--font-display);font-size:clamp(200px,30vw,360px);opacity:0.04;color:#fff;line-height:1;">
      C
    </div>

    <div style="max-width:1400px; margin:0 auto; position:relative;">
      <!-- Breadcrumb -->
      <a href="/" class="text-gray-500 hover:text-[#FFD600] text-xs uppercase tracking-widest font-bold transition-colors mb-8 inline-block"
         style="font-family:var(--font-sans);">
        ← Inicio
      </a>

      <div class="flex flex-col md:flex-row items-start md:items-center gap-6">
        <!-- Avatar -->
        <div class="rounded-full overflow-hidden border-4 border-[#FFD600] flex-shrink-0 flex items-center justify-center bg-gray-800"
             style="width:100px;height:100px;">
          {f.img ? (
            <img src={f.img} alt={f.name} class="w-full h-full object-cover" />
          ) : (
            <span class="text-white font-black text-2xl select-none" style="font-family:var(--font-display);">{initials}</span>
          )}
        </div>

        <!-- Nombre y división -->
        <div>
          <div class="flex items-center gap-3 mb-2 flex-wrap">
            <span class="inline-block px-3 py-1 text-[11px] font-bold uppercase tracking-widest rounded-sm bg-[#FFD600] text-[#111]"
                  style="font-family:var(--font-sans);">
              Campeón
            </span>
            <span class="inline-block px-3 py-1 text-[11px] font-bold uppercase tracking-widest rounded-sm border border-gray-600 text-gray-400"
                  style="font-family:var(--font-sans);">
              {f.div}
            </span>
          </div>
          <h1 class="text-white leading-none" style="font-family:var(--font-display);font-size:clamp(2rem,6vw,4.5rem);">
            {f.name}
          </h1>
          {f.nick && (
            <div class="text-[#FFD600] text-xl italic mt-1" style="font-family:var(--font-serif);">
              "{f.nick}"
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- ── Récord visual ── -->
  <div class="bg-[#FFD600]" style={`padding: 30px ${PX};`}>
    <div style="max-width:1400px; margin:0 auto;">
      <div class="grid grid-cols-3 gap-4 text-center">
        <div>
          <div class="text-4xl md:text-6xl font-black text-[#111] leading-none"
               style="font-family:var(--font-display);">{wins}</div>
          <div class="text-[11px] font-bold uppercase tracking-widest text-[#111]/60 mt-1"
               style="font-family:var(--font-sans);">Victorias</div>
        </div>
        <div>
          <div class="text-4xl md:text-6xl font-black text-[#111] leading-none"
               style="font-family:var(--font-display);">{losses}</div>
          <div class="text-[11px] font-bold uppercase tracking-widest text-[#111]/60 mt-1"
               style="font-family:var(--font-sans);">Derrotas</div>
        </div>
        <div>
          <div class="text-4xl md:text-6xl font-black text-[#111] leading-none"
               style="font-family:var(--font-display);">{draws || 0}</div>
          <div class="text-[11px] font-bold uppercase tracking-widest text-[#111]/60 mt-1"
               style="font-family:var(--font-sans);">Empates</div>
        </div>
      </div>
      {totalFights > 0 && (
        <div class="mt-4">
          <div class="text-[11px] font-bold uppercase tracking-widest text-[#111]/60 mb-1"
               style="font-family:var(--font-sans);">
            {winPct}% tasa de victoria ({totalFights} peleas)
          </div>
          <div class="w-full bg-[#111]/10 rounded-full h-2">
            <div class="bg-[#111] h-2 rounded-full transition-all"
                 style={`width:${winPct}%`}></div>
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- ── Datos físicos ── -->
  <section style={`max-width:1400px; margin:0 auto; padding: 50px ${PX} 60px;`}>
    <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-6"
        style="font-family:var(--font-sans);">
      Datos físicos
    </h2>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
      {[
        { label: 'Altura',  value: f.height  || '—' },
        { label: 'Peso',    value: f.weight  || '—' },
        { label: 'Alcance', value: f.reach   || '—' },
        { label: 'Guardia', value: f.stance  || '—' },
        { label: 'Equipo',  value: f.team    || '—' },
      ].map(({ label, value }) => (
        <div class="bg-gray-50 rounded-md p-5">
          <div class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2"
               style="font-family:var(--font-sans);">
            {label}
          </div>
          <div class="text-[#111] font-bold text-base leading-tight"
               style="font-family:var(--font-display);">
            {value}
          </div>
        </div>
      ))}
    </div>

    {f.from && (
      <div class="mt-3 bg-gray-50 rounded-md p-5 inline-block">
        <div class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2"
             style="font-family:var(--font-sans);">País</div>
        <div class="text-[#111] font-bold text-base" style="font-family:var(--font-display);">{f.from}</div>
      </div>
    )}
  </section>

  <!-- ── CTA artículos relacionados ── -->
  <div class="bg-[#111]" style={`padding: 50px ${PX};`}>
    <div style="max-width:1400px; margin:0 auto; text-align:center;">
      <div class="text-gray-500 text-xs uppercase tracking-widest font-bold mb-3"
           style="font-family:var(--font-sans);">Quimbara</div>
      <div class="text-white text-2xl md:text-3xl mb-6" style="font-family:var(--font-display);">
        Análisis, noticias y opinión sobre {f.name.split(' ')[0]}
      </div>
      <a href="/blog"
         class="inline-block px-6 py-3 text-sm font-semibold uppercase tracking-widest rounded-sm transition-colors duration-200 bg-[#FFD600] text-[#111] hover:bg-yellow-400"
         style="font-family:var(--font-sans);">
        Ver todos los artículos
      </a>
    </div>
  </div>

</BaseLayout>
