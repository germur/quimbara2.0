---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EVENTS from '../../data/events-all.json';
// @ts-ignore — módulo JS compartido con scripts/apply-event-overrides.mjs
import { dedupeEventos } from '../../lib/eventos.mjs';

const PX = 'clamp(16px,4vw,60px)';
const today = new Date().toISOString().slice(0, 10);

// Separar próximos y pasados
type EventEntry = typeof EVENTS[0] & { status?: string; fightCard?: unknown[] };

// Duplicados de Wikipedia/Sherdog: criterio único en src/lib/eventos.mjs,
// compartido con el script que genera los 3 próximos de la home.
const allEvents = dedupeEventos(EVENTS as EventEntry[]) as EventEntry[];

// Manda la FECHA, punto. El `status` no participa en la decisión porque llega
// sucio por los dos lados: overrides manuales con 'upcoming' fijo resucitaban
// eventos ya celebrados (Casa Blanca, 7 semanas en "Próximos"), y el scraper
// marca 'completed' eventos que aún no han ocurrido (UFC 332, octubre).
const upcoming = allEvents.filter(e => e.date >= today);
const past = allEvents.filter(e => e.date < today).reverse(); // más reciente primero

// Agrupar próximos por mes
const byMonth: Record<string, typeof EVENTS> = {};
for (const e of upcoming) {
  const key = e.date.slice(0, 7); // "2026-05"
  if (!byMonth[key]) byMonth[key] = [];
  byMonth[key].push(e);
}

// Agrupar pasados por mes
const pastByMonth: Record<string, typeof EVENTS> = {};
for (const e of past) {
  const key = e.date.slice(0, 7);
  if (!pastByMonth[key]) pastByMonth[key] = [];
  pastByMonth[key].push(e);
}

const monthLabel = (key: string) => {
  const [y, m] = key.split('-');
  return new Date(Number(y), Number(m) - 1, 1)
    .toLocaleDateString('es-ES', { month: 'long', year: 'numeric' });
};

const siteUrl = 'https://quimbara.org';

const eventListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Próximos eventos UFC 2026",
  "description": "Calendario completo de próximos eventos UFC con fechas, horarios y carteleras.",
  "url": `${siteUrl}/eventos/`,
  "numberOfItems": EVENTS.length,
  "itemListElement": EVENTS.slice(0, 10).map((e, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": `${e.name}${e.main !== 'TBD' ? ': ' + e.main : ''}`,
    "url": `${siteUrl}/eventos/${e.slug}/`
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Eventos UFC", "item": `${siteUrl}/eventos/` }
  ]
};

const eventsSchema = `[${JSON.stringify(eventListSchema)}, ${JSON.stringify(breadcrumbSchema)}]`;

const isPPV = (name: string) => /UFC \d/.test(name);
---

<BaseLayout
  title="Próximos Eventos UFC 2026 · Fechas y Horarios"
  description="Calendario completo de eventos UFC 2026: fechas, horarios, ciudades y peleas principales confirmadas. ¿A qué hora es la pelea? Toda la info en Quimbara."
  canonicalUrl={`${siteUrl}/eventos/`}
  schema={eventsSchema}
>

  <!-- ── Hero ── -->
  <div style={`background:#111; padding: 70px ${PX} 60px;`}>
    <div style="max-width:1400px; margin:0 auto;">
      <span class="inline-block px-3 py-1 text-[11px] font-bold uppercase tracking-widest rounded-sm bg-[#F2D928] text-[#111] mb-6"
            style="font-family:var(--font-sans);">Calendario 2026</span>
      <h1 style="font-family:var(--font-display);font-size:clamp(3rem,10vw,7rem);line-height:0.95;color:#fff;">
        Próximos<br/><span style="color:#F2D928;">Eventos</span>
      </h1>
      <p class="text-gray-400 mt-5 text-sm" style="font-family:var(--font-sans);">
        {EVENTS.length} eventos · Actualizado cada lunes automáticamente
      </p>
    </div>
  </div>

  <!-- ── Lista agrupada por mes ── -->
  <div style={`max-width:1400px; margin:0 auto; padding: 60px ${PX};`}>
    {Object.entries(byMonth).map(([key, events]) => (
      <div class="mb-12">
        <!-- Cabecera de mes -->
        <div class="flex items-center gap-4 mb-5">
          <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-gray-400 capitalize"
              style="font-family:var(--font-sans);">{monthLabel(key)}</h2>
          <div class="flex-1 h-px bg-gray-100"></div>
        </div>

        <!-- Eventos del mes -->
        <div class="flex flex-col gap-2">
          {events.map((e, i) => {
            const day  = e.dateLabel.split(' ')[0];
            const mon  = e.dateLabel.split(' ')[1]?.toUpperCase();
            const ppv  = isPPV(e.name);
            return (
              <a href={`/eventos/${e.slug}`}
                 class="group flex items-center gap-3 rounded-lg transition-all duration-200 hover:bg-[#111] hover:shadow-xl"
                 style="padding: 16px 20px;">

                <!-- Día -->
                <div class="text-center flex-shrink-0 w-12">
                  <div class="text-[10px] font-bold tracking-widest text-gray-400 group-hover:text-gray-500"
                       style="font-family:var(--font-sans);">{mon}</div>
                  <div class="text-3xl font-black leading-none text-[#111] group-hover:text-white"
                       style="font-family:var(--font-display);">{day}</div>
                </div>

                <!-- Línea separadora -->
                <div class="h-8 w-px bg-gray-200 group-hover:bg-gray-700 flex-shrink-0"></div>

                <!-- Info -->
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2 mb-1 flex-wrap">
                    {ppv ? (
                      <span class="text-[10px] font-black uppercase tracking-widest px-2 py-0.5 rounded-sm bg-[#F2D928] text-[#111] group-hover:bg-[#F2D928]"
                            style="font-family:var(--font-sans);">PPV</span>
                    ) : (
                      <span class="text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-sm border border-gray-200 text-gray-400 group-hover:border-gray-600"
                            style="font-family:var(--font-sans);">Fight Night</span>
                    )}
                    <span class="text-[10px] text-gray-400 font-medium group-hover:text-gray-500"
                          style="font-family:var(--font-sans);">{e.name}</span>
                  </div>
                  <div class="leading-tight group-hover:text-white text-[#111]"
                       style={`font-family:var(--font-display);font-size:${e.main !== 'TBD' ? 'clamp(1.1rem,2vw,1.4rem)' : '1rem'};${e.main === 'TBD' ? 'color:#9ca3af' : ''}`}>
                    {e.main !== 'TBD' ? e.main : 'Por confirmar'}
                  </div>
                  <div class="flex items-center gap-1 mt-1 text-gray-400 group-hover:text-gray-500">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                    </svg>
                    <span class="text-[11px]" style="font-family:var(--font-sans);">{e.loc}</span>
                  </div>
                </div>

                <!-- Flecha -->
                <div class="text-gray-200 group-hover:text-[#F2D928] transition-all duration-200 text-xl font-bold">→</div>
              </a>
            );
          })}
        </div>
      </div>
    ))}

    {/* ── Eventos pasados ── */}
    {past.length > 0 && (
      <div class="mt-16 pt-12 border-t border-gray-200">
        <div class="flex items-center gap-4 mb-8">
          <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-gray-400"
              style="font-family:var(--font-sans);">Eventos pasados</h2>
          <div class="flex-1 h-px bg-gray-100"></div>
        </div>

        {Object.entries(pastByMonth).map(([key, events]) => (
          <div class="mb-8">
            <div class="flex items-center gap-4 mb-4">
              <h3 class="text-[10px] font-bold uppercase tracking-[0.2em] text-gray-300 capitalize"
                  style="font-family:var(--font-sans);">{monthLabel(key)}</h3>
              <div class="flex-1 h-px bg-gray-50"></div>
            </div>
            <div class="flex flex-col gap-1">
              {events.map((e) => {
                const day = e.dateLabel.split(' ')[0];
                const mon = e.dateLabel.split(' ')[1]?.toUpperCase();
                return (
                  <a href={`/eventos/${e.slug}`}
                     class="group flex items-center gap-3 rounded-lg transition-all duration-200 hover:bg-gray-50 opacity-70 hover:opacity-100"
                     style="padding: 12px 20px;">
                    <div class="text-center flex-shrink-0 w-10">
                      <div class="text-[9px] font-bold tracking-widest text-gray-300" style="font-family:var(--font-sans);">{mon}</div>
                      <div class="text-xl font-black leading-none text-gray-300" style="font-family:var(--font-display);">{day}</div>
                    </div>
                    <div class="h-6 w-px bg-gray-100 flex-shrink-0"></div>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 mb-0.5">
                        <span class="text-[9px] font-bold uppercase tracking-widest px-1.5 py-0.5 rounded-sm bg-gray-100 text-gray-400"
                              style="font-family:var(--font-sans);">Finalizado</span>
                        <span class="text-[10px] text-gray-300" style="font-family:var(--font-sans);">{e.name}</span>
                      </div>
                      <div class="text-gray-500 text-sm font-bold truncate" style="font-family:var(--font-display);">
                        {e.main !== 'TBD' ? e.main : 'Cartel finalizado'}
                      </div>
                    </div>
                    <div class="text-gray-200 group-hover:text-gray-400 text-lg">→</div>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    )}
  </div>

</BaseLayout>
