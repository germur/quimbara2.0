---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import EVENTS_RAW from '../../data/events-all.json';
import { getCollection } from 'astro:content';
import Breadcrumb from '../../components/Breadcrumb.astro';
// @ts-ignore — conversión de horarios por país (ver src/lib/horarios.mjs)
import { horariosDeEvento } from '../../lib/horarios.mjs';
import HorariosEvento from '../../components/HorariosEvento.astro';

type FightCardEntry = { f1: string; f1Id: string; f2: string; f2Id: string; weightClass: string; bout: string; order: number };
type EventFull = typeof EVENTS_RAW[0] & { f1: string; f2: string; f1img: string; f2img: string; fightCard?: FightCardEntry[]; status?: 'upcoming' | 'completed' };
const EVENTS = EVENTS_RAW as EventFull[];

export function getStaticPaths() {
  const evs = EVENTS_RAW as EventFull[];
  return evs.map((e) => ({ params: { slug: e.slug }, props: { event: e } }));
}

const { event } = Astro.props as { event: EventFull };
const PX = 'clamp(16px,4vw,60px)';

const isPPV = /UFC \d/.test(event.name);
const isCompleted = event.status === 'completed' || event.date < new Date().toISOString().slice(0, 10);
const eventNum = event.name.replace('UFC ', '').replace('Fight Night', 'FN');

// La quiniela solo existe si UFC ya anunció la cartelera: sin peleas no hay
// nada que picar. La página es noindex (producto de retención, no contenido).
const tieneQuiniela = Array.isArray(event.fightCard) && event.fightCard.length > 0;

// Horarios por país: la sección que el title llevaba prometiendo sin existir.
const { confirmada: horaConfirmada, horaET, horarios, startDateISO } = horariosDeEvento(event as any);

const f1 = event.f1 ?? (event.main !== 'TBD' ? event.main.split(' vs. ')[0]?.trim() : 'TBD');
const f2 = event.f2 ?? (event.main !== 'TBD' ? event.main.split(' vs. ')[1]?.trim() : 'TBD');
const hasFight = event.main !== 'TBD';

const initials = (name: string) => name.split(' ').slice(0, 2).map(n => n[0]).join('');
const lastName  = (name: string) => name.split(' ').slice(-1)[0] ?? name;

const slugify = (name: string) => name.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[''']/g, '').replace(/[^a-z0-9\s-]/g, '').trim().replace(/\s+/g, '-');

import { readdirSync } from 'node:fs';
import FIGHTERS_RAW from '../../data/fighters.json';
const allPhotos = new Set(readdirSync('public/fighters').filter(f => /\.(png|jpg|webp)$/i.test(f)).map(f => f.replace(/\.(png|jpg|webp)$/i, '')));
const fighterSlugs = new Set((FIGHTERS_RAW as any[]).map((f: any) => f.slug));

function fighterUrl(name: string): string {
  if (!name || name === 'TBD') return '';
  const slug = slugify(name);
  if (fighterSlugs.has(slug)) return `/peleadores/${slug}/`;
  for (const s of fighterSlugs) {
    if (s.startsWith(slug + '-') || s.endsWith('-' + slug)) return `/peleadores/${s}/`;
  }
  return '';
}

function fighterPhoto(name: string): string {
  if (!name || name === 'TBD') return '';
  const slug = slugify(name);
  if (allPhotos.has(slug)) return `/fighters/${slug}.png`;
  for (const p of allPhotos) {
    if (p.startsWith(slug + '-') || p.endsWith('-' + slug)) return `/fighters/${p}.png`;
  }
  return '';
}

// Otros eventos próximos (excluir el actual)
const otherEvents = EVENTS.filter(e => e.slug !== event.slug && e.main !== 'TBD').slice(0, 3);

// Artículos relacionados: buscar por nombre de los fighters
const allPosts = await getCollection('blog');
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const keywords = [f1, f2, event.name].map(s => s.toLowerCase().split(' ').slice(-1)[0]);
const related = allPosts.filter(p => {
  const hay = `${p.data.title} ${p.data.description ?? ''}`.toLowerCase();
  return keywords.some(k => k.length > 3 && hay.includes(k));
});
const articles = related.length > 0 ? related.slice(0, 3) : allPosts.slice(0, 3);
const articlesLabel = related.length > 0 ? `Análisis sobre este evento` : 'También te puede interesar';

const siteUrl = 'https://quimbara.org';
const canonicalUrl = `${siteUrl}/eventos/${event.slug}/`;

// Schema SportsEvent (tripletas: evento → fecha, lugar, peleadores)
const eventSchema = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": event.name + (hasFight ? `: ${f1} vs. ${f2}` : ''),
  "url": canonicalUrl,
  // Con hora, no solo fecha: es lo que Google necesita para los rich results
  // de eventos. Si el horario no está confirmado se deja la fecha a secas
  // antes que publicar una hora estimada como si fuera oficial.
  "startDate": horaConfirmada ? startDateISO : event.date,
  "location": {
    "@type": "Place",
    "name": event.loc || "Por confirmar",
    "address": { "@type": "PostalAddress", "addressLocality": event.loc || "Por confirmar" }
  },
  "sport": "Mixed Martial Arts",
  "organizer": { "@type": "Organization", "name": "UFC", "url": "https://www.ufc.com" },
  "performer": hasFight ? [
    { "@type": "Person", "name": f1 },
    { "@type": "Person", "name": f2 }
  ] : [{ "@type": "Organization", "name": "UFC", "url": "https://www.ufc.com" }],
  "description": `${event.name} — ${hasFight ? `Pelea principal: ${f1} vs. ${f2}.` : 'Cartel por confirmar.'} ${event.dateLabel} en ${event.loc}.`,
  "eventStatus": isCompleted ? "https://schema.org/EventCompleted" : "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/MixedEventAttendanceMode"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Eventos", "item": `${siteUrl}/eventos/` },
    { "@type": "ListItem", "position": 3, "name": event.name, "item": canonicalUrl }
  ]
};

// FAQ de horarios: ataca la búsqueda tal y como la escribe la gente
// ("¿a qué hora es UFC 330 en Colombia?"). Es una pregunta que un knowledge
// panel no puede responder, porque la respuesta depende del país de quien
// pregunta — de ahí que sea de las pocas de este nicho que sí generan clic.
const faqHorarios = !isCompleted ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    ...horarios.map(h => ({
      "@type": "Question",
      "name": `¿A qué hora es ${event.name} en ${h.pais}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `La cartelera estelar de ${event.name} empieza a las ${h.hora} de ${h.pais} (${h.dia})${h.diaSiguiente ? ', ya de madrugada' : ''}. Las prelims comienzan unas 2 horas antes.`
      }
    })),
    ...(hasFight ? [{
      "@type": "Question",
      "name": `¿Quién pelea en ${event.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `La pelea principal de ${event.name} es ${f1} vs. ${f2}, el ${event.dateLabel} en ${event.loc}.`
      }
    }] : []),
    {
      "@type": "Question",
      "name": `¿Dónde ver ${event.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${event.name} se puede ver por ${isPPV ? 'PPV en ESPN+ y Movistar Plus+, con las prelims en' : ''} UFC Fight Pass y ESPN/ESPN+ según el país.`
      }
    }
  ]
} : null;

const eventSchemaStr = `[${[eventSchema, breadcrumbSchema, faqHorarios].filter(Boolean).map(s => JSON.stringify(s)).join(', ')}]`;

// Meta optimizado — diferenciado para eventos pasados vs futuros
// Estrategia SEO: priorizar CTR con título descriptivo + KWs comerciales
const metaTitle = isCompleted
  ? `${event.name}${hasFight ? `: ${f1} vs. ${f2}` : ''} · Resultados y Cartelera · ${event.dateLabel}`
  : `${event.name}${hasFight ? `: ${f1} vs. ${f2}` : ''} · Cartelera, Horarios y Dónde Ver · ${event.dateLabel}`;

const metaDescription = isCompleted
  ? `Resultados de ${event.name}${hasFight ? ` (${f1} vs. ${f2})` : ''} celebrado el ${event.dateLabel} en ${event.loc}. Cartelera completa, ganadores, métodos de victoria y análisis post-evento en español.`
  : `Cartelera completa de ${event.name}${hasFight ? ` — pelea estelar ${f1} vs. ${f2}` : ''}. ¿A qué hora pelea? Horarios por país (México, Colombia, España, Argentina) y dónde ver en vivo el ${event.dateLabel}.`;
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonicalUrl={canonicalUrl}
  ogImage={event.f1img || '/default-og.jpg'}
  schema={eventSchemaStr}
>

  <!-- ── Hero + Matchup integrado ── -->
  <div class="relative overflow-hidden" style="background:#0a0a0a;">
    <!-- Número gigante de fondo -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden">
      <span style="font-family:var(--font-display);font-size:clamp(200px,40vw,500px);opacity:0.03;color:#fff;line-height:1;">
        {eventNum}
      </span>
    </div>

    <div style={`max-width:1400px; margin:0 auto; padding: 40px ${PX} 0; position:relative;`}>
      <!-- Breadcrumb + badges -->
      <div class="mb-4">
        <Breadcrumb
          variant="dark"
          items={[
            { name: 'Inicio', href: '/' },
            { name: 'Eventos', href: '/eventos/' },
            { name: event.name }
          ]}
        />
      </div>

      <!-- Info superior centrada -->
      <div class="text-center mb-2">
        <div class="flex items-center justify-center gap-2 mb-3 flex-wrap">
          <span class={`inline-block px-3 py-1 text-[11px] font-black uppercase tracking-widest rounded-sm ${isPPV ? 'bg-[#F2D928] text-[#111]' : 'border border-gray-600 text-gray-400'}`}
                style="font-family:var(--font-sans);">{isPPV ? '★ PPV' : 'Fight Night'}</span>
          {isCompleted && (
            <span class="inline-block px-3 py-1 text-[11px] font-black uppercase tracking-widest rounded-sm bg-gray-700 text-gray-300"
                  style="font-family:var(--font-sans);">Evento finalizado</span>
          )}
        </div>
        <h1 class="text-white" style="font-family:var(--font-display);font-size:clamp(2rem,6vw,4.5rem);line-height:0.95;">{event.name}</h1>
        <div class="flex flex-wrap items-center justify-center gap-5 mt-3" style="font-family:var(--font-sans);">
          <div class="flex items-center gap-2 text-[#F2D928] text-sm font-bold">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            {event.dateLabel}
          </div>
          <div class="flex items-center gap-2 text-gray-400 text-sm">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            {event.loc}
          </div>
        </div>
      </div>

      {/* ── Matchup visual ── */}
      {hasFight ? (
        <div class="relative mt-6 pb-0">
          <!-- Fighters row -->
          <div class="grid items-end gap-0" style="grid-template-columns: 1fr auto 1fr;">

            {/* ── F1 ── */}
            <div class="flex flex-col items-center text-center">
              <!-- Nombre arriba de la foto -->
              <div class="mb-3">
                <div class="text-[#F2D928] text-[10px] font-black uppercase tracking-[0.2em] mb-1" style="font-family:var(--font-sans);">Main Event</div>
                <div class="text-white font-black leading-none" style="font-family:var(--font-display);font-size:clamp(1.6rem,4vw,3rem);">{lastName(f1)}</div>
                <div class="text-gray-500 text-xs mt-1 font-medium" style="font-family:var(--font-sans);">{f1}</div>
              </div>
              <!-- Foto -->
              <div class="relative w-full flex justify-center">
                {event.f1img ? (
                  <img src={event.f1img} alt={f1}
                       class="object-cover object-top"
                       style="height:clamp(160px,25vw,280px); filter: drop-shadow(0 0 40px rgba(255,214,0,0.15));" />
                ) : (
                  <div class="flex items-center justify-center rounded-full border-4 border-[#F2D928] bg-gray-800"
                       style="width:clamp(100px,18vw,160px); height:clamp(100px,18vw,160px);">
                    <span class="text-white font-black" style="font-family:var(--font-display);font-size:clamp(2rem,5vw,4rem);">{initials(f1)}</span>
                  </div>
                )}
              </div>
            </div>

            {/* ── VS central ── */}
            <div class="flex flex-col items-center justify-end pb-8 md:pb-16 px-3 md:px-8 relative z-10">
              <div class="relative">
                <div class="text-[#F2D928] font-black" style="font-family:var(--font-display);font-size:clamp(2rem,5vw,4.5rem);line-height:1;text-shadow: 0 0 60px rgba(255,214,0,0.3);">VS</div>
              </div>
            </div>

            {/* ── F2 ── */}
            <div class="flex flex-col items-center text-center">
              <!-- Nombre arriba de la foto -->
              <div class="mb-3">
                <div class="text-gray-500 text-[10px] font-black uppercase tracking-[0.2em] mb-1" style="font-family:var(--font-sans);">Oponente</div>
                <div class="text-white font-black leading-none" style="font-family:var(--font-display);font-size:clamp(1.6rem,4vw,3rem);">{lastName(f2)}</div>
                <div class="text-gray-500 text-xs mt-1 font-medium" style="font-family:var(--font-sans);">{f2}</div>
              </div>
              <!-- Foto -->
              <div class="relative w-full flex justify-center">
                {event.f2img ? (
                  <img src={event.f2img} alt={f2}
                       class="object-cover object-top"
                       style="height:clamp(160px,25vw,280px); filter: drop-shadow(0 0 40px rgba(255,255,255,0.05));" />
                ) : (
                  <div class="flex items-center justify-center rounded-full border-4 border-gray-700 bg-gray-800"
                       style="width:clamp(100px,18vw,160px); height:clamp(100px,18vw,160px);">
                    <span class="text-gray-400 font-black" style="font-family:var(--font-display);font-size:clamp(2rem,5vw,4rem);">{initials(f2)}</span>
                  </div>
                )}
              </div>
            </div>
          </div>

          <!-- Línea decorativa base -->
          <div class="h-[3px] w-full" style="background: linear-gradient(90deg, #F2D928 0%, #F2D928 50%, #333 50%, #333 100%);"></div>
        </div>
      ) : null}

      {/* CTA a la quiniela. Solo si el evento tiene cartelera cargada, que es
          lo que la quiniela necesita para existir. La página es noindex. */}
      {tieneQuiniela && (
        <a href={`/eventos/${event.slug}/quiniela/`}
           class="group flex items-center justify-between gap-4 rounded-2xl px-6 py-5 mt-2 mb-8 transition-transform hover:-translate-y-0.5"
           style="background:#F2D928; color:#0A0A0B;">
          <div>
            <div class="text-[10px] font-black uppercase tracking-[0.2em] opacity-60"
                 style="font-family:var(--font-mono);">Quiniela</div>
            <div class="text-xl md:text-2xl font-black leading-tight mt-1"
                 style="font-family:var(--font-display);">
              {isCompleted ? 'Mirá cómo te fue' : 'Haz tus predicciones'}
            </div>
            <p class="text-xs mt-1 opacity-70" style="font-family:var(--font-sans);">
              {isCompleted
                ? 'Compará tu puntaje contra los picks de Quimbara.'
                : 'Picá ganador, método y round. Competís contra Quimbara, no contra un ranking anónimo.'}
            </p>
          </div>
          <span class="text-2xl font-black flex-shrink-0 transition-transform group-hover:translate-x-1">→</span>
        </a>
      )}

      {!hasFight && (
        <div class="rounded-2xl border-2 border-dashed border-gray-700 p-12 text-center mt-6 mb-8">
          <div class="text-5xl mb-4" style="font-family:var(--font-display); color:#333;">?</div>
          <div class="text-gray-400 text-xl font-bold" style="font-family:var(--font-display);">Cartel por confirmar</div>
          <p class="text-gray-500 text-sm mt-2" style="font-family:var(--font-sans);">La UFC anunciará las peleas próximamente.</p>
        </div>
      )}
    </div>

    {/* Meta bar — integrada en el bloque oscuro */}
    {hasFight && (
      <div style="background:#111; border-top: 1px solid #222;">
        <div class="grid grid-cols-3 divide-x divide-gray-800" style={`max-width:1400px; margin:0 auto; font-family:var(--font-sans);`}>
          {[{ label:'Evento', val: event.name }, { label:'Fecha', val: event.dateLabel }, { label:'Ciudad', val: event.loc.split(',')[0] }].map(({ label, val }) => (
            <div class="px-4 py-4 text-center">
              <div class="text-[10px] font-bold uppercase tracking-widest text-gray-600 mb-1">{label}</div>
              <div class="text-white text-xs md:text-sm font-semibold truncate">{val}</div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- ── Horarios por país (tabla estática + detección de zona en cliente) ── -->
  {!isCompleted && (
    <div style={`max-width:1400px; margin:0 auto; padding: 50px ${PX} 0;`}>
      <HorariosEvento
        nombreEvento={event.name}
        fechaLabel={event.dateLabel}
        horaET={horaET}
        confirmada={horaConfirmada}
        startDateISO={startDateISO}
        horarios={horarios}
        peleaPrincipal={hasFight ? `${f1} vs. ${f2}` : null}
      />
    </div>
  )}

  <!-- ── Cómo ver ── -->
  <section style={`max-width:1400px; margin:0 auto; padding: 50px ${PX} 0;`}>
    <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-5" style="font-family:var(--font-sans);">Cómo ver</h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {[
        { plat: 'UFC Fight Pass', detail: 'Prelims completas + archivo', color: '#F2D928' },
        { plat: 'ESPN / ESPN+',   detail: 'Prelims + Cartelera estelar', color: '#F2D928' },
        { plat: isPPV ? 'PPV (ESPN+ / Movistar)' : 'TV abierta / streaming', detail: isPPV ? 'Cartelera estelar PPV' : 'Cartelera estelar incluida', color: '#F2D928' },
      ].map(({ plat, detail, color }) => (
        <div class="rounded-xl border border-gray-100 p-5 flex items-start gap-4">
          <div class="w-2 h-2 rounded-full mt-1.5 flex-shrink-0" style={`background:${color};`}></div>
          <div>
            <div class="font-bold text-[#111] text-sm" style="font-family:var(--font-display);">{plat}</div>
            <div class="text-gray-400 text-xs mt-0.5" style="font-family:var(--font-sans);">{detail}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Cartelera completa ── -->
  {event.fightCard && event.fightCard.length > 0 && (
    <section style={`max-width:1400px; margin:0 auto; padding: 50px ${PX} 0;`}>
      <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-5" style="font-family:var(--font-sans);">Cartelera completa</h2>
      <div class="space-y-4" style="font-family:var(--font-sans);">
        {event.fightCard.map((fight, i) => {
          const isMain = fight.bout === 'Main Event' || i === 0;
          const isCoMain = fight.bout === 'Co-Main Event' || i === 1;
          const f1Photo = fighterPhoto(fight.f1);
          const f2Photo = fighterPhoto(fight.f2);
          const f1Init = initials(fight.f1);
          const f2Init = initials(fight.f2);
          const f1Url = fighterUrl(fight.f1);
          const f2Url = fighterUrl(fight.f2);
          return (
            <div class={`rounded-2xl overflow-hidden ${isMain ? 'border-2 border-[#F2D928]' : 'border border-gray-200'}`}>
              {/* Weight class header */}
              <div class={`text-center py-2 ${isMain ? 'bg-[#111]' : 'bg-gray-50'}`}>
                {isMain && <span class="text-[10px] font-black uppercase tracking-widest px-2 py-0.5 rounded-sm bg-[#F2D928] text-[#111] mr-2">Main Event</span>}
                {isCoMain && <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mr-2">Co-Main</span>}
                {!isMain && !isCoMain && <span class="text-[10px] text-gray-400 tabular-nums mr-2">{String(i + 1).padStart(2, '0')}</span>}
                <span class={`text-[10px] font-bold uppercase tracking-widest ${isMain ? 'text-gray-400' : 'text-gray-500'}`}>{fight.weightClass}</span>
              </div>
              {/* Fighter matchup */}
              <div class={`flex items-center justify-between px-4 sm:px-8 py-5 ${isMain ? 'bg-[#111]' : 'bg-white'}`}>
                {/* Fighter 1 */}
                {f1Url ? (
                  <a href={f1Url} class="flex items-center gap-3 sm:gap-4 flex-1 min-w-0 no-underline hover:opacity-80 transition-opacity">
                    {f1Photo ? (
                      <img src={f1Photo} alt={fight.f1} class="w-14 h-14 sm:w-20 sm:h-20 rounded-full object-cover object-top flex-shrink-0 bg-gray-200" loading="lazy" />
                    ) : (
                      <div class={`w-14 h-14 sm:w-20 sm:h-20 rounded-full flex items-center justify-center flex-shrink-0 text-sm sm:text-base font-black ${isMain ? 'bg-gray-700 text-gray-400' : 'bg-gray-200 text-gray-500'}`}>{f1Init}</div>
                    )}
                    <span class={`font-bold text-sm sm:text-base truncate ${isMain ? 'text-white' : 'text-[#111]'}`} style="font-family:var(--font-display);">{fight.f1}</span>
                  </a>
                ) : (
                  <div class="flex items-center gap-3 sm:gap-4 flex-1 min-w-0">
                    {f1Photo ? (
                      <img src={f1Photo} alt={fight.f1} class="w-14 h-14 sm:w-20 sm:h-20 rounded-full object-cover object-top flex-shrink-0 bg-gray-200" loading="lazy" />
                    ) : (
                      <div class={`w-14 h-14 sm:w-20 sm:h-20 rounded-full flex items-center justify-center flex-shrink-0 text-sm sm:text-base font-black ${isMain ? 'bg-gray-700 text-gray-400' : 'bg-gray-200 text-gray-500'}`}>{f1Init}</div>
                    )}
                    <span class={`font-bold text-sm sm:text-base truncate ${isMain ? 'text-white' : 'text-[#111]'}`} style="font-family:var(--font-display);">{fight.f1}</span>
                  </div>
                )}
                {/* VS */}
                <span class={`flex-shrink-0 text-xs sm:text-sm font-black px-3 ${isMain ? 'text-[#F2D928]' : 'text-gray-300'}`}>VS</span>
                {/* Fighter 2 */}
                {f2Url ? (
                  <a href={f2Url} class="flex items-center gap-3 sm:gap-4 flex-1 min-w-0 justify-end no-underline hover:opacity-80 transition-opacity">
                    <span class={`font-bold text-sm sm:text-base truncate text-right ${isMain ? 'text-white' : 'text-[#111]'}`} style="font-family:var(--font-display);">{fight.f2}</span>
                    {f2Photo ? (
                      <img src={f2Photo} alt={fight.f2} class="w-14 h-14 sm:w-20 sm:h-20 rounded-full object-cover object-top flex-shrink-0 bg-gray-200" loading="lazy" />
                    ) : (
                      <div class={`w-14 h-14 sm:w-20 sm:h-20 rounded-full flex items-center justify-center flex-shrink-0 text-sm sm:text-base font-black ${isMain ? 'bg-gray-700 text-gray-400' : 'bg-gray-200 text-gray-500'}`}>{f2Init}</div>
                    )}
                  </a>
                ) : (
                  <div class="flex items-center gap-3 sm:gap-4 flex-1 min-w-0 justify-end">
                    <span class={`font-bold text-sm sm:text-base truncate text-right ${isMain ? 'text-white' : 'text-[#111]'}`} style="font-family:var(--font-display);">{fight.f2}</span>
                    {f2Photo ? (
                      <img src={f2Photo} alt={fight.f2} class="w-14 h-14 sm:w-20 sm:h-20 rounded-full object-cover object-top flex-shrink-0 bg-gray-200" loading="lazy" />
                    ) : (
                      <div class={`w-14 h-14 sm:w-20 sm:h-20 rounded-full flex items-center justify-center flex-shrink-0 text-sm sm:text-base font-black ${isMain ? 'bg-gray-700 text-gray-400' : 'bg-gray-200 text-gray-500'}`}>{f2Init}</div>
                    )}
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </section>
  )}

  <!-- ── Sobre el evento (SEO text) ── -->
  <section style={`max-width:1400px; margin:0 auto; padding: 40px ${PX} 0;`}>
    <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-5" style="font-family:var(--font-sans);">Sobre el evento</h2>
    <div class="rounded-xl bg-gray-50 p-6 md:p-8 prose prose-sm max-w-none" style="font-family:var(--font-sans); color:#444; line-height:1.7;">
      {isCompleted && hasFight ? (
        <p>
          <strong style="font-family:var(--font-display);color:#111;">{event.name}</strong> se celebró el <strong>{event.dateLabel}</strong> en <strong>{event.loc}</strong>.
          La pelea principal enfrentó a <strong>{f1}</strong> contra <strong>{f2}</strong>
          {isPPV ? ' en una noche de PPV.' : ' en un Fight Night.'}
          {' '}Consulta la cartelera completa y los artículos relacionados en Quimbara.
        </p>
      ) : hasFight ? (
        <p>
          <strong style="font-family:var(--font-display);color:#111;">{event.name}</strong> se celebrará el <strong>{event.dateLabel}</strong> en <strong>{event.loc}</strong>.
          La pelea principal del evento enfrenta a <strong>{f1}</strong> contra <strong>{f2}</strong> en lo que promete ser
          {isPPV ? ' una noche de PPV de primer nivel.' : ' un emocionante Fight Night.'}
          {' '}Sigue la cobertura completa en Quimbara: análisis tácticos, predicciones y crónica del evento.
        </p>
      ) : (
        <p>
          <strong style="font-family:var(--font-display);color:#111;">{event.name}</strong> está programado para el <strong>{event.dateLabel}</strong>
          en <strong>{event.loc}</strong>. El cartel completo será anunciado por la UFC próximamente.
          Esta página se actualiza automáticamente cada lunes con la información más reciente.
        </p>
      )}
    </div>
  </section>

  <!-- ── Artículos relacionados ── -->
  <section style={`max-width:1400px; margin:0 auto; padding: 50px ${PX} 0;`}>
    <div class="flex items-baseline justify-between mb-6 flex-wrap gap-3">
      <h2 style="font-family:var(--font-display);font-size:clamp(1.5rem,4vw,2.2rem);color:#111;">{articlesLabel}</h2>
      <a href="/blog" class="text-sm font-bold uppercase tracking-widest text-gray-400 hover:text-[#111] transition-colors" style="font-family:var(--font-sans);">Ver todos →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {articles.map(a => <ArticleCard article={a} variant="default" />)}
    </div>
  </section>

  <!-- ── Otros eventos próximos ── -->
  {otherEvents.length > 0 && (
    <section style={`max-width:1400px; margin:0 auto; padding: 50px ${PX} 60px;`}>
      <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-5" style="font-family:var(--font-sans);">Otros eventos próximos</h2>
      <div class="flex flex-col gap-2">
        {otherEvents.map(e => (
          <a href={`/eventos/${e.slug}`}
             class="group flex items-center gap-5 p-4 rounded-xl hover:bg-[#111] transition-colors duration-200">
            <div class="flex-shrink-0 text-center w-12">
              <div class="text-[10px] font-bold uppercase tracking-widest text-gray-400 group-hover:text-gray-500" style="font-family:var(--font-sans);">{e.dateLabel.split(' ')[1]?.toUpperCase()}</div>
              <div class="text-2xl font-black text-[#111] group-hover:text-white leading-none" style="font-family:var(--font-display);">{e.dateLabel.split(' ')[0]}</div>
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-[10px] font-bold uppercase tracking-widest text-gray-400 group-hover:text-gray-500 mb-0.5" style="font-family:var(--font-sans);">{e.name}</div>
              <div class="text-[#111] group-hover:text-white font-bold text-sm truncate" style="font-family:var(--font-display);">{e.main}</div>
            </div>
            <div class="text-gray-200 group-hover:text-[#F2D928] text-lg">→</div>
          </a>
        ))}
      </div>
    </section>
  )}

</BaseLayout>
