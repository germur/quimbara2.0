---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import RoundProgress from '../../components/RoundProgress.astro';
import ComparadorEmbebido from '../../components/ComparadorEmbebido.astro';
import CaminoDelPeleador from '../../components/CaminoDelPeleador.astro';
import { getPeleador } from '../../lib/peleadores';
import FIGHTERS from '../../data/fighters.json';
import { getCollection } from 'astro:content';
// @ts-ignore — módulo JS compartido con astro.config.mjs y scripts/
import { isIndexable } from '../../lib/indexable.mjs';

// Campos opcionales de contenido enriquecido (densificación SEO)
type FighterEnriched = {
  /** 'pro' cuando fix-records.mjs confirmó el récord pro completo desde UFC.com */
  recScope?: string;
  bio?: string;
  style?: {
    striking?: string;
    grappling?: string;
    fortalezas?: string[];
    vulnerabilidades?: string[];
  };
  proximaPelea?: { evento?: string; rival?: string; fecha?: string; eventSlug?: string; };
  trayectoria?: string;
  faq?: Array<{ q: string; a: string }>;
  metaTitle?: string;
  metaDescription?: string;
};

export function getStaticPaths() {
  return FIGHTERS.map((f) => ({ params: { slug: f.slug }, props: { fighter: f } }));
}

const { fighter: f } = Astro.props as { fighter: typeof FIGHTERS[0] & FighterEnriched };

// Versión derivada (métrico, ape index, rareza) para el comparador embebido.
// null si el peleador no es comparable — entonces el módulo no se renderiza.
const peleadorDerivado = getPeleador(f.slug);

/**
 * Los rankeados tienen carta, y su OG image ES la carta: cuando alguien
 * comparte esta ficha en WhatsApp o Twitter aparece la carta del peleador.
 * Es la razón por la que /cartas/{slug}/ puede ir noindex sin perder nada.
 * Los no rankeados caen a su foto.
 */
const tieneCarta = peleadorDerivado?.ranking != null;
const ogCarta = tieneCarta
  ? `/og/cartas/${f.slug}.png`
  : (f.img || '/default-og.jpg');
const PX = 'clamp(16px,4vw,60px)';

// ─── Helpers de conversión (imperial → métrico) para long-tail físico ───
function heightToCm(h: string): number | null {
  const m = h?.match(/(\d+)'\s*(\d+)/);
  if (!m) return null;
  return Math.round((+m[1]) * 30.48 + (+m[2]) * 2.54);
}
function inchesToCm(r: string): number | null {
  const m = r?.match(/(\d+)/);
  if (!m) return null;
  return Math.round((+m[1]) * 2.54);
}
function lbsToKg(w: string): number | null {
  const m = w?.match(/(\d+)/);
  if (!m) return null;
  return Math.round((+m[1]) * 0.4536);
}
const heightCm  = f.height ? heightToCm(f.height) : null;
const reachCm   = f.reach  ? inchesToCm(f.reach)  : null;
const weightKg  = f.weight ? lbsToKg(f.weight)    : null;

// ─── Estado: campeón / ranqueado / no ranqueado ───
const isChampion = f.rank === 'C';
const isRanked   = !!f.rank && f.rank !== 'C';
const roleLabel  = (isChampion ? `Campeón UFC ${f.div}`
                 : isRanked   ? `#${f.rank} UFC ${f.div}`
                 : `Peleador UFC ${f.div}`).trim(); // .trim(): hay fighters sin división en el CSV

// Buscar artículos relacionados: nombre o apellido del peleador en título o descripción
const allPosts = await getCollection('blog');
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const lastName  = f.name.split(' ').slice(-1)[0].toLowerCase();
const firstName = f.name.split(' ')[0].toLowerCase();
const nick      = f.nick?.toLowerCase() ?? '';

const related = allPosts.filter(p => {
  const haystack = `${p.data.title} ${p.data.description ?? ''}`.toLowerCase();
  return haystack.includes(lastName) || haystack.includes(firstName) || (nick && haystack.includes(nick));
});

// Si hay relacionados los usamos; si no, los 3 más recientes como fallback
const hasRelated  = related.length > 0;
const articlesToShow = hasRelated ? related.slice(0, 3) : allPosts.slice(0, 3);

const initials = f.name.split(' ').slice(0, 2).map((n: string) => n[0]).join('');
const [wins, losses, draws] = f.rec !== '—' ? f.rec.split('-').map(Number) : [0, 0, 0];
const totalFights = wins + losses + (draws || 0);
const winPct = totalFights > 0 ? Math.round((wins / totalFights) * 100) : 0;

// ─── Récord: pro completo (UFC.com vía fix-records) vs solo-UFC (CSV) ───
// Etiquetar mal esto es un problema de E-E-A-T: solo decimos "profesional"
// cuando fix-records.mjs lo confirmó (recScope === 'pro').
const recIsPro = f.recScope === 'pro';
const recLabel = recIsPro ? 'Récord profesional' : 'Récord UFC';

const physicals = [
  { label: 'Récord UFC', value: recIsPro && f.ufcRec && f.ufcRec !== f.rec ? f.ufcRec : '', icon: '🥋' },
  { label: 'Altura',  value: heightCm ? `${heightCm} cm · ${f.height}` : f.height,  icon: '↕' },
  { label: 'Peso',    value: weightKg ? `${weightKg} kg · ${f.weight}` : f.weight,  icon: '⚖' },
  { label: 'Alcance', value: reachCm  ? `${reachCm} cm · ${f.reach}`   : f.reach,   icon: '↔' },
  { label: 'Guardia', value: f.stance,  icon: '🥊' },
  { label: 'Gym',     value: f.team,    icon: '🏛' },
  { label: 'País',    value: f.from,    icon: '🌍' },
].filter(p => p.value);

const form: string[] = f.form ?? [];
const formTypes: { outcome: string; winType: string }[] = f.formTypes ?? [];

const WIN_TYPE_LABEL: Record<string, string> = {
  KO: 'KO', TKO: 'TKO', SUB: 'Sub', UD: 'Dec', SD: 'Dec', MD: 'Dec',
  DQ: 'DQ', NC: 'NC',
};
const WIN_TYPE_COLOR: Record<string, string> = {
  KO: '#E53935', TKO: '#E53935', SUB: '#7B1FA2',
  UD: '#1565C0', SD: '#1565C0', MD: '#1565C0',
  DQ: '#555', NC: '#555',
};

const siteUrl = 'https://quimbara.org';
const canonicalUrl = `${siteUrl}/peleadores/${f.slug}/`;

// Schema Person (tripleta semántica: peleador → récord, división, nacionalidad)
const personSchema: any = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": f.name,
  "alternateName": f.nick || undefined,
  "url": canonicalUrl,
  "image": f.img ? new URL(f.img, siteUrl).href : undefined,
  "nationality": f.from || undefined,
  // Valores numéricos en métrico con unitCode UN/CEFACT (CMT = cm, KGM = kg):
  // así Google puede entender "180 cm" como cantidad, no como string imperial.
  "height": heightCm
    ? { "@type": "QuantitativeValue", "value": heightCm, "unitCode": "CMT", "description": f.height }
    : (f.height ? { "@type": "QuantitativeValue", "value": f.height } : undefined),
  "weight": weightKg
    ? { "@type": "QuantitativeValue", "value": weightKg, "unitCode": "KGM", "description": f.weight }
    : (f.weight ? { "@type": "QuantitativeValue", "value": f.weight } : undefined),
  "memberOf": {
    "@type": "SportsOrganization",
    "name": "UFC",
    "url": "https://www.ufc.com"
  },
  "description": `${f.name}${f.nick ? ` "${f.nick}"` : ''} es ${isChampion ? 'el actual ' : 'un '}${roleLabel.toLowerCase()} con récord de ${f.rec}. ${f.from ? `De ${f.from}.` : ''} ${f.stance ? `Guardia ${f.stance}.` : ''} ${f.team ? `Equipo: ${f.team}.` : ''}`.trim(),
  "knowsAbout": ["MMA", "UFC", f.div, "Artes Marciales Mixtas"]
};
if (isChampion) personSchema.award = `Campeón UFC ${f.div}`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Peleadores", "item": `${siteUrl}/peleadores/` },
    { "@type": "ListItem", "position": 3, "name": f.name, "item": canonicalUrl }
  ]
};

// ─── FAQ: manual (overrides) o auto-generada desde los datos ───
// Las queries GSC con más impresiones son "¿cuánto mide X?" / "alcance de X":
// si no hay FAQ manual, se genera una biométrica con los datos reales.
const autoFaq: Array<{ q: string; a: string }> = [];
if (heightCm) {
  autoFaq.push({
    q: `¿Cuánto mide ${f.name}?`,
    a: `${f.name}${f.nick ? ` "${f.nick}"` : ''} mide <strong>${heightCm} cm (${f.height})</strong> de estatura.${reachCm ? ` Su alcance de brazos es de ${reachCm} cm (${f.reach}).` : ''}`
  });
}
if (reachCm) {
  autoFaq.push({
    q: `¿Cuál es el alcance de ${f.name}?`,
    a: `El alcance de ${f.name} es de <strong>${reachCm} cm (${f.reach})</strong>.${heightCm ? ` Con ${heightCm} cm de estatura, su ratio alcance/altura es clave en su estilo de pelea.` : ''}`
  });
}
if (f.rec && f.rec !== '—' && totalFights > 0) {
  autoFaq.push({
    q: `¿Cuál es el récord de ${f.name}?`,
    a: `Su ${recLabel.toLowerCase()} es de <strong>${wins} victorias, ${losses} derrotas${draws ? ` y ${draws} empates` : ''}</strong> (${f.rec}), con una tasa de victoria del ${winPct}%.`
  });
}
if (f.div) {
  autoFaq.push({
    q: `¿En qué división pelea ${f.name}?`,
    a: `${f.name} compite en <strong>UFC ${f.div}</strong>${isChampion ? ' y es el actual <strong>campeón</strong> de la división' : isRanked ? ` donde ocupa el puesto <strong>#${f.rank}</strong> del ranking` : ''}${weightKg ? `, con un peso de combate de ${weightKg} kg (${f.weight})` : ''}.`
  });
}

const faqToShow: Array<{ q: string; a: string }> =
  (f.faq && f.faq.length > 0) ? f.faq : autoFaq;

// FAQ schema (manual o auto)
const faqSchema = faqToShow.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqToShow.map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": { "@type": "Answer", "text": a.replace(/<[^>]+>/g, '') }
  }))
} : null;

const schemas = [personSchema, breadcrumbSchema, faqSchema].filter(Boolean);
const fighterSchema = JSON.stringify(schemas);

// ─── Title/meta formula (override por-fighter o auto) ───
// GSC: las queries reales son "cuánto mide X" / "estatura de X" / "alcance de X".
// El title ataca esa intención con cm PRIMERO (audiencia hispana busca en métrico).
const heightForMeta = heightCm ? `${heightCm} cm (${f.height})` : f.height;
const reachForMeta  = reachCm  ? `${reachCm} cm (${f.reach})`  : f.reach;

const metaTitle = f.metaTitle
  ?? (isChampion && heightCm
      ? `${f.name}: Campeón UFC ${f.div} · estatura (${heightCm} cm), alcance y récord`
      : heightCm
      ? `${f.name}: estatura (${heightCm} cm), alcance, récord y próxima pelea`
      : `${f.name}${f.nick ? ` "${f.nick}"` : ''} · ${roleLabel} · Récord ${f.rec}`);

// Description con la respuesta directa al principio (fórmula featured-snippet)
const metaDescription = f.metaDescription
  ?? (heightCm
      ? `${f.name}${f.nick ? ` "${f.nick}"` : ''} mide ${heightForMeta} de estatura${reachForMeta ? ` y tiene un alcance de ${reachForMeta}` : ''}. ${roleLabel}, ${recLabel.toLowerCase()} ${f.rec}. Estilo, datos físicos y próxima pelea en Quimbara.`
      : `Perfil de ${f.name}${f.nick ? ` "${f.nick}"` : ''}, ${roleLabel}. ${recLabel} ${f.rec}. Análisis de estilo, datos físicos y próxima pelea en Quimbara.`);
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonicalUrl={canonicalUrl}
  ogImage={ogCarta}
  schema={fighterSchema}
  noIndex={!isIndexable(f)}
>
  <!-- Round counter — 5 rounds para campeones (main event), 3 para resto -->
  <RoundProgress slot="progress-bar" mainEvent={f.rank === 'C'} />

  <!-- ── Hero ── -->
  <div class="relative overflow-hidden" style="background:#111; min-height: 380px;">

    <!-- Inicial gigante de fondo -->
    <div class="absolute inset-0 flex items-end justify-end pointer-events-none select-none overflow-hidden">
      <span style="font-family:var(--font-display);font-size:clamp(200px,35vw,400px);opacity:0.04;color:#fff;line-height:0.85;margin-right:-20px;">
        {f.name.split(' ').slice(-1)[0]?.[0]}
      </span>
    </div>

    <div style={`max-width:1400px; margin:0 auto; padding: 50px ${PX} 50px; position:relative;`}>

      <!-- Nav -->
      <a href="/"
         class="text-gray-500 hover:text-[#F2D928] text-[11px] font-bold uppercase tracking-widest transition-colors mb-10 inline-block"
         style="font-family:var(--font-sans);">← Inicio</a>

      <div class="flex flex-col md:flex-row md:items-end gap-6 md:gap-10">

        <!-- Foto -->
        <div class="relative flex-shrink-0">
          <div class="rounded-2xl overflow-hidden border-4 border-[#F2D928] flex items-center justify-center bg-gray-800"
               style="width:clamp(90px,15vw,140px);height:clamp(90px,15vw,140px);">
            {f.img ? (
              <img src={f.img} alt={f.name} class="w-full h-full object-cover" />
            ) : (
              <span class="text-white font-black select-none"
                    style="font-family:var(--font-display);font-size:clamp(28px,5vw,48px);">{initials}</span>
            )}
          </div>
          {isChampion && (
            <div class="absolute -bottom-2 -right-2 bg-[#F2D928] text-[#111] text-[9px] font-black uppercase tracking-widest px-2 py-1 rounded-md"
                 style="font-family:var(--font-sans);">Campeón</div>
          )}
          {isRanked && (
            <div class="absolute -bottom-2 -right-2 bg-white text-[#111] text-[9px] font-black uppercase tracking-widest px-2 py-1 rounded-md border border-gray-200"
                 style="font-family:var(--font-sans);">#{f.rank}</div>
          )}
        </div>

        <!-- Nombre -->
        <div class="pb-1">
          <div class="inline-block px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest rounded-sm border border-gray-600 text-gray-400 mb-3"
               style="font-family:var(--font-sans);">{f.div}</div>
          <h1 class="text-white leading-none"
              style="font-family:var(--font-display);font-size:clamp(2.2rem,7vw,5rem);">
            {f.name}
          </h1>
          {f.nick && (
            <div class="text-[#F2D928] text-xl italic mt-2" style="font-family:var(--font-serif);">
              "{f.nick}"
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- ── Récord ── -->
  <div style="background:#F2D928;">
    <div style={`max-width:1400px; margin:0 auto; padding: 28px ${PX};`}>
      <div class="grid grid-cols-4 gap-4 items-center">
        <!-- Wins -->
        <div class="text-center">
          <div class="font-black text-[#111] leading-none"
               style="font-family:var(--font-display);font-size:clamp(2.5rem,8vw,5rem);">{wins}</div>
          <div class="text-[10px] font-bold uppercase tracking-widest text-[#111]/50 mt-1"
               style="font-family:var(--font-sans);">Victorias</div>
        </div>
        <!-- Losses -->
        <div class="text-center">
          <div class="font-black text-[#111] leading-none"
               style="font-family:var(--font-display);font-size:clamp(2.5rem,8vw,5rem);">{losses}</div>
          <div class="text-[10px] font-bold uppercase tracking-widest text-[#111]/50 mt-1"
               style="font-family:var(--font-sans);">Derrotas</div>
        </div>
        <!-- Draws -->
        <div class="text-center">
          <div class="font-black text-[#111] leading-none"
               style="font-family:var(--font-display);font-size:clamp(2.5rem,8vw,5rem);">{draws || 0}</div>
          <div class="text-[10px] font-bold uppercase tracking-widest text-[#111]/50 mt-1"
               style="font-family:var(--font-sans);">Empates</div>
        </div>
        <!-- Win % -->
        <div class="text-center border-l-2 border-[#111]/10 pl-4">
          <div class="font-black text-[#111] leading-none"
               style="font-family:var(--font-display);font-size:clamp(2.5rem,8vw,5rem);">{winPct}<span style="font-size:0.4em;">%</span></div>
          <div class="text-[10px] font-bold uppercase tracking-widest text-[#111]/50 mt-1"
               style="font-family:var(--font-sans);">Tasa victoria</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Datos físicos ── -->
  {physicals.length > 0 && (
    <section style={`max-width:1400px; margin:0 auto; padding: 50px ${PX} 60px;`}>
      <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-8"
          style="font-family:var(--font-sans);">Perfil atlético</h2>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-px bg-gray-100 rounded-xl overflow-hidden border border-gray-100">
        {physicals.map(({ label, value, icon }) => (
          <div class="bg-white px-6 py-5 group hover:bg-[#111] transition-colors duration-200">
            <div class="text-[10px] font-bold uppercase tracking-widest text-gray-400 group-hover:text-gray-600 mb-2"
                 style="font-family:var(--font-sans);">{label}</div>
            <div class="text-[#111] font-black text-xl group-hover:text-white leading-tight"
                 style="font-family:var(--font-display);">{value}</div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ── Enlace a la carta ── -->
  {tieneCarta && (
    <div style={`max-width:1400px; margin:0 auto; padding: 0 ${PX};`}>
      <a href={`/cartas/${f.slug}/`}
         class="group flex items-center justify-between gap-4 rounded-xl px-5 py-4 mt-8 transition-transform hover:-translate-y-0.5"
         style="background:#0A0A0B;">
        <div>
          <div class="text-[9px] font-black uppercase tracking-[0.22em] text-[#F2D928]"
               style="font-family:var(--font-mono);">
            Carta {peleadorDerivado!.rareza}
          </div>
          <div class="text-base font-black text-[#F4F2EC] leading-tight mt-1"
               style="font-family:var(--font-display);">
            Descargá la carta de {f.name}
          </div>
        </div>
        <span class="text-xl font-black text-[#F2D928] flex-shrink-0 transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>
  )}

  <!-- ── Comparador embebido ──
       Va justo después de los datos físicos: es donde aterriza quien buscó
       "cuánto mide {peleador}", y convierte ese dato muerto en navegación. -->
  {peleadorDerivado && (
    <div style={`max-width:1400px; margin:0 auto; padding: 0 ${PX};`}>
      <ComparadorEmbebido peleador={peleadorDerivado} />
    </div>
  )}

  <!-- ── Camino del Peleador: el récord completo como timeline ──
       Va arriba de "Forma reciente" porque la contiene: la forma son las
       últimas 5, el camino es la carrera entera. -->
  <div style={`max-width:1400px; margin:0 auto; padding: 0 ${PX};`}>
    <CaminoDelPeleador slug={f.slug} nombre={f.name} />
  </div>

  <!-- ── Forma reciente ── -->
  {form.length > 0 && (
    <section style={`max-width:1400px; margin:0 auto; padding: 0 ${PX} 60px;`}>
      <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-8"
          style="font-family:var(--font-sans);">Forma reciente</h2>

      <div class="flex gap-3 flex-wrap">
        {formTypes.slice(0, 5).map((ft, i) => {
          const isWin = ft.outcome === 'W';
          const label = WIN_TYPE_LABEL[ft.winType] ?? ft.winType;
          const color = isWin ? (WIN_TYPE_COLOR[ft.winType] ?? '#111') : '#9e9e9e';
          return (
            <div class="flex flex-col items-center gap-1">
              <div class="w-12 h-12 rounded-full flex items-center justify-center font-black text-white text-sm"
                   style={`background:${color}; font-family:var(--font-display);`}>
                {ft.outcome}
              </div>
              <span class="text-[9px] font-bold uppercase tracking-widest text-gray-400"
                    style="font-family:var(--font-sans);">{label}</span>
            </div>
          );
        })}
      </div>

      <p class="text-[10px] text-gray-400 mt-4" style="font-family:var(--font-sans);">
        Últimas {form.length} peleas · de más reciente a más antigua
      </p>
    </section>
  )}

  <!-- ══════════════════════════════════════════════════════════════ -->
  <!-- ═══ SECCIONES ENRIQUECIDAS (solo se renderizan si hay data) ═ -->
  <!-- ══════════════════════════════════════════════════════════════ -->

  <!-- ── ¿Quién es? (bio) ── -->
  {f.bio && (
    <section style={`max-width:1400px; margin:0 auto; padding: 0 ${PX} 60px;`}>
      <h2 class="text-2xl md:text-3xl mb-5 text-[#111]"
          style="font-family:var(--font-display);">¿Quién es {f.name}?</h2>
      <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed"
           style="font-family:var(--font-sans);"
           set:html={f.bio} />
    </section>
  )}

  <!-- ── Datos físicos en texto (long-tail "estatura/altura") ── -->
  {(heightCm || reachCm) && (
    <section style={`max-width:1400px; margin:0 auto; padding: 0 ${PX} 60px;`}>
      <h2 class="text-2xl md:text-3xl mb-5 text-[#111]"
          style="font-family:var(--font-display);">Estatura, alcance y datos físicos de {f.name}</h2>
      <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed"
           style="font-family:var(--font-sans);">
        <p>
          {f.name}{f.nick ? ` "${f.nick}"` : ''} mide
          {heightCm && (<><strong> {heightCm} cm ({f.height})</strong> de estatura</>)}
          {reachCm && (<>{heightCm ? ' y tiene un alcance de ' : ' tiene un alcance de '}<strong>{reachCm} cm ({f.reach})</strong></>)}.
          {f.stance && (<> Pelea en guardia <strong>{f.stance}</strong>.</>)}
          {f.weight && (<> Compite en la división <strong>UFC {f.div}</strong> con un peso de combate de <strong>{weightKg ? `${weightKg} kg (${f.weight})` : f.weight}</strong>.</>)}
        </p>
        <table class="mt-4">
          <tbody>
            {heightCm && (<tr><th scope="row" style="text-align:left;padding-right:1.5rem;">Estatura</th><td>{heightCm} cm ({f.height})</td></tr>)}
            {reachCm && (<tr><th scope="row" style="text-align:left;padding-right:1.5rem;">Alcance</th><td>{reachCm} cm ({f.reach})</td></tr>)}
            {weightKg && (<tr><th scope="row" style="text-align:left;padding-right:1.5rem;">Peso de combate</th><td>{weightKg} kg ({f.weight})</td></tr>)}
            {f.stance && (<tr><th scope="row" style="text-align:left;padding-right:1.5rem;">Guardia</th><td>{f.stance}</td></tr>)}
            {f.div && (<tr><th scope="row" style="text-align:left;padding-right:1.5rem;">División</th><td>UFC {f.div}</td></tr>)}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- ── Estilo de pelea ── -->
  {f.style && (
    <section style={`max-width:1400px; margin:0 auto; padding: 0 ${PX} 60px;`}>
      <h2 class="text-2xl md:text-3xl mb-5 text-[#111]"
          style="font-family:var(--font-display);">Estilo de pelea de {f.name}</h2>

      {f.style.striking && (
        <div class="mb-6">
          <h3 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-3"
              style="font-family:var(--font-sans);">Striking</h3>
          <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed"
               style="font-family:var(--font-sans);" set:html={f.style.striking} />
        </div>
      )}

      {f.style.grappling && (
        <div class="mb-6">
          <h3 class="text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-3"
              style="font-family:var(--font-sans);">Grappling y Wrestling</h3>
          <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed"
               style="font-family:var(--font-sans);" set:html={f.style.grappling} />
        </div>
      )}

      {(f.style.fortalezas && f.style.fortalezas.length > 0) && (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
          <div class="bg-green-50 border border-green-200 rounded-xl p-5">
            <h3 class="text-[11px] font-bold uppercase tracking-widest text-green-800 mb-3"
                style="font-family:var(--font-sans);">Fortalezas</h3>
            <ul class="space-y-2 text-gray-800" style="font-family:var(--font-sans);">
              {f.style.fortalezas.map(it => <li class="flex gap-2"><span class="text-green-600">✓</span><span>{it}</span></li>)}
            </ul>
          </div>
          {f.style.vulnerabilidades && f.style.vulnerabilidades.length > 0 && (
            <div class="bg-red-50 border border-red-200 rounded-xl p-5">
              <h3 class="text-[11px] font-bold uppercase tracking-widest text-red-800 mb-3"
                  style="font-family:var(--font-sans);">Vulnerabilidades</h3>
                            <ul class="space-y-2 text-gray-800" style="font-family:var(--font-sans);">
                {f.style.vulnerabilidades.map(it => <li class="flex gap-2"><span class="text-red-600">✗</span><span>{it}</span></li>)}
              </ul>
            </div>
          )}
        </div>
      )}
    </section>
  )}

  <!-- ── Próxima pelea confirmada ── -->
  {f.proximaPelea && f.proximaPelea.rival && (
    <section style={`max-width:1400px; margin:0 auto; padding: 0 ${PX} 60px;`}>
      <h2 class="text-2xl md:text-3xl mb-5 text-[#111]"
          style="font-family:var(--font-display);">Próxima pelea de {f.name}</h2>
      <div class="bg-[#111] text-white rounded-2xl p-6 md:p-8"
           style="font-family:var(--font-sans);">
        <div class="text-[#F2D928] text-[10px] font-bold uppercase tracking-widest mb-2">
          {f.proximaPelea.evento ?? 'Próximo combate'}
        </div>
        <div class="text-2xl md:text-3xl font-black mb-3"
             style="font-family:var(--font-display);">
          {f.name} vs. {f.proximaPelea.rival}
        </div>
        {f.proximaPelea.fecha && (
          <div class="text-gray-400 mb-4">{f.proximaPelea.fecha}</div>
        )}
        {f.proximaPelea.eventSlug && (
          <a href={`/eventos/${f.proximaPelea.eventSlug}/`}
             class="inline-block bg-[#F2D928] text-[#111] font-bold text-sm px-5 py-2.5 rounded-md hover:bg-yellow-300 transition-colors">
            Ver cartelera completa →
          </a>
        )}
      </div>
    </section>
  )}

  <!-- ── Trayectoria ── -->
  {f.trayectoria && (
    <section style={`max-width:1400px; margin:0 auto; padding: 0 ${PX} 60px;`}>
      <h2 class="text-2xl md:text-3xl mb-5 text-[#111]"
          style="font-family:var(--font-display);">Trayectoria de {f.name} en UFC</h2>
      <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed"
           style="font-family:var(--font-sans);" set:html={f.trayectoria} />
    </section>
  )}

  <!-- ── FAQ (con FAQPage schema; manual o auto-generada desde datos) ── -->
  {faqToShow.length > 0 && (
    <section style={`max-width:1400px; margin:0 auto; padding: 0 ${PX} 60px;`}>
      <h2 class="text-2xl md:text-3xl mb-5 text-[#111]"
          style="font-family:var(--font-display);">Preguntas frecuentes sobre {f.name}</h2>
      <div class="space-y-3" style="font-family:var(--font-sans);">
        {faqToShow.map(({ q, a }) => (
          <details class="group bg-gray-50 rounded-xl border border-gray-200 overflow-hidden">
            <summary class="cursor-pointer list-none px-5 py-4 font-bold text-[#111] flex items-center justify-between hover:bg-gray-100 transition-colors">
              <span>{q}</span>
              <span class="text-gray-400 group-open:rotate-180 transition-transform">▾</span>
            </summary>
            <div class="px-5 pb-4 text-gray-700 leading-relaxed" set:html={a} />
          </details>
        ))}
      </div>
    </section>
  )}

  <!-- ── Artículos relacionados ── -->
  <section style={`padding: 0 ${PX} 70px;`}>
    <div style="max-width:1400px; margin:0 auto;">

      <div class="flex items-baseline justify-between mb-6 flex-wrap gap-3">
        <h2 style="font-family:var(--font-display);font-size:clamp(1.5rem,4vw,2.5rem);color:#111;">
          {hasRelated
            ? `Artículos sobre ${f.name.split(' ')[0]}`
            : 'También te puede interesar'}
        </h2>
        <a href="/blog"
           class="text-sm font-bold uppercase tracking-widest text-gray-400 hover:text-[#111] transition-colors"
           style="font-family:var(--font-sans);">
          Ver todos →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {articlesToShow.map(a => <ArticleCard article={a} variant="default" />)}
      </div>

    </div>
  </section>

</BaseLayout>
