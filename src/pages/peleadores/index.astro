---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FIGHTERS from '../../data/fighters.json';

const PX = 'clamp(16px,4vw,60px)';
const siteUrl = 'https://quimbara.org';

const divOrder = [
  'Heavyweight', 'Light Heavyweight', 'Middleweight',
  'Welterweight', 'Lightweight', 'Featherweight',
  'Bantamweight', 'Flyweight',
];

const divLabels: Record<string, string> = {
  'Heavyweight':       'Peso Pesado',
  'Light Heavyweight': 'Semipesado',
  'Middleweight':      'Peso Medio',
  'Welterweight':      'Wélter',
  'Lightweight':       'Ligero',
  'Featherweight':     'Pluma',
  'Bantamweight':      'Gallo',
  'Flyweight':         'Mosca',
};

type Fighter = typeof FIGHTERS[number];
const byDiv: Record<string, Fighter[]> = {};
for (const f of FIGHTERS) {
  if (!byDiv[f.div]) byDiv[f.div] = [];
  byDiv[f.div].push(f);
}
for (const div of Object.keys(byDiv)) {
  byDiv[div].sort((a, b) => {
    if (a.rank === 'C') return -1;
    if (b.rank === 'C') return 1;
    return Number(a.rank) - Number(b.rank);
  });
}
const divisions = divOrder.filter(d => byDiv[d]?.length);

const WIN_BG: Record<string, string> = {
  KO: '#E53935', TKO: '#E53935', SUB: '#7B1FA2',
  UD: '#111', SD: '#111', MD: '#111',
};
---

<BaseLayout
  title="Peleadores UFC 2026 · Campeones y Contenders por División"
  description="Directorio de peleadores UFC 2026 por división: campeones, top 5 contenders, récords y forma reciente. Quimbara."
  canonicalUrl={`${siteUrl}/peleadores/`}
>

  <!-- ── Hero ── -->
  <div style={`background:#111; padding: 70px ${PX} 60px;`}>
    <div style="max-width:1400px; margin:0 auto;">
      <span class="inline-block px-3 py-1 text-[11px] font-bold uppercase tracking-widest rounded-sm bg-[#FFD600] text-[#111] mb-6"
            style="font-family:var(--font-sans);">UFC 2026</span>
      <h1 style="font-family:var(--font-display);font-size:clamp(3rem,10vw,7rem);line-height:0.95;color:#fff;">
        Pelead<span style="color:#FFD600;">ores</span>
      </h1>
      <p class="text-gray-400 mt-5 text-sm" style="font-family:var(--font-sans);">
        {FIGHTERS.length} peleadores · Campeones + Top 5 por división
      </p>
    </div>
  </div>

  <!-- ── Tabs de división ── -->
  <div class="bg-white border-b border-gray-200 sticky top-16 z-40">
    <div style={`max-width:1400px; margin:0 auto; padding: 0 ${PX}; overflow-x:auto;`}>
      <div class="flex gap-0" id="div-tabs" style="min-width:max-content;">
        {divisions.map((div, i) => (
          <button
            data-div={div}
            class:list={['div-tab px-5 py-4 text-[11px] font-bold uppercase tracking-widest transition-all duration-200 whitespace-nowrap border-b-2',
              i === 0
                ? 'text-[#111] border-[#111]'
                : 'text-gray-400 border-transparent hover:text-[#111]'
            ]}
            style="font-family:var(--font-sans);"
          >
            {divLabels[div] ?? div}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- ── Contenido por división ── -->
  <div style={`max-width:1400px; margin:0 auto; padding: 50px ${PX} 80px;`}>
    {divisions.map((div, divIdx) => (
      <div class="div-section" data-div={div} style={divIdx > 0 ? 'display:none;' : ''}>

        {byDiv[div].map((f) => {
          const isChamp = f.rank === 'C';
          const initials = f.name.split(' ').slice(0, 2).map((n: string) => n[0]).join('');

          return isChamp ? (
            /* ── Card campeón — horizontal con foto grande ── */
            <a href={`/peleadores/${f.slug}`}
               class="group flex flex-col md:flex-row gap-0 rounded-lg overflow-hidden mb-8 border border-gray-100 transition-all duration-300 hover:shadow-xl hover:border-gray-200"
               style="background:#fff;">

              {/* Foto */}
              <div class="relative md:w-64 flex-shrink-0 bg-gray-100 overflow-hidden" style="min-height:260px;">
                {f.img ? (
                  <img src={f.img} alt={f.name}
                       class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                       loading="eager" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center">
                    <span class="text-gray-300 text-6xl font-black" style="font-family:var(--font-display);">{initials}</span>
                  </div>
                )}
              </div>

              {/* Info */}
              <div class="flex flex-col justify-center p-6 md:p-8 flex-1 border-l border-gray-100">
                <div class="flex items-center gap-3 mb-4 flex-wrap">
                  <span class="px-3 py-1 text-[10px] font-black uppercase tracking-widest rounded-sm bg-[#FFD600] text-[#111]"
                        style="font-family:var(--font-sans);">Campeón</span>
                  <span class="text-[11px] font-bold uppercase tracking-widest text-gray-400"
                        style="font-family:var(--font-sans);">{divLabels[div] ?? div}</span>
                </div>

                <h2 class="text-[#111] leading-none group-hover:text-[#E53935] transition-colors duration-200"
                    style="font-family:var(--font-display);font-size:clamp(1.8rem,4vw,3rem);">{f.name}</h2>

                {f.nick?.trim() && (
                  <div class="text-gray-400 text-base italic mt-1" style="font-family:var(--font-serif);">"{f.nick.trim()}"</div>
                )}

                <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mt-6 pt-6 border-t border-gray-100">
                  <div>
                    <div class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-1" style="font-family:var(--font-sans);">Récord</div>
                    <div class="text-[#111] font-black text-2xl" style="font-family:var(--font-display);">{f.rec}</div>
                  </div>
                  <div>
                    <div class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-1" style="font-family:var(--font-sans);">País</div>
                    <div class="text-[#111] font-semibold text-sm" style="font-family:var(--font-sans);">{f.from || '—'}</div>
                  </div>
                  {(f.formTypes ?? []).length > 0 && (
                    <div>
                      <div class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2" style="font-family:var(--font-sans);">Últimas peleas</div>
                      <div class="flex gap-1.5">
                        {(f.formTypes ?? []).slice(0, 5).map((ft: {outcome: string; winType: string}) => {
                          const isLoss = ft.outcome === 'L';
                          const isDraw = ft.outcome === 'D';
                          const bg = isLoss ? '#fff' : isDraw ? '#9ca3af' : (WIN_BG[ft.winType] ?? '#111');
                          const color = isLoss ? '#E53935' : '#fff';
                          const border = isLoss ? '1.5px solid #E53935' : `1.5px solid ${bg}`;
                          return (
                            <div class="w-7 h-7 rounded-full flex items-center justify-center text-[9px] font-black"
                                 style={`background:${bg}; color:${color}; border:${border};`}>
                              {ft.outcome}
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </a>
          ) : (
            /* ── Fila contender — tabla limpia ── */
            <a href={`/peleadores/${f.slug}`}
               class="group flex items-center gap-4 px-4 py-3 border-b border-gray-100 transition-colors duration-200 hover:bg-gray-50">

              {/* Rank */}
              <div class="text-gray-300 font-black text-sm w-6 text-center flex-shrink-0"
                   style="font-family:var(--font-display);">#{f.rank}</div>

              {/* Avatar */}
              <div class="w-10 h-10 rounded-full overflow-hidden flex-shrink-0 bg-gray-100 flex items-center justify-center border border-gray-200">
                {f.img ? (
                  <img src={f.img} alt={f.name} class="w-full h-full object-cover object-top" loading="lazy" />
                ) : (
                  <span class="text-gray-400 text-xs font-black" style="font-family:var(--font-display);">{initials}</span>
                )}
              </div>

              {/* Nombre */}
              <div class="flex-1 min-w-0">
                <div class="text-[#111] text-sm font-bold group-hover:text-[#E53935] transition-colors duration-200 truncate"
                     style="font-family:var(--font-display);">{f.name}</div>
                {f.nick?.trim() && (
                  <div class="text-gray-400 text-xs italic truncate" style="font-family:var(--font-sans);">"{f.nick.trim()}"</div>
                )}
              </div>

              {/* País */}
              <div class="text-gray-400 text-xs hidden sm:block w-28 text-right truncate"
                   style="font-family:var(--font-sans);">{f.from || ''}</div>

              {/* Récord */}
              <div class="text-[#111] font-black text-sm w-16 text-right"
                   style="font-family:var(--font-display);">{f.rec}</div>

              {/* Forma */}
              <div class="hidden md:flex gap-1 flex-shrink-0">
                {(f.formTypes ?? []).slice(0, 5).map((ft: {outcome: string; winType: string}) => {
                  const isLoss = ft.outcome === 'L';
                  const isDraw = ft.outcome === 'D';
                  const bg = isLoss ? '#fff' : isDraw ? '#9ca3af' : (WIN_BG[ft.winType] ?? '#111');
                  const color = isLoss ? '#E53935' : '#fff';
                  const border = isLoss ? '1px solid #E53935' : `1px solid ${bg}`;
                  return (
                    <div class="w-5 h-5 rounded-full flex items-center justify-center text-[8px] font-black"
                         style={`background:${bg}; color:${color}; border:${border};`}>
                      {ft.outcome}
                    </div>
                  );
                })}
              </div>

              <div class="text-gray-300 group-hover:text-[#E53935] text-xs font-bold transition-colors">→</div>
            </a>
          );
        })}
      </div>
    ))}
  </div>

</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.div-tab');
  const sections = document.querySelectorAll<HTMLElement>('.div-section');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.div;

      tabs.forEach(t => {
        t.classList.remove('text-[#111]', 'border-[#111]');
        t.classList.add('text-gray-400', 'border-transparent');
      });
      tab.classList.add('text-[#111]', 'border-[#111]');
      tab.classList.remove('text-gray-400', 'border-transparent');

      sections.forEach(s => {
        s.style.display = s.dataset.div === target ? '' : 'none';
      });
    });
  });
</script>
