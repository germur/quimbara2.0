---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import TacticalSlider from '../../components/TacticalSlider.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ShareAndComment from '../../components/ShareAndComment.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import RelatedEntities from '../../components/RelatedEntities.astro';
import KeyTakeaways from '../../components/KeyTakeaways.astro';
import RoundProgress from '../../components/RoundProgress.astro';
import FIGHTERS from '../../data/fighters.json';
import EVENTS from '../../data/events-all.json';
// @ts-ignore — identidad de entidad compartida
import { refOrganizacion, refAutor, autor as autorEntidad, refPeleador, refEvento } from '../../lib/entidades.mjs';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, author, pubDate, image, category, tags,
        fighters = [], relatedEvents = [], takeaways = [] } = post.data;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href;

const dtf = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const publishDateStr = dtf.format(pubDate);

const categoryColors: Record<string, string> = {
  'Laboratorio Técnico': '#F2D928',
  'Guía del Insider': '#F2D928',
  'Punto de Vista': '#7B1FA2',
};
const categorySlug: Record<string, string> = {
  'Laboratorio Técnico': 'laboratorio-tecnico',
  'Guía del Insider': 'guia-del-insider',
  'Punto de Vista': 'punto-de-vista',
};

const catColor = categoryColors[category] || '#F2D928';
const catSlug = categorySlug[category] ?? category;
const heroGradient = `linear-gradient(to top, rgba(0,0,0,.82) 0%, ${catColor}55 100%)`;

// ─── El grafo del frontmatter, publicado ────────────────────────────────────
// `fighters` y `relatedEvents` son aristas declaradas a mano con slugs
// canónicos: "este artículo trata sobre estas entidades". Hasta ahora se
// quedaban en el frontmatter y no llegaban al HTML, así que ningún motor podía
// saber de quién habla el texto salvo adivinándolo por el título.
//
// Convención schema.org: `about` = de lo que trata de verdad (protagonistas),
// `mentions` = lo que se nombra de pasada. Los primeros dos peleadores del
// array son los protagonistas; el resto, menciones.
const nombrePorSlug = new Map((FIGHTERS as any[]).map(f => [f.slug, f.name]));
// El registro completo, no solo el nombre: refEvento() necesita date y loc
// para emitir un SportsEvent válido (Google los exige en cualquier nodo Event
// de la página, no solo en la ficha del evento).
const eventoPorSlug = new Map((EVENTS as any[]).map(e => [e.slug, e]));

const protagonistas = fighters.slice(0, 2);
const secundarios   = fighters.slice(2);

// refEvento devuelve null si el slug no está en events-all.json: sin fecha no
// hay Event válido, y ese slug apunta además a una URL que no existe.
const about = [
  ...protagonistas.map((s: string) => refPeleador(s, nombrePorSlug.get(s))),
  ...relatedEvents.map((s: string) => refEvento(s, eventoPorSlug.get(s))).filter(Boolean),
];
const mentions = secundarios.map((s: string) => refPeleador(s, nombrePorSlug.get(s)));

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${canonicalUrl}#articulo`,
  "headline": title,
  "description": description,
  "abstract": takeaways.length > 0 ? takeaways.join(' ') : description,
  "author": refAutor(),
  "publisher": refOrganizacion(),
  "datePublished": pubDate.toISOString(),
  "dateModified": pubDate.toISOString(),
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
  "image": image ? new URL(image, Astro.url.origin).href : undefined,
  "inLanguage": "es",
  "articleSection": category,
  ...(about.length > 0 ? { about } : {}),
  ...(mentions.length > 0 ? { mentions } : {}),
  ...(takeaways.length > 0 ? { "keywords": tags.join(', ') } : {})
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio",   "item": new URL("/", Astro.url.origin).href },
    { "@type": "ListItem", "position": 2, "name": category,   "item": new URL(`/categoria/${catSlug}/`, Astro.url.origin).href },
    { "@type": "ListItem", "position": 3, "name": title,      "item": canonicalUrl }
  ]
};

// El autor se declara entero una vez por página para que la entidad exista,
// no solo se referencie por @id.
const autorSchema = { "@context": "https://schema.org", ...autorEntidad };

const combinedSchema = `[${JSON.stringify(articleSchema)}, ${JSON.stringify(breadcrumbSchema)}, ${JSON.stringify(autorSchema)}]`;

const PX = "clamp(16px,4vw,60px)";
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogType="article"
  ogImage={image}
  publishDate={pubDate}
  schema={combinedSchema}
>
  <!-- Round counter — scroll progress estilo fight card MMA -->
  <RoundProgress slot="progress-bar" rounds={3} />

  <!-- Hero: imagen full-width con gradiente de color de categoría -->
  <div class="relative w-full overflow-hidden" style="aspect-ratio: 16/9; max-height: 80vh; min-height: 280px;">
    {image ? (
      <img src={image} alt={`Portada de ${title}`}
           class="w-full h-full object-cover" loading="eager" />
    ) : (
      <div class="absolute inset-0 bg-gray-800"></div>
    )}
    <div class="absolute inset-0" style={`background: ${heroGradient};`}></div>

    <!-- Breadcrumb flotando en la parte superior -->
    <div class="absolute top-4 left-0 right-0" style={`padding: 0 ${PX};`}>
      <Breadcrumb
        variant="dark"
        items={[
          { name: 'Inicio', href: '/' },
          { name: category, href: `/categoria/${catSlug}/` },
          { name: title }
        ]}
      />
    </div>

    <!-- Título y meta al pie del hero -->
    <div class="absolute bottom-0 left-0 right-0" style={`padding: 32px ${PX};`}>
      <span class="inline-block px-3 py-1 text-[11px] font-bold uppercase tracking-widest rounded-sm mb-4 w-fit"
            style={`background:${catColor}; color:${catColor === '#F2D928' ? '#111' : '#fff'}; font-family:var(--font-sans);`}>
        {category}
      </span>
      <h1 class="text-white leading-[1.05]"
          style="font-family:var(--font-display); font-size:clamp(1.8rem,5vw,3.5rem); max-width:22ch;">
        {title}
      </h1>
      <div class="flex flex-wrap items-center gap-3 mt-4 text-white/60 text-xs uppercase tracking-widest"
           style="font-family:var(--font-sans);">
        <time datetime={pubDate.toISOString()}>{publishDateStr}</time>
        <span class="text-white/30">·</span>
        <span class="text-white/90 font-bold">{author}</span>
      </div>
    </div>
  </div>

  <!-- Layout con TOC lateral en desktop -->
  <div style={`max-width:1200px; margin:0 auto; padding: 44px ${PX} 80px;`}>
    <div class="lg:grid lg:gap-16" style="grid-template-columns: 1fr 220px;">

      <!-- Columna principal -->
      <div>
        <!-- Tags -->
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-10 pb-10 border-b border-gray-200">
            {tags.map((tag: string) => <Tag name={tag} />)}
          </div>
        )}

        <!-- KeyTakeaways (si el frontmatter los define) -->
        {takeaways.length > 0 && (
          <KeyTakeaways points={takeaways} />
        )}

        <!-- Prose: texto oscuro sobre fondo blanco (sin prose-invert) -->
        <article class="prose prose-lg max-w-none
          prose-headings:text-[#111] prose-headings:tracking-tight
          prose-a:text-[#F2D928] hover:prose-a:text-[#c62828] prose-a:no-underline
          prose-strong:text-[#111]
          prose-img:rounded-md prose-img:w-full
          prose-code:text-[#F2D928] prose-code:bg-gray-100 prose-code:px-1 prose-code:rounded
          prose-blockquote:border-[#F2D928] prose-blockquote:not-italic">
          <Content components={{ TacticalSlider, KeyTakeaways }} />
        </article>

        <!-- Entidades relacionadas (peleadores + eventos del frontmatter) -->
        {(fighters.length > 0 || relatedEvents.length > 0) && (
          <RelatedEntities fighters={fighters} events={relatedEvents} />
        )}

        <!-- Compartir + comentarios -->
        <ShareAndComment title={title} url={canonicalUrl} description={description} />

        <!-- Autor -->
        <div class="mt-16 pt-10 border-t-2 border-[#111]">
          <div class="flex flex-col md:flex-row gap-5 items-start">
            <div class="rounded-full overflow-hidden flex-shrink-0 bg-gray-200 flex items-center justify-center text-base font-black text-gray-500"
                 style="width:52px;height:52px;font-family:var(--font-sans);">
              {author.split(' ').map((n: string) => n[0]).join('')}
            </div>
            <div>
              <div class="text-xs text-gray-400 uppercase tracking-widest font-bold mb-1"
                   style="font-family:var(--font-sans);">Escrito por</div>
              <h3 class="text-xl text-[#111] mb-2" style="font-family:var(--font-display);">{author}</h3>
              <p class="text-gray-600 text-sm leading-relaxed max-w-md" style="font-family:var(--font-sans);">
                Especialista en SEO, practicante de Jiu-Jitsu Brasileño y analista técnico de MMA.
              </p>
            </div>
          </div>
          <!-- Volver al inicio -->
          <div class="mt-8">
            <a href="/" class="btn-primary">← Volver al inicio</a>
          </div>
        </div>
      </div>

      <!-- TOC lateral — sticky, solo desktop -->
      <aside class="hidden lg:block">
        <TableOfContents />
      </aside>

    </div>
  </div>
</BaseLayout>

