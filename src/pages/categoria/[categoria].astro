---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const uniqueCategories = [...new Set(allPosts.map(p => p.data.category))];

  return uniqueCategories.map(category => {
    const slug = category
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/\s+/g, '-')
      .replace(/[^\w-]+/g, '');
    return {
      params: { categoria: slug },
      props: { posts: allPosts.filter(p => p.data.category === category), currentCategory: category },
    };
  });
}

const { posts, currentCategory } = Astro.props;
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryColors: Record<string, string> = {
  'Laboratorio Técnico': '#F2D928',
  'Guía del Insider':   '#FF6D00',
  'Punto de Vista':     '#7B1FA2',
};
const catColor = categoryColors[currentCategory] ?? '#F2D928';

const PX = 'clamp(16px,4vw,60px)';
---

<BaseLayout
  title={`${currentCategory} — Quimbara`}
  description={`Todos los artículos de ${currentCategory} en Quimbara. Análisis técnico, guías y opinión sobre MMA y UFC.`}
>
  <!-- Header oscuro con color de categoría -->
  <div class="bg-[#111]" style={`padding: 50px ${PX} 36px;`}>
    <div style="max-width:1400px; margin:0 auto;">
      <a href="/blog"
         class="inline-flex items-center gap-1 text-white/40 text-xs uppercase tracking-widest mb-6 hover:text-white/70 transition-colors duration-200"
         style="font-family:var(--font-sans);">
        ← Todos los artículos
      </a>
      <!-- Badge de categoría -->
      <div class="mb-4">
        <span class="inline-block px-3 py-1 text-[11px] font-bold uppercase tracking-widest rounded-sm"
              style={`background:${catColor}; color:#fff; font-family:var(--font-sans);`}>
          {currentCategory}
        </span>
      </div>
      <h1 class="text-white" style="font-family:var(--font-display);font-size:clamp(2.5rem,8vw,4.5rem);">
        {currentCategory}
      </h1>
      <p class="text-white/50 mt-3 text-sm" style="font-family:var(--font-sans);">
        {posts.length} {posts.length === 1 ? 'artículo' : 'artículos'}
      </p>
    </div>
  </div>

  <!-- Grid de artículos -->
  <div style={`max-width:1400px; margin:0 auto; padding: 36px ${PX} 80px;`}>
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {posts.map(post => <ArticleCard article={post} variant="default" />)}
      </div>
    ) : (
      <div class="text-center py-20">
        <p class="text-gray-400 text-lg" style="font-family:var(--font-sans);">
          Aún no hay artículos en esta categoría.
        </p>
      </div>
    )}
  </div>
</BaseLayout>
