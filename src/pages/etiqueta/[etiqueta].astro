---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const uniqueTags = [...new Set(allPosts.flatMap(p => p.data.tags ?? []))];

  return uniqueTags.map(tag => ({
    params: { etiqueta: tag },
    props: { posts: allPosts.filter(p => p.data.tags?.includes(tag)), tag },
  }));
}

const { posts, tag } = Astro.props;
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Etiquetas con menos de 3 posts → noIndex (evita thin content en GSC)
const isThin = posts.length < 3;

const PX = 'clamp(16px,4vw,60px)';
---

<BaseLayout
  title={`#${tag} — Quimbara`}
  description={`Artículos etiquetados con #${tag} en Quimbara.`}
  noIndex={isThin}
>
  <!-- Header -->
  <div class="bg-[#111]" style={`padding: 50px ${PX} 36px;`}>
    <div style="max-width:1400px; margin:0 auto;">
      <a href="/blog"
         class="inline-flex items-center gap-1 text-white/40 text-xs uppercase tracking-widest mb-6 hover:text-white/70 transition-colors duration-200"
         style="font-family:var(--font-sans);">
        ← Todos los artículos
      </a>
      <div class="mb-4">
        <span class="inline-block px-3 py-1 text-[11px] font-bold uppercase tracking-widest rounded-sm bg-[#F2D928] text-[#0A0A0B]"
              style="font-family:var(--font-sans);">
          Etiqueta
        </span>
      </div>
      <h1 class="text-white" style="font-family:var(--font-display);font-size:clamp(2.5rem,8vw,4.5rem);">
        #{tag}
      </h1>
      <p class="text-white/50 mt-3 text-sm" style="font-family:var(--font-sans);">
        {posts.length} {posts.length === 1 ? 'artículo' : 'artículos'}
      </p>
    </div>
  </div>

  <!-- Grid -->
  <div style={`max-width:1400px; margin:0 auto; padding: 36px ${PX} 80px;`}>
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {posts.map(post => <ArticleCard article={post} variant="default" />)}
      </div>
    ) : (
      <div class="text-center py-20">
        <p class="text-gray-400 text-lg" style="font-family:var(--font-sans);">
          No hay artículos con esta etiqueta todavía.
        </p>
      </div>
    )}
  </div>
</BaseLayout>
